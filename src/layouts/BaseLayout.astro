---
import '@fontsource-variable/dm-sans';
import '@fontsource-variable/figtree';
import '@fontsource-variable/urbanist';
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import GradientBackground from '@/components/GradientBackground.astro';
import { getTestimonials } from '@/lib/content';

interface Props {
  /** Transparent header over a full-bleed hero (homepage) */
  headerOverlay?: boolean;
  /** Show the centre logo in the header (homepage hides it — the hero carries the large logo) */
  headerLogo?: boolean;
  /** Fixed header whose logo docks from the full-screen hero into the navbar on scroll (homepage) */
  headerDock?: boolean;
  /** Meta title. Used as is when it already names the brand ("…Azure…"); otherwise " | Azure Contracting" is added */
  title: string;
  description: string;
  /** Absolute or root-relative path to this page's OG image (also the WebPage's primaryImageOfPage in JSON-LD) */
  ogImage?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  /**
   * Extra JSON-LD nodes for this page, merged into the site-wide @graph (WebSite + GeneralContractor + WebPage).
   * A node typed AboutPage / ContactPage / CollectionPage / WebPage refines this page's WebPage node instead of
   * adding a second one; a BreadcrumbList is linked from the WebPage.
   */
  schema?: Record<string, unknown>[];
}

const { headerOverlay = false, headerLogo = true, headerDock = false, title, description, ogImage = '/og-default.jpg', ogType = 'website', noindex = false, schema = [] } =
  Astro.props;

const siteName = 'Azure Contracting';
const fullTitle = /azure/i.test(title) ? title : `${title} | ${siteName}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(ogImage, Astro.site);

const gtmId = import.meta.env.PUBLIC_GTM_ID;
const clarityId = import.meta.env.PUBLIC_CLARITY_ID;

// ---- JSON-LD: one @graph per page ----
const siteUrl = new URL('/', Astro.site).toString();
const orgId = `${siteUrl}#organization`;
const websiteId = `${siteUrl}#website`;
const pageId = `${canonical}#webpage`;
const siteDescription =
  'Construction, refurbishment and fit-out for offices, hospitality, retail and education. Based in Kildare, working across Ireland.';

// Rating from the testimonials shown on the Testimonials page (count stays in step with the site)
const reviews = await getTestimonials({ page: true });
const ratingAvg = reviews.length ? reviews.reduce((sum, r) => sum + r.data.rating, 0) / reviews.length : 0;

const website = {
  '@type': 'WebSite',
  '@id': websiteId,
  url: siteUrl,
  name: siteName,
  description: siteDescription,
  publisher: { '@id': orgId },
  inLanguage: 'en-IE',
};

const organization = {
  '@type': 'GeneralContractor',
  '@id': orgId,
  name: siteName,
  url: siteUrl,
  // The real logo (rendered from the site logo), not the 1200×630 share image — Google wants the logo itself here
  logo: { '@type': 'ImageObject', url: new URL('/logo.png', Astro.site).toString(), width: 1794, height: 410 },
  image: new URL('/og-default.jpg', Astro.site).toString(),
  description: siteDescription,
  // TODO: client to confirm the street address (and add telephone / email once confirmed)
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Osprey Business Centre',
    addressLocality: 'Naas',
    addressRegion: 'County Kildare',
    addressCountry: 'IE',
  },
  areaServed: { '@type': 'Country', name: 'Ireland' },
  ...(reviews.length && {
    aggregateRating: {
      '@type': 'AggregateRating',
      ratingValue: String(Math.round(ratingAvg * 10) / 10),
      bestRating: '5',
      worstRating: '1',
      reviewCount: String(reviews.length),
    },
  }),
};

// Page nodes: strip @context (the graph has one), fold page-type nodes into the WebPage, link the breadcrumb
const pageTypes = ['WebPage', 'AboutPage', 'ContactPage', 'CollectionPage'];
const nodes = schema.map(({ '@context': _ctx, ...node }) => node);
const pageOverride = nodes.find((n) => pageTypes.includes(String(n['@type'])));
const breadcrumb = nodes.find((n) => n['@type'] === 'BreadcrumbList');
if (breadcrumb) breadcrumb['@id'] = `${canonical}#breadcrumb`;

const webPage = {
  '@type': 'WebPage',
  ...pageOverride,
  '@id': pageId,
  url: canonical.toString(),
  name: fullTitle,
  description,
  isPartOf: { '@id': websiteId },
  about: { '@id': orgId },
  primaryImageOfPage: { '@type': 'ImageObject', url: ogImageUrl.toString() },
  ...(breadcrumb && { breadcrumb: { '@id': breadcrumb['@id'] } }),
  inLanguage: 'en-IE',
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [website, organization, webPage, ...nodes.filter((n) => n !== pageOverride)],
};
---

<!doctype html>
<html lang="en-IE">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Before first paint: `js` = scripts run; `motion` = scroll animations allowed (not prefers-reduced-motion) -->
    <script is:inline>
      document.documentElement.classList.add('js');
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('motion');
    </script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#0E1F3D" />

    <meta property="og:site_name" content={siteName} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content="en_IE" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <slot name="head" />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    {
      gtmId && (
        <script is:inline define:vars={{ gtmId }}>
          (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});
          var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';
          j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
          })(window,document,'script','dataLayer',gtmId);
        </script>
      )
    }
    {
      clarityId && (
        <script is:inline define:vars={{ clarityId }}>
          (function(c,l,a,r,i,t,y){c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
          t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
          y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
          })(window,document,"clarity","script",clarityId);
        </script>
      )
    }
  </head>
  <body class="relative min-h-dvh overflow-x-hidden">
    {
      gtmId && (
        <noscript>
          <iframe
            src={`https://www.googletagmanager.com/ns.html?id=${gtmId}`}
            height="0"
            width="0"
            style="display:none;visibility:hidden"
          />
        </noscript>
      )
    }
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:rounded-lg focus:bg-navy focus:px-4 focus:py-2 focus:text-white"
      >Skip to content</a
    >

    <!-- Animated lavender / lime gradient behind the whole page (static image without WebGL) -->
    <GradientBackground />

    <Header overlay={headerOverlay} showLogo={headerLogo} dock={headerDock} />

    <main id="main">
      <slot />
    </main>

    <Footer />

    <script>
      import '@/scripts/text-animate';
    </script>
    <script>
      // Click tracking â†’ dataLayer (GTM). Elements opt in with data-track="event_name";
      // phone and email links are tracked automatically.
      type DL = { dataLayer?: Record<string, unknown>[] };
      const w = window as unknown as DL;
      document.addEventListener('click', (e) => {
        const el = (e.target as HTMLElement | null)?.closest<HTMLElement>('a, button');
        if (!el) return;
        const dataLayer = (w.dataLayer ??= []);
        const href = el.getAttribute('href') ?? '';
        const label = el.textContent?.trim() || el.getAttribute('aria-label') || '';
        if (el.dataset.track) {
          dataLayer.push({ event: el.dataset.track, cta_label: label, cta_location: el.dataset.ctaLocation, link_url: href });
        }
        if (href.startsWith('tel:')) dataLayer.push({ event: 'phone_click', link_url: href });
        if (href.startsWith('mailto:')) dataLayer.push({ event: 'email_click', link_url: href });
      });
    </script>
  </body>
</html>
