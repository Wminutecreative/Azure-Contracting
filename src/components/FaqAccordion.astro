---
import BigOutlineHeading from './BigOutlineHeading.astro';

export interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  items: FaqItem[];
  heading?: string;
  /** Output FAQPage JSON-LD for these items */
  schema?: boolean;
  class?: string;
}

// Pages pass items from the `faqs` collection via getFaqs(page) in src/lib/content.ts.
//
// Scroll animation (desktop/tablet, motion allowed): the stage pins at the top of the viewport showing only
// the big "Asked Questions" title (design default state). Scrolling then scrubs the first word(s) to the
// left and the rest to the right while the FAQ cards rise and fade into the gap. After that the section
// un-pins and scrolls normally; the cards never move once shown, so they stay easy to read and click.
// Phones / reduced motion / no JS: plain stacked layout (title above the cards).
const { items, heading = 'Asked Questions', schema = true, class: className } = Astro.props;

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};
---

{
  items.length > 0 && (
    <section class:list={['faq-section section-y', className]} data-faq>
      <div class="faq-stage" data-faq-stage>
        <BigOutlineHeading text={heading} split class="faq-heading" />
        <div class="faq-list container-site" data-faq-list>
          <div class="mx-auto max-w-[65rem] space-y-3.5">
            {items.map((item, i) => (
              <details class="faq overflow-hidden rounded-[1.375rem] bg-white" name="faq" open={i === 0} data-accordion>
                <summary class="text-navy flex cursor-pointer list-none items-center justify-between gap-6 px-6 py-6 text-[clamp(1.125rem,1.6vw,1.375rem)] md:px-8 md:py-[1.625rem]">
                  <span>{item.question}</span>
                  <span class="faq-icon grid size-9 shrink-0 place-items-center rounded-[0.625rem]" aria-hidden="true">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                      <path d="M4 12h16" />
                      <path class="faq-icon-v" d="M12 4v16" />
                    </svg>
                  </span>
                </summary>
                <div class="overflow-hidden" data-accordion-body>
                  <p class="text-stat-label max-w-[51.25rem] px-6 pb-7 text-base leading-[1.65] text-pretty md:px-8 md:pb-[1.875rem]">{item.answer}</p>
                </div>
              </details>
            ))}
          </div>
        </div>
      </div>
      {schema && <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
    </section>
  )
}

<style>
  /* Static layout: title, then the cards */
  .faq-stage {
    display: grid;
    gap: clamp(2rem, 1rem + 4vw, 5.6rem);
  }
  /* Scroll layout (class added by the script): title and cards share one cell, centred in a full-height stage */
  .faq-section.is-scrub {
    padding-block: 0;
  }
  .faq-section.is-scrub .faq-stage {
    min-height: 100svh;
    grid-template: 1fr / 1fr;
    align-items: center;
    overflow: hidden;
    padding-top: var(--hdr-h, 0px); /* keep the centre clear of the fixed header */
  }
  .faq-section.is-scrub .faq-stage > :global(*) {
    grid-area: 1 / 1;
  }
  .faq-section.is-scrub .faq-list {
    position: relative;
    z-index: 1;
  }
  .faq summary::-webkit-details-marker {
    display: none;
  }
  /* Closed: pale chip with "+"; open: navy chip with "−" */
  .faq-icon {
    background: #eef1f6;
    color: var(--color-navy);
    transition:
      background-color 0.3s ease,
      color 0.3s ease;
  }
  .faq[open] .faq-icon {
    background: var(--color-navy);
    color: var(--color-white);
  }
  .faq-icon-v {
    transform-origin: center;
    transition: transform 0.3s ease;
  }
  .faq[open] .faq-icon-v {
    transform: scaleY(0);
  }
</style>

<script>
  import '@/scripts/accordion';
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  document.querySelectorAll<HTMLElement>('[data-faq]').forEach((section) => {
    const stage = section.querySelector<HTMLElement>('[data-faq-stage]');
    const list = section.querySelector<HTMLElement>('[data-faq-list]');
    const words = Array.from(section.querySelectorAll<HTMLElement>('[data-word]'));
    if (!stage || !list || words.length < 2) return;

    // First half of the words go left, the rest go right ("Asked" | "Questions")
    const half = Math.ceil(words.length / 2);
    const left = words.slice(0, half);
    const right = words.slice(half);

    const mm = gsap.matchMedia();
    // Needs room for the pinned stage: tablet width and up, and a viewport tall enough for the cards
    mm.add('(min-width: 48rem) and (min-height: 42.5rem) and (prefers-reduced-motion: no-preference)', () => {
      section.classList.add('is-scrub');
      // Start with every question closed so the list fits inside the pinned viewport (one open still fits)
      const firstOpen = section.querySelector<HTMLDetailsElement>('details[open]');
      firstOpen?.removeAttribute('open');
      ScrollTrigger.refresh();

      // How far each word travels: towards the stage edges, leaving the centre to the cards
      const shift = () => Math.min(window.innerWidth * 0.3, 520);

      const tl = gsap.timeline({
        defaults: { ease: 'none' },
        scrollTrigger: {
          trigger: stage,
          start: 'top top',
          end: '+=85%',
          pin: true,
          scrub: 0.8,
          invalidateOnRefresh: true,
        },
      });
      tl.to(left, { x: () => -shift(), opacity: 0.75 }, 0)
        .to(right, { x: () => shift(), opacity: 0.75 }, 0)
        .fromTo(list, { autoAlpha: 0, y: 140 }, { autoAlpha: 1, y: 0, ease: 'power2.out', duration: 0.7 }, 0.2);

      return () => {
        section.classList.remove('is-scrub');
        firstOpen?.setAttribute('open', '');
      };
    });
  });
</script>
