---
import BigOutlineHeading from './BigOutlineHeading.astro';

export interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  items: FaqItem[];
  heading?: string;
  /** Output FAQPage JSON-LD for these items */
  schema?: boolean;
  class?: string;
}

// Phase 3: pages pass items from the `faqs` content collection.
const { items, heading = 'Asked Questions', schema = true, class: className } = Astro.props;

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};
---

<section class:list={['section-y', className]}>
  <div class="container-site">
    <BigOutlineHeading text={heading}>
      <div class="faq-list mx-auto max-w-4xl space-y-4">
        {
          items.map((item, i) => (
            <details class="faq rounded-card shadow-card bg-white" name="faq" open={i === 0}>
              <summary class="text-h5 text-navy flex cursor-pointer list-none items-center justify-between gap-6 p-6 md:px-8">
                <span>{item.question}</span>
                <span class="faq-icon bg-navy text-neon grid size-10 shrink-0 place-items-center rounded-full" aria-hidden="true">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                    <path d="M5 12h14" />
                    <path class="faq-icon-v" d="M12 5v14" />
                  </svg>
                </span>
              </summary>
              <div class="faq-body">
                <p class="text-p1 text-text-medium px-6 pb-6 md:px-8 md:pb-8">{item.answer}</p>
              </div>
            </details>
          ))
        }
      </div>
    </BigOutlineHeading>
  </div>
  {schema && items.length > 0 && <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
</section>

<style>
  .faq summary::-webkit-details-marker {
    display: none;
  }
  .faq-icon-v {
    transform-origin: center;
    transition: transform 0.3s ease;
  }
  .faq[open] .faq-icon-v {
    transform: rotate(90deg);
  }
  .faq-body {
    overflow: hidden;
  }
</style>

<script>
  // Progressive enhancement: smooth height animation. Without JS, <details> still works.
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  function animate(details: HTMLDetailsElement, opening: boolean) {
    const body = details.querySelector<HTMLElement>('.faq-body');
    if (!body || reduceMotion.matches) {
      details.open = opening;
      return;
    }
    if (opening) details.open = true;
    const full = body.scrollHeight;
    const anim = body.animate(
      { height: opening ? ['0px', `${full}px`] : [`${full}px`, '0px'], opacity: opening ? [0, 1] : [1, 0] },
      { duration: 350, easing: 'cubic-bezier(0.22, 1, 0.36, 1)' },
    );
    anim.onfinish = () => {
      if (!opening) details.open = false;
    };
  }

  document.querySelectorAll<HTMLDetailsElement>('details.faq').forEach((details) => {
    details.querySelector('summary')?.addEventListener('click', (e) => {
      e.preventDefault();
      const opening = !details.open;
      // Exclusive accordion: close the other open item in the same group
      if (opening && details.name) {
        document
          .querySelectorAll<HTMLDetailsElement>(`details.faq[name="${details.name}"][open]`)
          .forEach((other) => other !== details && animate(other, false));
      }
      animate(details, opening);
    });
  });
</script>
