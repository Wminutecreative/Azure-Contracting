---
import BigOutlineHeading from './BigOutlineHeading.astro';

export interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  items: FaqItem[];
  heading?: string;
  /** Output FAQPage JSON-LD for these items */
  schema?: boolean;
  class?: string;
}

// Pages pass items from the `faqs` collection via getFaqs(page) in src/lib/content.ts.
const { items, heading = 'Asked Questions', schema = true, class: className } = Astro.props;

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};
---

{
  items.length > 0 && (
    <section class:list={['section-y', className]}>
      <BigOutlineHeading text={heading}>
        <div class="container-site">
          <div class="mx-auto max-w-[65rem] space-y-3.5">
            {items.map((item, i) => (
              <details class="faq overflow-hidden rounded-[1.375rem] bg-white" name="faq" open={i === 0} data-accordion>
                <summary class="text-navy flex cursor-pointer list-none items-center justify-between gap-6 px-6 py-6 text-[clamp(1.125rem,1.6vw,1.375rem)] md:px-8 md:py-[1.625rem]">
                  <span>{item.question}</span>
                  <span class="faq-icon grid size-9 shrink-0 place-items-center rounded-[0.625rem]" aria-hidden="true">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                      <path d="M4 12h16" />
                      <path class="faq-icon-v" d="M12 4v16" />
                    </svg>
                  </span>
                </summary>
                <div class="overflow-hidden" data-accordion-body>
                  <p class="text-stat-label max-w-[51.25rem] px-6 pb-7 text-base leading-[1.65] text-pretty md:px-8 md:pb-[1.875rem]">{item.answer}</p>
                </div>
              </details>
            ))}
          </div>
        </div>
      </BigOutlineHeading>
      {schema && <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
    </section>
  )
}

<style>
  .faq summary::-webkit-details-marker {
    display: none;
  }
  /* Closed: pale chip with "+"; open: navy chip with "−" */
  .faq-icon {
    background: #eef1f6;
    color: var(--color-navy);
    transition:
      background-color 0.3s ease,
      color 0.3s ease;
  }
  .faq[open] .faq-icon {
    background: var(--color-navy);
    color: var(--color-white);
  }
  .faq-icon-v {
    transform-origin: center;
    transition: transform 0.3s ease;
  }
  .faq[open] .faq-icon-v {
    transform: scaleY(0);
  }
</style>

<script>
  import '@/scripts/accordion';
</script>
