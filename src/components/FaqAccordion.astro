---
import BigOutlineHeading from './BigOutlineHeading.astro';

export interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  items: FaqItem[];
  heading?: string;
  /** Output FAQPage JSON-LD for these items */
  schema?: boolean;
  class?: string;
}

// Pages pass items from the `faqs` collection via getFaqs(page) in src/lib/content.ts.
const { items, heading = 'Asked Questions', schema = true, class: className } = Astro.props;

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};
---

{
  items.length > 0 && (
    <section class:list={['section-y', className]}>
      <BigOutlineHeading text={heading}>
        <div class="container-site">
          <div class="mx-auto max-w-4xl space-y-4">
            {items.map((item, i) => (
              <details class="faq card-surface rounded-card" name="faq" open={i === 0} data-accordion>
                <summary class="text-h5 text-navy flex cursor-pointer list-none items-center justify-between gap-6 p-6 md:px-8">
                  <span>{item.question}</span>
                  <span class="bg-navy text-neon grid size-10 shrink-0 place-items-center rounded-full" aria-hidden="true">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                      <path d="M5 12h14" />
                      <path class="faq-icon-v" d="M12 5v14" />
                    </svg>
                  </span>
                </summary>
                <div class="overflow-hidden" data-accordion-body>
                  <p class="text-p1 text-text-medium px-6 pb-6 md:px-8 md:pb-8">{item.answer}</p>
                </div>
              </details>
            ))}
          </div>
        </div>
      </BigOutlineHeading>
      {schema && <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
    </section>
  )
}

<style>
  .faq summary::-webkit-details-marker {
    display: none;
  }
  .faq-icon-v {
    transform-origin: center;
    transition: transform 0.3s ease;
  }
  .faq[open] .faq-icon-v {
    transform: rotate(90deg);
  }
</style>

<script>
  import '@/scripts/accordion';
</script>
