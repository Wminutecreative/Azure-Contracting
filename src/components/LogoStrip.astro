---
import { clients } from '@/data/site';

interface Props {
  heading?: string;
  class?: string;
}
// TODO: heading copy + logo SVGs from Figma; names render as text placeholders until then.
const { heading = 'Trusted by leading brands', class: className } = Astro.props;
---

<section class:list={['section-y', className]} aria-labelledby="logo-strip-heading">
  <div class="container-site">
    <h2 id="logo-strip-heading" class="text-p3 text-text-medium mb-8 text-center tracking-widest uppercase">
      {heading}
    </h2>
    <ul class="border-light grid grid-cols-2 border-t border-l sm:grid-cols-3 lg:grid-cols-6">
      {
        clients.map((name) => (
          <li class="border-light grid min-h-24 place-items-center border-r border-b px-4 md:min-h-28">
            <span class="font-heading text-text-medium text-center text-lg font-medium tracking-wide opacity-70 grayscale transition-opacity hover:opacity-100">
              {name}
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</section>
