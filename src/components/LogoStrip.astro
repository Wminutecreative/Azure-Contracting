---
import { Image } from 'astro:assets';
import { clients } from '@/data/site';

interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<section class:list={['py-12 md:py-[4.5rem]', className]} aria-labelledby="clients-heading">
  <h2 id="clients-heading" class="sr-only">Clients we have worked with</h2>
  <ul class="flex flex-wrap items-center justify-center gap-x-10 gap-y-8 px-(--gutter) lg:flex-nowrap lg:justify-between lg:px-9">
    {
      clients.map((c) => (
        <li class="shrink-0">
          <Image
            src={c.logo}
            alt={c.name}
            class="h-9 w-auto opacity-90 transition-opacity hover:opacity-100 md:h-12 lg:h-auto"
          />
        </li>
      ))
    }
  </ul>
</section>
