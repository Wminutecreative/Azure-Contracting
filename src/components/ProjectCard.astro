---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Button from './Button.astro';

// Featured-work row: image panel (16px white frame, 24px inner radius) beside a white text panel (34px radius).
// On desktop the image panel is 20px shorter top and bottom, so when FeaturedWork merges the panels into one
// shape (goo layer) the joins get curved notches, as in the design. `reverse` puts the text panel on the left.
// Inside FeaturedWork the panel backgrounds come from the merged layer; standalone they are plain white cards.
interface Props {
  project: CollectionEntry<'projects'>;
  reverse?: boolean;
  headingLevel?: 'h2' | 'h3';
  eager?: boolean;
}
const { project, reverse = false, headingLevel: Heading = 'h3', eager = false } = Astro.props;
const { title, excerpt, cover, coverAlt } = project.data;
const href = `/projects/${project.id}`;
---

<article class="project-row group grid gap-3 md:grid-cols-2 md:gap-2" data-fw-row>
  <a
    href={href}
    tabindex="-1"
    aria-hidden="true"
    class:list={['fw-panel block rounded-[2.125rem] bg-white p-3 md:my-5 md:p-4', reverse && 'md:order-2']}
    data-goo-panel
  >
    <span class="block overflow-hidden rounded-3xl" data-fw-img>
      <Image
        src={cover}
        alt={coverAlt}
        widths={[480, 640, 960, 1280]}
        sizes="(min-width: 1340px) 620px, (min-width: 768px) 46vw, 100vw"
        loading={eager ? 'eager' : 'lazy'}
        class="aspect-[1.08] h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.03]"
      />
    </span>
  </a>
  <div
    class="fw-panel flex flex-col justify-between gap-10 rounded-[2.125rem] bg-white px-[clamp(1.75rem,4vw,4.5rem)] py-[clamp(2rem,4.5vw,4.5rem)]"
    data-goo-panel
  >
    <div class="flex flex-col gap-[1.125rem]">
      <Heading class="font-body text-navy text-[clamp(1.625rem,2.4vw,2.125rem)] leading-tight font-normal tracking-[-0.01em]" data-fw-text>
        <a href={href} class="hover:text-[#1d3a78]">{title}</a>
      </Heading>
      <p class="text-stat-label max-w-[32.5rem] text-base leading-[1.65] text-pretty" data-fw-text>{excerpt}</p>
    </div>
    <div data-fw-text>
      <Button variant="outline" href={href} aria-label={`Know more about ${title}`}>Know More</Button>
    </div>
  </div>
</article>
