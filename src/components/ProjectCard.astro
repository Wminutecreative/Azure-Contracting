---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Button from './Button.astro';

// Featured-work row from the Claude Design homepage: two equal white panels (34px radius, 22px gap).
// The image sits inside its panel with a 16px frame (24px inner radius); `reverse` puts the text panel on the left.
interface Props {
  project: CollectionEntry<'projects'>;
  reverse?: boolean;
  headingLevel?: 'h2' | 'h3';
  eager?: boolean;
}
const { project, reverse = false, headingLevel: Heading = 'h3', eager = false } = Astro.props;
const { title, excerpt, cover, coverAlt } = project.data;
const href = `/projects/${project.id}`;
---

<article class="project-row group grid gap-[1.375rem] md:grid-cols-2" data-reveal>
  <a
    href={href}
    tabindex="-1"
    aria-hidden="true"
    class:list={['block rounded-[2.125rem] bg-white p-3 md:p-4', reverse && 'md:order-2']}
  >
    <span class="block overflow-hidden rounded-3xl">
      <Image
        src={cover}
        alt={coverAlt}
        widths={[480, 640, 960, 1280]}
        sizes="(min-width: 1340px) 620px, (min-width: 768px) 46vw, 100vw"
        loading={eager ? 'eager' : 'lazy'}
        class="aspect-[1.08] h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.03]"
      />
    </span>
  </a>
  <div
    class="flex flex-col justify-between gap-10 rounded-[2.125rem] bg-white px-[clamp(1.75rem,4vw,4.5rem)] py-[clamp(2rem,4vw,4rem)]"
  >
    <div class="flex flex-col gap-[1.125rem]">
      <Heading class="font-body text-navy text-[clamp(1.625rem,2.4vw,2.125rem)] leading-tight font-normal tracking-[-0.01em]">
        <a href={href} class="hover:text-[#1d3a78]">{title}</a>
      </Heading>
      <p class="text-stat-label max-w-[32.5rem] text-base leading-[1.65] text-pretty">{excerpt}</p>
    </div>
    <div>
      <Button variant="outline" href={href} aria-label={`Know more about ${title}`}>Know More</Button>
    </div>
  </div>
</article>
