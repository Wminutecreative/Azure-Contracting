---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Button from './Button.astro';
import NavArrow from './NavArrow.astro';

// Featured-work row (design, desktop): a white text card a little wider than half the row, with the photo
// sitting on the page background beside it, ~30px clear of the card and flush with the outer edge.
// Inside FeaturedWork the text cards of consecutive rows overlap slightly and are drawn as ONE white
// zig-zag shape (SVG path) with curved pocket corners around each photo. Mobile: photo above a white card.
// `reverse` puts the text card on the left.
interface Props {
  project: CollectionEntry<'projects'>;
  reverse?: boolean;
  headingLevel?: 'h2' | 'h3';
  eager?: boolean;
}
const { project, reverse = false, headingLevel: Heading = 'h3', eager = false } = Astro.props;
const { title, excerpt, cover, coverAlt, gallery } = project.data;
const href = `/projects/${project.id}`;
// Photo slider: cover first, then the gallery (Keystatic → Projects → Gallery). With more than one photo the
// photo can be dragged / swiped sideways, and a "Drag Here" pill follows the pointer while hovering it.
const slides = [{ src: cover, alt: coverAlt }, ...gallery.filter((g) => g.src.src !== cover.src)];
const multi = slides.length > 1;
// The photo box is taller than a landscape photo, so object-cover draws each photo ~1.5× wider than the box —
// `sizes` describes that drawn width (not the box width), or browsers pick a file that's too small and it blurs.
---

<article class="fw-row group relative" data-fw-row>
  <div
    class:list={[
      'fw-img relative block overflow-hidden rounded-[2rem] md:absolute md:top-[2.55rem] md:bottom-[2.55rem] md:w-[calc(50%-2.375rem)] md:rounded-[2.25rem]',
      reverse ? 'md:right-0' : 'md:left-0',
      multi && 'is-slider',
    ]}
    data-fw-img
    data-photo-slider={multi ? '' : undefined}
    data-side={reverse ? 'right' : 'left'}
  >
    <div class="ps-track flex h-full" data-ps-track>
      {
        slides.map((s, i) => (
          <Image
            src={s.src}
            alt={i === 0 ? s.alt : ''}
            widths={[640, 960, 1280, 1600, 1920, 2560]}
            sizes="(min-width: 1340px) 960px, (min-width: 768px) 70vw, 150vw"
            loading={eager && i === 0 ? 'eager' : 'lazy'}
            draggable="false"
            class="aspect-[1.08] h-full w-full shrink-0 object-cover md:aspect-auto"
          />
        ))
      }
    </div>
    <a href={href} tabindex="-1" aria-hidden="true" draggable="false" class="ps-link absolute inset-0" data-ps-link></a>
    {
      multi && (
        <span class="ps-pill" aria-hidden="true" data-ps-pill>
          <span class="ps-pill-inner">
            <span class="ps-pill-arrow ps-pill-prev">
              <NavArrow size={16} direction="left" />
            </span>
            <span class="ps-pill-label">Drag Here</span>
            <span class="ps-pill-arrow ps-pill-next">
              <NavArrow size={16} />
            </span>
          </span>
        </span>
      )
    }
  </div>
  <div
    class:list={[
      'fw-card mt-3 flex flex-col justify-between gap-10 rounded-[2rem] border border-[#e6e9eb] bg-white px-[clamp(1.75rem,4.5vw,4.1rem)] py-[clamp(2rem,6vw,6.25rem)] md:mt-0 md:min-h-[clamp(28rem,44vw,41rem)] md:w-[calc(50%+0.5rem)] md:pb-[clamp(2rem,5.5vw,5.5rem)]',
      !reverse && 'md:ml-auto',
    ]}
    data-shape-rect
  >
    <div class="flex flex-col gap-[1.125rem]">
      <Heading class="font-body text-text-dark text-[clamp(1.5rem,2.2vw,2rem)] leading-tight font-normal tracking-[-0.01em]" data-fw-text>
        <a href={href} class="hover:text-navy">{title}</a>
      </Heading>
      <p class="text-[#454142] text-p1 leading-[1.35] text-pretty" data-fw-text>{excerpt}</p>
    </div>
    <div data-fw-text>            
      <Button variant="outline" href={href} aria-label={`Know more about ${title}`} compact>Know More</Button>
    </div>
  </div>
</article>

<style>
  .ps-track {
    transition: transform 0.9s cubic-bezier(0.65, 0, 0.35, 1);
    will-change: transform;
  }
  .ps-track.is-dragging {
    transition: none;
  }
  .is-slider {
    touch-action: pan-y;
    user-select: none;
  }
  /* "Drag Here" cursor (mouse / trackpad only): the outer span glides after the pointer (positioned by the
     script), the inner one grows from nothing to full size on hover and shrinks away on leave.
     ◀ tile · "Drag Here" label · ▶ tile, three navy pieces side by side */
  .ps-pill {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 2;
    pointer-events: none;
    will-change: transform;
  }
  .ps-pill-inner {
    display: flex;
    align-items: stretch;
    gap: 0.375rem;
    color: var(--color-white);
    font-size: 1rem;
    font-weight: 500;
    line-height: 1;
    white-space: nowrap;
    opacity: 0;
    transform: translate(-50%, -50%) scale(0);
    transition:
      opacity 0.35s ease,
      transform 0.55s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .ps-pill-label,
  .ps-pill-arrow {
    display: grid;
    place-items: center;
    border-radius: 0.875rem;
    background: var(--color-navy);
  }
  .ps-pill-label {
    padding: 0.85rem 1.25rem;
  }
  .ps-pill-arrow {
    width: 2.6rem;
    transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }
  /* While dragging, the arrows spread out a little */
  .is-grabbing .ps-pill-prev {
    transform: translateX(-0.3rem);
  }
  .is-grabbing .ps-pill-next {
    transform: translateX(0.3rem);
  }
  @media (hover: hover) and (pointer: fine) {
    .is-slider,
    .is-slider .ps-link {
      cursor: none;
    }
    .is-slider:hover .ps-pill-inner {
      opacity: 1;
      transform: translate(-50%, -50%) scale(1);
    }
    .is-slider.is-grabbing .ps-pill-inner {
      transform: translate(-50%, -50%) scale(0.9);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ps-track,
    .ps-pill-inner,
    .ps-pill-arrow {
      transition: none;
    }
  }
</style>

<script>
  // Project photo slider. Photos change on their own every few seconds (looping), pausing while the pointer is
  // over the photo, while it has keyboard focus, while it is off-screen or the tab is hidden (and never with
  // reduced motion). They can also be dragged / swiped: the track follows the pointer and snaps to the nearest
  // photo on release (a quick flick also counts); a click without dragging still opens the project.
  // Every slider runs right → left (the next photo comes in from the right). The "Drag Here" pill glides after the
  // pointer. (data-side only drives the scroll-in reveal direction, in FeaturedWork.)
  const AUTOPLAY_MS = 3500;
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLElement>('[data-photo-slider]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('[data-ps-track]')!;
    const pill = root.querySelector<HTMLElement>('[data-ps-pill]');
    const count = track.children.length;
    // The track moves left to show the next photo (it comes in from the right)
    const dir = 1;
    let index = 0;
    let startX = 0;
    let startT = 0;
    let dx = 0;
    let down = false;
    let moved = false;

    const go = (i: number) => {
      index = ((i % count) + count) % count; // loops
      track.style.transform = `translateX(${-index * 100 * dir}%)`;
    };

    // Autoplay
    let timer = 0;
    let hovered = false;
    let visible = false;
    const schedule = () => {
      clearTimeout(timer);
      if (reduceMotion || hovered || down || !visible || document.hidden || root.matches(':focus-within')) return;
      timer = window.setTimeout(() => {
        go(index + 1);
        schedule();
      }, AUTOPLAY_MS);
    };
    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      schedule();
    }).observe(root);
    document.addEventListener('visibilitychange', schedule);
    root.addEventListener('focusin', schedule);
    root.addEventListener('focusout', () => setTimeout(schedule));

    // "Drag Here" pill: eases towards the pointer each frame (lerp) rather than sticking to it
    let tx = 0;
    let ty = 0;
    let px = 0;
    let py = 0;
    let raf = 0;
    const follow = () => {
      px += (tx - px) * 0.2;
      py += (ty - py) * 0.2;
      if (pill) pill.style.transform = `translate(${px}px, ${py}px)`;
      raf = Math.abs(tx - px) + Math.abs(ty - py) > 0.3 ? requestAnimationFrame(follow) : 0;
    };
    const setTarget = (e: PointerEvent, jump = false) => {
      const r = root.getBoundingClientRect();
      tx = e.clientX - r.left;
      ty = e.clientY - r.top;
      if (jump) {
        px = tx;
        py = ty;
      }
      if (!raf) raf = requestAnimationFrame(follow);
    };

    root.addEventListener('pointerenter', (e) => {
      hovered = true;
      schedule();
      setTarget(e, true); // appear where the pointer enters, then grow from 0
    });
    root.addEventListener('pointerleave', () => {
      hovered = false;
      schedule();
    });

    root.addEventListener('pointermove', (e) => {
      setTarget(e);
      if (!down) return;
      dx = e.clientX - startX;
      if (!moved && Math.abs(dx) > 6) {
        // It's a drag (not a click): keep receiving the pointer even if it leaves the photo
        moved = true;
        root.setPointerCapture(e.pointerId);
      }
      track.style.transform = `translateX(calc(${-index * 100 * dir}% + ${dx}px))`;
    });
    root.addEventListener('pointerdown', (e) => {
      if (e.button !== 0) return;
      down = true;
      moved = false;
      dx = 0;
      startX = e.clientX;
      startT = performance.now();
      track.classList.add('is-dragging');
      root.classList.add('is-grabbing');
      clearTimeout(timer);
    });
    const end = () => {
      if (!down) return;
      down = false;
      track.classList.remove('is-dragging');
      root.classList.remove('is-grabbing');
      const w = root.offsetWidth || 1;
      const fast = Math.abs(dx) / Math.max(1, performance.now() - startT) > 0.5; // px per ms
      // Dragging against the direction of travel moves forward (e.g. right → left drag on a right-to-left photo)
      if (Math.abs(dx) > w * 0.2 || (fast && Math.abs(dx) > 20)) go(index + (dx * dir < 0 ? 1 : -1));
      else go(index);
      schedule();
    };
    root.addEventListener('pointerup', end);
    root.addEventListener('pointercancel', end);
    // A drag is not a click (a plain click still opens the project through the link)
    root.addEventListener(
      'click',
      (e) => {
        if (moved) {
          e.preventDefault();
          e.stopPropagation();
        }
      },
      true,
    );
  });
</script>
