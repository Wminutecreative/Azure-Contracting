---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Button from './Button.astro';

// Featured-work row from the design: image (610 × 567, 48px radius) beside a white text card (662 wide, 48px radius).
// `reverse` puts the text card on the left.
interface Props {
  project: CollectionEntry<'projects'>;
  reverse?: boolean;
  headingLevel?: 'h2' | 'h3';
  eager?: boolean;
}
const { project, reverse = false, headingLevel: Heading = 'h3', eager = false } = Astro.props;
const { title, excerpt, cover, coverAlt } = project.data;
const href = `/projects/${project.id}`;
---

<article
  class:list={[
    'project-row group grid gap-4 md:gap-8',
    reverse ? 'md:grid-cols-[662fr_610fr]' : 'md:grid-cols-[610fr_662fr]',
  ]}
  data-reveal
>
  <a href={href} tabindex="-1" aria-hidden="true" class:list={['block overflow-hidden rounded-(--radius-panel)', reverse && 'md:order-2']}>
    <Image
      src={cover}
      alt={coverAlt}
      widths={[480, 610, 960, 1220]}
      sizes="(min-width: 1512px) 610px, (min-width: 768px) 45vw, 100vw"
      loading={eager ? 'eager' : 'lazy'}
      class="aspect-[610/567] h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.03]"
    />
  </a>
  <div
    class="card-surface flex flex-col justify-between gap-10 rounded-(--radius-panel) p-8 md:px-[clamp(2rem,5vw,4.7rem)] md:py-[clamp(2.5rem,7vw,6.5rem)]"
  >
    <div>
      <Heading class="text-h3 text-text-dark"><a href={href} class="hover:text-navy">{title}</a></Heading>
      <p class="text-p1 text-text-medium mt-6 max-w-[32.5rem]">{excerpt}</p>
    </div>
    <div>
      <Button variant="outline" href={href} aria-label={`Know more about ${title}`}>Know More</Button>
    </div>
  </div>
</article>
