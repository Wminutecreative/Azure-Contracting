---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  testimonial: CollectionEntry<'testimonials'>;
  /** light: white quote card · dark: navy card (slider side cards) */
  tone?: 'light' | 'dark';
  class?: string;
}
const { testimonial, tone = 'light', class: className } = Astro.props;
const { name, role, company, photo, quote, rating } = testimonial.data;
const dark = tone === 'dark';
---

<figure
  class:list={[
    'testimonial rounded-card flex h-full flex-col gap-8 p-8 transition-colors duration-500 md:p-10',
    dark ? 'bg-navy text-white' : 'shadow-card text-text-dark bg-white',
    className,
  ]}
>
  <div class="flex gap-1" role="img" aria-label={`Rated ${rating} out of 5`}>
    {
      Array.from({ length: 5 }, (_, i) => (
        <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" class={i < rating ? 'text-neon' : 'text-light'}>
          <path fill="currentColor" d="m12 2 3.1 6.3 6.9 1-5 4.9 1.2 6.8L12 17.8 5.8 21l1.2-6.8-5-4.9 6.9-1z" />
        </svg>
      ))
    }
  </div>
  <blockquote class="text-h5 flex-1 font-heading">
    <p>“{quote}”</p>
  </blockquote>
  <figcaption class="flex items-center gap-4">
    <Image src={photo} alt="" width={112} height={112} class="size-14 rounded-full object-cover" />
    <span>
      <span class="text-p1-medium block">{name}</span>
      <span class:list={['text-p3 block', dark ? 'text-white/65' : 'text-text-medium']}>{role}, {company}</span>
    </span>
  </figcaption>
</figure>
