---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

// Team member flip card (About Us design, Teams Section). Front: portrait with a white, lime-bordered panel
// holding name + job title. Back: white card with the short bio. Hover / keyboard focus flips the card;
// touch screens flip it on tap.
interface Props {
  member: CollectionEntry<'team'>;
}
const { member } = Astro.props;
const { name, role, photo, bio } = member.data;
const paragraphs = bio?.split(/\n+/).filter(Boolean) ?? [];
---

<article class="team-card shrink-0" tabindex="0" aria-label={`${name}, ${role}`}>
  <div class="team-flip">
    <!-- Front -->
    <div class="team-face team-front bg-[#eef1f4]">
      <Image
        src={photo}
        alt=""
        widths={[400, 600, 800, 1000]}
        sizes="(min-width: 1360px) 646px, (min-width: 768px) 50vw, 100vw"
        loading="lazy"
        draggable="false"
        class="team-photo size-full object-cover object-top select-none"
      />
      <div class="border-neon absolute inset-x-4 bottom-4 rounded-2xl border bg-white px-5 py-4 sm:inset-x-6 sm:bottom-6 sm:px-6">
        <h3 class="text-text-dark font-body text-h5 leading-tight font-medium">{name}</h3>
        <p class="text-stat-label text-p1 mt-0.5">{role}</p>
      </div>
    </div>

    <!-- Back -->
    <div class="team-face team-back bg-white">
      {
        paragraphs.length > 0 && (
          <div class="team-bio text-text-medium text-p2 space-y-[1.4em]">
            {paragraphs.map((p) => <p>{p}</p>)}
          </div>
        )
      }
    </div>
  </div>
</article>

<style>
  .team-card {
    width: 100%;
    aspect-ratio: 17 / 16;
    perspective: 1600px;
    border-radius: 1.25rem;
    cursor: pointer;
  }
  .team-card:focus-visible {
    outline: 2px solid var(--color-navy);
    outline-offset: 4px;
  }
  .team-flip {
    position: relative;
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
    transition: transform 0.8s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .team-face {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-radius: 1.25rem;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }
  .team-back {
    display: flex;
    align-items: center;
    padding: clamp(1.5rem, 0.6rem + 2.4vw, 3rem);
    transform: rotateY(180deg);
  }
  .team-bio {
    max-height: 100%;
    overflow-y: auto;
    text-transform: capitalize; /* Figma sets the bios in title case */
  }

  /* Flip: hover on mouse devices, keyboard focus (not mouse-click focus, which would hold the card flipped after
     the pointer leaves), tap (.is-flipped) on touch */
  .team-card.is-flipped .team-flip,
  .team-card:focus-visible .team-flip {
    transform: rotateY(180deg);
  }
  @media (hover: hover) and (pointer: fine) {
    .team-card:hover .team-flip {
      transform: rotateY(180deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .team-flip {
      transition: none;
    }
  }
</style>

<script>
  // Touch screens: tap a card to flip it, tap again (or another card) to flip back
  document.querySelectorAll<HTMLElement>('.team-card').forEach((card) => {
    card.addEventListener('click', () => {
      if (matchMedia('(hover: hover) and (pointer: fine)').matches) return;
      const flip = !card.classList.contains('is-flipped');
      document.querySelectorAll('.team-card.is-flipped').forEach((c) => c.classList.remove('is-flipped'));
      card.classList.toggle('is-flipped', flip);
      if (!flip) card.blur();
    });
  });
</script>
