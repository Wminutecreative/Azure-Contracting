---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

// Team member card (About Us design): portrait photo in a rounded card. Hover / keyboard focus: a white info
// card with a lime border slides up from the bottom — name, job title and a LinkedIn button. Touch screens
// (no hover) always show the info card.
interface Props {
  member: CollectionEntry<'team'>;
}
const { member } = Astro.props;
const { name, role, photo, linkedin } = member.data;
---

<article class="team-card group relative overflow-hidden rounded-[1.25rem] bg-[#eef1f4]" tabindex="0">
  <Image
    src={photo}
    alt={`${name}, ${role}`}
    widths={[400, 600, 800]}
    sizes="(min-width: 1024px) 400px, (min-width: 640px) 45vw, 100vw"
    loading="lazy"
    class="team-photo aspect-[11/12] w-full object-cover object-top"
  />
  <div class="team-info border-neon absolute inset-x-3 bottom-3 flex items-center justify-between gap-4 rounded-2xl border bg-white px-5 py-4">
    <div class="min-w-0">
      <h3 class="text-text-dark font-body truncate text-lg font-normal">{name}</h3>
      <p class="text-stat-label mt-0.5 text-sm">{role}</p>
    </div>
    {
      linkedin && (
        <a
          href={linkedin}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`${name} on LinkedIn`}
          class="grid size-10 shrink-0 place-items-center rounded-full bg-black text-white transition-transform hover:scale-110"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
            <path
              fill="currentColor"
              d="M6.94 8.5H4.2V19h2.74zM5.57 4.2a1.6 1.6 0 1 0 0 3.2 1.6 1.6 0 0 0 0-3.2M19.8 13.1c0-2.9-1.55-4.8-4.1-4.8-1.35 0-2.27.7-2.66 1.37V8.5h-2.63V19h2.74v-5.3c0-1.4.36-2.6 1.9-2.6 1.52 0 1.53 1.43 1.53 2.7V19h2.74z"
            />
          </svg>
        </a>
      )
    }
  </div>
</article>

<style>
  .team-photo {
    transition: transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .team-info {
    transition:
      opacity 0.35s ease,
      transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }
  @media (hover: hover) and (pointer: fine) {
    .team-info {
      opacity: 0;
      transform: translateY(calc(100% + 1rem));
    }
    .team-card:hover .team-info,
    .team-card:focus-within .team-info {
      opacity: 1;
      transform: none;
    }
    .team-card:hover .team-photo,
    .team-card:focus-within .team-photo {
      transform: scale(1.04);
    }
  }
</style>
