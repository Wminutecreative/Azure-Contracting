---
import { Image } from 'astro:assets';
import { sectors } from '@/data/sectors';
import placeholder from '@/assets/placeholders/landscape.svg';
import ArrowIcon from './ArrowIcon.astro';

// TODO: per-sector images and copy from Figma (homepage 534:1874).
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<div class:list={['border-light border-t', className]}>
  {
    sectors.map((sector, i) => (
      <details class="sector border-light group border-b" name="sectors" open={i === 0} data-accordion>
        <summary class="flex cursor-pointer list-none items-center gap-6 py-6 md:py-8">
          <span class="text-p3 text-text-medium w-8 tabular-nums">{String(i + 1).padStart(2, '0')}</span>
          <span class="text-h3 text-navy group-hover:text-navy/80 flex-1 transition-colors">{sector.label}</span>
          <span class="sector-icon bg-light text-navy group-open:bg-navy group-open:text-neon grid size-11 shrink-0 place-items-center rounded-full transition-colors">
            <ArrowIcon />
          </span>
        </summary>
        <div class="overflow-hidden" data-accordion-body>
          <div class="grid gap-6 pb-8 md:grid-cols-[1fr_1.2fr] md:gap-10 md:pl-14">
            <p class="text-p1 text-text-medium max-w-md">{sector.description}</p>
            <Image
              src={placeholder}
              alt=""
              width={720}
              height={400}
              class="rounded-card aspect-[9/5] w-full object-cover"
            />
          </div>
        </div>
      </details>
    ))
  }
</div>

<style>
  .sector summary::-webkit-details-marker {
    display: none;
  }
  .sector-icon :global(svg) {
    transition: transform 0.35s ease;
  }
  .sector[open] .sector-icon :global(svg) {
    transform: rotate(90deg);
  }
</style>

<script>
  import '@/scripts/accordion';
</script>
