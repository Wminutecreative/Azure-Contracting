---
// Azure logo rebuilt from the design: neon rounded-square outline + "azure" + "FIT OUT SPECIALISTS".
// TODO: swap for the real logo SVG exported from Figma (the wordmark uses a single-storey "a").
// Sized in em: set the wordmark size with a font-size class, e.g. class="text-[110px]".
interface Props {
  tone?: 'dark' | 'light';
  class?: string;
}
const { tone = 'light', class: className = 'text-[2rem]' } = Astro.props;
---

<span
  class:list={[
    'inline-flex items-start gap-[0.15em] leading-none',
    tone === 'light' ? 'text-white' : 'text-navy',
    className,
  ]}
>
  <span class="border-neon mt-[0.05em] block size-[0.77em] shrink-0 rounded-[0.17em] border-[0.056em]" aria-hidden="true"></span>
  <span class="font-display font-light">
    <span class="block text-[1em] leading-[0.8] tracking-[-0.01em]">azure</span>
    <span class="mt-[0.11em] block text-right text-[0.19em] tracking-[0.01em] uppercase">Fit Out Specialists</span>
  </span>
</span>
