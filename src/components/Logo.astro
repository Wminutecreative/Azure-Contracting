---
// Azure logo rebuilt from the design: neon rounded-square outline + "azure" + "FIT OUT SPECIALISTS".
// TODO: swap for the real logo SVG exported from Figma (the wordmark uses a single-storey "a").
// Sized in em: set the wordmark size with a font-size class, e.g. class="text-[110px]".
interface Props {
  tone?: 'dark' | 'light';
  class?: string;
}
const { tone = 'light', class: className = 'text-[2rem]' } = Astro.props;
---

<span
  class:list={[
    'inline-flex items-center gap-[0.12em] leading-none',
    tone === 'light' ? 'text-white' : 'text-navy',
    className,
  ]}
>
  <span class="border-neon block size-[0.84em] shrink-0 rounded-[0.19em] border-[0.055em]" aria-hidden="true"></span>
  <span class="font-heading">
    <span class="block text-[1em] font-normal tracking-[-0.02em]">azure</span>
    <span class="-mt-[0.02em] block text-right text-[0.2em] font-normal tracking-[0.02em] uppercase">Fit Out Specialists</span>
  </span>
</span>
