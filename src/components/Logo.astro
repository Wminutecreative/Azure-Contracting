// Azure Contracting logo (client SVG, 897 × 205): neon mark + "azure" + "FIT OUT SPECIALISTS".
// Sized in em: set the size with a font-size class, e.g. class="text-[3.45rem]" → 184px wide (the width is
// 3.33em, matching the earlier logo so every placement keeps its size). The mark stays neon; the lettering
// follows the tone (white on dark backgrounds, #303030 on light, or the parent's colour).
interface Props {
  /** `inherit` takes the parent's text colour (used by the docking header logo, which switches white → navy) */
  tone?: 'dark' | 'light' | 'inherit';
  class?: string;
}
const { tone = 'light', class: className = 'text-[2rem]' } = Astro.props;
