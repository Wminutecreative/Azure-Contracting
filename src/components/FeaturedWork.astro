---
import type { CollectionEntry } from 'astro:content';
import BigOutlineHeading from './BigOutlineHeading.astro';
import ConnectedStack from './ConnectedStack.astro';
import ProjectCard from './ProjectCard.astro';

// "Our Featured Work" (homepage design): project rows in the connected-box layout (see ConnectedStack) on a
// soft lavender → lime section background.
//
// Scroll animation (GSAP ScrollTrigger, once): heading rises in; per row the photo wipes up while settling
// from a slight zoom, then title / text / button fade up in sequence.
interface Props {
  projects: CollectionEntry<'projects'>[];
  heading?: string;
  /** h1 when the section is the page's main heading (Projects page) */
  headingAs?: 'h1' | 'h2';
  viewAllHref?: string;
  /** Scroll animation (homepage). The Projects page turns it off — static title and rows. */
  animated?: boolean;
  class?: string;
}
const {
  projects,
  heading = 'Our Featured Work',
  headingAs = 'h2',
  viewAllHref,
  animated = true,
  class: className,
} = Astro.props;
---

<section class:list={['featured-work relative isolate', className]} data-featured-work={animated ? '' : undefined}>
  <div class="fw-backdrop pointer-events-none absolute inset-x-0 -top-24 -bottom-24 -z-10" aria-hidden="true"></div>

  <BigOutlineHeading text={heading} as={headingAs}>
    <div class="container-site">
      <ConnectedStack>
        {projects.map((project, i) => <ProjectCard project={project} reverse={i % 2 === 1} eager={i === 0} />)}
      </ConnectedStack>
    </div>
  </BigOutlineHeading>

  {
    viewAllHref && (
      <div class="mt-12 text-center md:mt-20 flex justify-center py-3" data-fw-fade>
        <a href={viewAllHref} class="text-p1 py-3 px-15 text-navy underline underline-offset-4 hover:no-underline">View All</a>
      </div>
    )
  }
</section>

<style>
  /* Soft section background from the design: lavender at the edges, pale lime through the middle */
  .fw-backdrop {
    overflow: hidden;      
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  document.querySelectorAll<HTMLElement>('[data-featured-work]').forEach((section) => {
    if (reduceMotion.matches) return;

    const heading = section.querySelector('[data-reveal]');
    if (heading) {
      gsap.from(heading, {
        y: 60,
        opacity: 0,
        duration: 1.2,
        ease: 'expo.out',
        scrollTrigger: { trigger: heading, start: 'top 85%', once: true },
      });
    }

    section.querySelectorAll<HTMLElement>('[data-fw-row]').forEach((row) => {
      const imgWrap = row.querySelector<HTMLElement>('[data-fw-img]');
      const img = imgWrap?.querySelector('img');
      const texts = row.querySelectorAll('[data-fw-text]');
      const radius = imgWrap ? getComputedStyle(imgWrap).borderTopLeftRadius : '0px';

      const tl = gsap.timeline({ scrollTrigger: { trigger: row, start: 'top 78%', once: true } });
      if (imgWrap) {
        tl.fromTo(
          imgWrap,
          { clipPath: `inset(100% 0% 0% 0% round ${radius})` },
          { clipPath: `inset(0% 0% 0% 0% round ${radius})`, duration: 1.15, ease: 'expo.inOut', clearProps: 'clipPath' },
          0,
        );
      }
      if (img) tl.fromTo(img, { scale: 1.25 }, { scale: 1, duration: 1.6, ease: 'expo.out', clearProps: 'transform' }, 0.15);
      tl.from(texts, { y: 34, opacity: 0, duration: 0.9, ease: 'power3.out', stagger: 0.1 }, 0.35);
    });

    const viewAll = section.querySelector('[data-fw-fade]');
    if (viewAll) {
      gsap.from(viewAll, {
        y: 20,
        opacity: 0,
        duration: 0.8,
        ease: 'power2.out',
        scrollTrigger: { trigger: viewAll, start: 'top 92%', once: true },
      });
    }
  });
</script>
