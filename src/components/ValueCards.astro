---
import { Image } from 'astro:assets';
import precise from '@/assets/icons/precise.png';
import engineered from '@/assets/icons/engineered.png';
import versatile from '@/assets/icons/versatile.png';

// Three tall white cards (405 × 490 at 1512, 48px gap): icon top-left, title bottom-left.
// Icons are cropped from the design. TODO: SVG exports from Figma; check the prototype for hover copy.
interface Props {
  class?: string;
}
const { class: className } = Astro.props;

const values = [
  { title: 'Precise', icon: precise },
  { title: 'Engineered', icon: engineered },
  { title: 'Versatile', icon: versatile },
];
---

<ul class:list={['grid gap-4 sm:grid-cols-3 md:gap-6 lg:gap-12', className]}>
  {
    values.map((v) => (
      <li
        class="card-surface rounded-card flex min-h-60 flex-col justify-between gap-10 p-6 transition-transform duration-500 hover:-translate-y-1 sm:min-h-80 lg:aspect-[405/490]"
        data-reveal
      >
        <Image src={v.icon} alt="" class="h-auto w-20 md:w-[7.5rem]" />
        <h3 class="text-h3 text-text-dark">{v.title}</h3>
      </li>
    ))
  }
</ul>
