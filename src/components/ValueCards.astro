---
import { Image } from 'astro:assets';
import precise from '@/assets/icons/precise.png';
import engineered from '@/assets/icons/engineered.png';
import versatile from '@/assets/icons/versatile.png';

// Three tall translucent-white cards (min 490px, 52px gap at desktop): icon top-left, title + description bottom-left.
// Copy from the Claude Design homepage. TODO: SVG icon exports from Figma.
interface Props {
  class?: string;
}
const { class: className } = Astro.props;

const values = [
  { title: 'Precise', icon: precise, description: 'Setting out, finishes and snag lists handled to the millimetre.' },
  { title: 'Engineered', icon: engineered, description: 'Services, structure and programme planned before a tool is lifted.' },
  { title: 'Versatile', icon: versatile, description: 'One team for hotels, clinics, offices, shops and campuses.' },
];
---

<ul class:list={['grid gap-4 sm:grid-cols-3 md:gap-8 lg:gap-[3.25rem]', className]}>
  {
    values.map((v) => (
      <li
        class="flex min-h-72 flex-col justify-between gap-10 rounded-md bg-white/75 px-[1.375rem] py-6 transition-transform duration-500 hover:-translate-y-1 sm:min-h-96 lg:min-h-[30.625rem]"
        data-reveal
      >
        <Image src={v.icon} alt="" class="h-auto w-24 mix-blend-multiply md:w-[8.125rem]" />
        <div class="flex flex-col gap-3">
          <h3 class="font-body text-navy text-[clamp(1.5rem,2.2vw,2rem)] leading-tight font-normal">{v.title}</h3>
          <p class="text-stat-label max-w-80 text-[0.9375rem] leading-[1.6]">{v.description}</p>
        </div>
      </li>
    ))
  }
</ul>
