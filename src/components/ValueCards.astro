---
import precise from '@/assets/icons/value-precise.png';
import engineered from '@/assets/icons/value-engineered.png';
import versatile from '@/assets/icons/value-versatile.png';

// Three tall white cards (min 490px, 52px gap at desktop): icon top-left, title bottom-left.
// Hover (design): the card fills with a white → olive gradient, the icon turns near-black, and the description
// slides up beneath the title. Touch screens (no hover) show the description all the time.
// Icons are cropped from the design (transparent PNG). TODO: SVG icon exports from Figma.
interface Props {
  class?: string;
}
const { class: className } = Astro.props;

const values = [
  {
    title: 'Precise',
    icon: precise,
    description:
      'Every detail gets the same attention, from first fixing to final snag, so the finished space matches what was actually designed.',
  },
  // TODO: confirm with the hover design — copy below is from the Claude Design homepage
  { title: 'Engineered', icon: engineered, description: 'Services, structure and programme planned before a tool is lifted.' },
  { title: 'Versatile', icon: versatile, description: 'One team for hotels, clinics, offices, shops and campuses.' },
];
---

<ul class:list={['grid gap-4 sm:grid-cols-3 md:gap-8 lg:gap-[3.25rem]', className]}>
  {
    values.map((v) => (
      <li class="value-card relative isolate flex min-h-72 flex-col justify-between gap-10 overflow-hidden rounded-xl border border-transparent bg-white px-[1.375rem] py-6 sm:min-h-96 lg:min-h-[30.625rem]" tabindex="0" data-reveal>
        <span
          class="value-icon block w-24 md:w-[8.125rem]"
          style={`--icon: url(${v.icon.src}); aspect-ratio: ${v.icon.width} / ${v.icon.height}`}
          aria-hidden="true"
        />

        <div>
          <h3 class="value-title font-body text-[clamp(1.5rem,2.2vw,2rem)] leading-tight font-normal">{v.title}</h3>
          <div class="value-desc">
            <p class="text-[0.9375rem] leading-[1.35]">{v.description}</p>
          </div>
        </div>
      </li>
    ))
  }
</ul>

<style>
  .value-card {
    transition: border-color 0.45s ease;
  }
  /* Gradient sits on a pseudo-element so it can fade in (background-image can't transition) */
  .value-card::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(180deg, #fcfcf9 0%, #cfd4aa 28%, #a0a861 61%, #6f7826 100%);
    opacity: 0;
    transition: opacity 0.45s ease;
  }
  /* The icon PNG is used only as a shape mask and filled with colour, so no background can ever show */
  .value-icon {
    background-color: #656565;
    -webkit-mask: var(--icon) center / contain no-repeat;
    mask: var(--icon) center / contain no-repeat;
    transition: background-color 0.45s ease;
  }
  .value-title {
    color: #4a4a4a;
    transition: color 0.45s ease;
  }
  .value-desc {
    display: grid;
    grid-template-rows: 1fr;
    color: #3f4520;
  }
  .value-desc > p {
    min-height: 0;
    overflow: hidden;
    padding-top: 1rem;
    max-width: 18.5rem;
  }

  @media (hover: hover) and (pointer: fine) {
    /* Idle: description collapsed */
    .value-desc {
      grid-template-rows: 0fr;
      opacity: 0;
      transition:
        grid-template-rows 0.5s cubic-bezier(0.22, 1, 0.36, 1),
        opacity 0.35s ease;
    }
    .value-card:hover .value-desc,
    .value-card:focus-visible .value-desc {
      grid-template-rows: 1fr;
      opacity: 1;
      transition:
        grid-template-rows 0.5s cubic-bezier(0.22, 1, 0.36, 1),
        opacity 0.45s ease 0.1s;
    }
  }

  .value-card:hover,
  .value-card:focus-visible {
    border-color: #c9cda8;
  }
  .value-card:hover::before,
  .value-card:focus-visible::before {
    opacity: 1;
  }
  .value-card:hover .value-icon,
  .value-card:focus-visible .value-icon {
    background-color: #262626;
  }
  .value-card:hover .value-title,
  .value-card:focus-visible .value-title {
    color: var(--color-black);
  }
</style>
