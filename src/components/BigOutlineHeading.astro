---
/**
 * The very large faded section title ("Our Featured Work", "Asked Questions", …).
 * From the design: ~180px at 1512, filled with a very faint blue → grey → neon gradient, spanning the page width.
 * Slotted content sits below it (set `overlap` to pull it up over the heading instead).
 * Scroll animation (fade + rise) is added in Phase 8 via [data-reveal].
 */
interface Props {
  text: string;
  as?: 'h1' | 'h2' | 'h3';
  overlap?: boolean;
  align?: 'left' | 'center';
  class?: string;
}
const { text, as: Tag = 'h2', overlap = false, align = 'center', class: className } = Astro.props;
const hasContent = Astro.slots.has('default');
---

<div class:list={['big-heading-root relative', className]}>
  <Tag class:list={['big-heading font-heading', align === 'center' ? 'text-center' : 'text-left']} data-reveal>
    {text}
  </Tag>
  {
    hasContent && (
      <div class:list={['relative', overlap ? 'big-heading-overlap' : 'big-heading-below']}>
        <slot />
      </div>
    )
  }
</div>

<style>
  .big-heading-root {
    /* 11.9vw matches the design at 1512 with Avenir; the Figtree fallback runs wider, so allow a little slack */
    --big-size: min(11.2vw, 11.25rem);
  }
  .big-heading {
    font-size: var(--big-size);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.01em;
    text-wrap: balance;
    color: transparent;
    background: linear-gradient(90deg, #d9e2f7 0%, #e6ecf1 40%, #e9efe9 65%, #eef4d6 100%);
    -webkit-background-clip: text;
    background-clip: text;
  }
  .big-heading-below {
    margin-top: clamp(2rem, 1rem + 4vw, 5.6rem);
  }
  .big-heading-overlap {
    margin-top: calc(var(--big-size) * -0.35);
  }
  @media (forced-colors: active) {
    .big-heading {
      color: CanvasText;
    }
  }
</style>
