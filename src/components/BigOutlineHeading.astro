---
/**
 * The very large faded section title ("Our Featured Work", "Asked Questions", …).
 * From the design: ~180px at 1512, filled with a very faint blue → grey → neon gradient, spanning the page width.
 * Slotted content sits below it (set `overlap` to pull it up over the heading instead).
 * Scroll animation (fade + rise) is added in Phase 8 via [data-reveal].
 */
interface Props {
  text: string;
  as?: 'h1' | 'h2' | 'h3';
  overlap?: boolean;
  align?: 'left' | 'center';
  /** Wrap each word in its own span ([data-word]) so it can be animated separately (e.g. FAQ split) */
  split?: boolean;
  class?: string;
}
const { text, as: Tag = 'h2', overlap = false, align = 'center', split = false, class: className } = Astro.props;
const hasContent = Astro.slots.has('default');
const words = text.split(/\s+/);
---

<div class:list={['big-heading-root relative', className]}>
  <Tag
    class:list={['big-heading font-heading', split && 'is-split', align === 'center' ? 'text-center' : 'text-left']}
    data-reveal
  >
    {
      split
        ? words.map((word, i) => (
            <>
              <span class="big-word" data-word>
                {word}
              </span>
              {i < words.length - 1 && ' '}
            </>
          ))
        : text
    }
  </Tag>
  {
    hasContent && (
      <div class:list={['relative', overlap ? 'big-heading-overlap' : 'big-heading-below']}>
        <slot />
      </div>
    )
  }
</div>

<style>
  .big-heading-root {
    /* Claude Design homepage: Urbanist 400, clamp(56px, 10.4vw, 160px) */
    --big-size: clamp(3.5rem, 10.4vw, 10rem);
  }
  .big-heading {
    font-family: var(--font-display);
    font-size: var(--big-size);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.02em;
    text-wrap: balance;
    color: transparent;
    background: linear-gradient(90deg, #dce3f4 0%, #eef3da 35%, #e4e9f6 65%, #eaf1d3 100%);
    -webkit-background-clip: text;
    background-clip: text;
  }
  /* Split words carry their own gradient (a transformed child can't reliably use the parent's text clip) */
  .big-heading.is-split {
    background: none;
  }
  .big-word {
    display: inline-block;
    color: transparent;
    background: linear-gradient(90deg, #dce3f4 0%, #eef3da 55%, #e4e9f6 100%);
    -webkit-background-clip: text;
    background-clip: text;
    will-change: transform;
  }
  .big-word + .big-word,
  .big-word:nth-child(even) {
    background: linear-gradient(90deg, #e4e9f6 0%, #eaf1d3 100%);
    -webkit-background-clip: text;
    background-clip: text;
  }
  .big-heading-below {
    margin-top: clamp(2rem, 1rem + 4vw, 5.6rem);
  }
  .big-heading-overlap {
    margin-top: calc(var(--big-size) * -0.35);
  }
  @media (forced-colors: active) {
    .big-heading {
      color: CanvasText;
    }
  }
</style>
