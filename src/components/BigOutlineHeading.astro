---
/**
 * The very large faded section title ("Our Featured Work", "Asked Questions", …).
 * From the design: ~180px at 1512, filled with a very faint blue → grey → neon gradient, spanning the page width.
 * Slotted content sits below it (set `overlap` to pull it up over the heading instead).
 * Scroll animation (fade + rise) is added in Phase 8 via [data-reveal].
 */
interface Props {
  text: string;
  as?: 'h1' | 'h2' | 'h3';
  overlap?: boolean;
  align?: 'left' | 'center';
  /** Wrap each word in its own span ([data-word]) so it can be animated separately (e.g. FAQ split) */
  split?: boolean;
  class?: string;
}
const { text, as: Tag = 'h2', overlap = false, align = 'center', split = false, class: className } = Astro.props;
const hasContent = Astro.slots.has('default');
const words = text.split(/\s+/);
---

<div class:list={['big-heading-root relative flex flex-col', className]} style={`--chars: ${text.length}`}>
  <Tag
    class:list={['big-heading font-heading', split && 'is-split', align === 'center' ? 'text-center' : 'text-left']}
    data-reveal
  >
    {
      split
        ? words.map((word, i) => (
            <>
              <span class="big-word-move" data-word>
                <span class="big-word">{word}</span>
              </span>
              {i < words.length - 1 && ' '}
            </>
          ))
        : text
    }
  </Tag>
  {
    hasContent && (
      <div class:list={['relative', overlap ? 'big-heading-overlap' : 'big-heading-below']}>
        <slot />
      </div>
    )
  }
</div>

<style>
  .big-heading-root {
    /* Always ONE line: the design size (12.4vw, max 200px), or smaller for a longer title — sized from its
       character count (--chars, set on the element) to fit the page width between the gutters (~0.56em per
       character in this font). The script below fine-tunes it after the font has loaded. */
    --big-size: min(12.4vw, 12.5rem, calc((100vw - 2 * var(--gutter)) / (var(--chars, 12) * 0)));
  }
  .big-heading {
    font-family: var(--font-display);
    font-size: var(--big-size);
    font-weight: 500;
    display: flex;
    margin: 0 auto;
    max-width: 100%;
    line-height: 1;
    letter-spacing: -0.02em;
    white-space: nowrap;
    color: transparent;
    background: linear-gradient(90deg,  rgba(89, 141, 232, 0.2) 0%, rgba(199, 217, 46, 0.2) 100%);
    /* background: linear-gradient(90deg,#dce3f4 0%,#eef3da 55%,#e4e9f6 100%); */
    -webkit-background-clip: text;
    background-clip: text;
  }
  /* Split words: each word carries its own gradient (a moved child can't use the parent's text clip).
     Animations move the outer .big-word-move wrapper only — transforming or fading the background-clip:text
     element itself makes Chromium stop painting the text mid-animation. */
  .big-heading.is-split {
    background: none;
  }
  .big-word-move {
    display: inline-block;
  }
  .big-word {
    display: inline-block;
    color: transparent;
    /* background: linear-gradient(90deg, #dce3f4 0%, #eef3da 55%, #e4e9f6 100%); */
    background: linear-gradient(90deg,  rgba(89, 141, 232, 0.2) 0%, rgba(199, 217, 46, 0.2) 100%);
    -webkit-background-clip: text;
    background-clip: text;
  }
  .big-word-move + .big-word-move .big-word {
    /* background: linear-gradient(90deg, #e4e9f6 0%, #eaf1d3 100%); */
    background: linear-gradient(90deg,  rgba(89, 141, 232, 0.2) 0%, rgba(199, 217, 46, 0.2) 100%);
    -webkit-background-clip: text;
    background-clip: text;
  }
  .big-heading-below {
    margin-top: clamp(2rem, 1rem + 4vw, 5rem);
  }
  .big-heading-overlap {
    margin-top: calc(var(--big-size) * -0.35);
  }
  @media (forced-colors: active) {
    .big-heading {
      color: CanvasText;
    }
  }
</style>

<script>
  // Fine-tune: if a title is still wider than the space it has (the CSS size is an estimate), shrink it to fit
  // exactly. Re-checked once the fonts have loaded and when the width changes.
  const fit = () => {
    document.querySelectorAll<HTMLElement>('.big-heading').forEach((h) => {
      h.style.fontSize = '';
      const room = h.parentElement?.clientWidth ?? 0;
      if (room && h.scrollWidth > room) {
        const size = parseFloat(getComputedStyle(h).fontSize);
        h.style.fontSize = `${Math.floor(size * (room / h.scrollWidth) * 0.98)}px`;
      }
    });
  };
  fit();
  document.fonts?.ready.then(fit);
  let lastW = window.innerWidth;
  window.addEventListener('resize', () => {
    if (window.innerWidth === lastW) return;
    lastW = window.innerWidth;
    fit();
  });
</script>
