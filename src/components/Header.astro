---
import { Image } from 'astro:assets';
import { menuGroups, social } from '@/data/site';
import Logo from './Logo.astro';
import menuImage from '@/assets/menu/blueprints.png'; // cropped 1× from the open-state design — TODO: Figma export

interface Props {
  /** Transparent header with light icons, for pages whose hero sits under the header */
  overlay?: boolean;
  /** Centre logo — the homepage hides it because the hero carries the large logo */
  showLogo?: boolean;
  /**
   * Homepage: fixed header whose logo starts at hero size in the middle of the full-screen hero, scrolls up with
   * the page while shrinking, and docks in the navbar centre. Once the hero is passed the bar turns solid.
   * The hero must carry [data-hero] and the same logo size class as `dockLogoSize`.
   */
  dock?: boolean;
}
const { overlay = false, showLogo = true, dock = false } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => path.startsWith(href);
// In dock mode the foreground colour is driven by CSS (white over the hero → navy on the solid bar)
const tone = dock ? 'hdr-fg' : overlay ? 'text-white' : 'text-navy';
const dockLogoSize = 'text-[clamp(4.5rem,8.2vw,7.75rem)]';
// "ENQUIRE" text link (right of the bar): uppercase, tracked out, underline slides in on hover / focus
const enquire = `enquire-link text-p1 justify-self-end rounded-sm px-1 py-2 font-medium tracking-[0.08em] ${tone}`;

const socialIcons: Record<string, string> = {
  LinkedIn:
    'M6.94 8.5H4.2V19h2.74zM5.57 4.2a1.6 1.6 0 1 0 0 3.2 1.6 1.6 0 0 0 0-3.2M19.8 13.1c0-2.9-1.55-4.8-4.1-4.8-1.35 0-2.27.7-2.66 1.37V8.5h-2.63V19h2.74v-5.3c0-1.4.36-2.6 1.9-2.6 1.52 0 1.53 1.43 1.53 2.7V19h2.74z',
  X: 'M17.75 3h3.06l-6.69 7.64L22 21h-6.17l-4.83-6.32L5.47 21H2.4l7.15-8.18L2 3h6.33l4.37 5.78zm-1.07 16.2h1.7L7.4 4.73H5.58z',
};
---

<!--
  Sticky on every page, same look everywhere:
  - Homepage (dock): transparent over the hero, logo docks from the hero, frosted bar once the hero has passed.
  - Other pages: transparent at the top, frosted bar (and shorter on desktop) as soon as the page scrolls.
  The frosted state is the `hdr-solid` class on <html>, set by the scripts below.
-->
<header
  class:list={['site-header z-40', overlay && !dock ? 'absolute inset-x-0 top-0' : 'fixed inset-x-0 top-0']}
  data-dock={dock ? '' : undefined}
  data-sticky={!overlay || dock ? '' : undefined}
>
  <div class="hdr-bar hdr-row relative grid h-(--hdr-h) grid-cols-[1fr_auto_1fr] items-center gap-4">
    <button
      type="button"
      class:list={['-ml-2 inline-flex items-center gap-2 justify-self-start rounded-lg p-2 cursor-pointer', tone]}
      data-hdr-control
      aria-haspopup="dialog"
      aria-controls="site-menu"
      aria-expanded="false"
      aria-label="Open menu"
      data-menu-open
    >
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <path d="M3 6h18M3 12h18M3 18h18"></path>
      </svg>
      <span class="text-p1 max-md:hidden" aria-hidden="true">Menu</span>
    </button>

    {
      showLogo && !dock ? (
        <a href="/" aria-label="Azure Contracting — home" class="justify-self-center">
          {/* 3.45rem → 184px wide (2.6rem → 140px on phones), the same size as the docked homepage logo */}
          <Logo tone={overlay ? 'light' : 'dark'} class="text-[2.6rem] md:text-[3.45rem]" />
        </a>
      ) : (
        <span />
      )
    }

    <a href="/contact" class={enquire} data-track="cta_click" data-cta-location="header" data-hdr-control>Enquire</a>

    <!-- Docking logo: rendered at hero size and scaled down to dock, so it stays crisp at its largest -->
    {
      dock && (
        <a href="/" aria-label="Azure Contracting — home" class="dock-logo hdr-fg" data-dock-logo tabindex="-1">
          <Logo tone="inherit" class={dockLogoSize} />
        </a>
      )
    }
  </div>
</header>
<!-- Fixed header takes no space: reserve its (unscrolled) height so page content starts below it -->
{!overlay && !dock && <div class="h-20 md:h-[8.5rem]" aria-hidden="true"></div>}

<!--
  Menu open state (design, 1512px): the header bar stays in place with "✕ Menu", and a white panel
  (20px radius, 30px padding) drops in below it with three columns:
  Company card (491, lavender → pale-neon gradient) · Resources (420) + social icons · image (404 × 252).
  Tablet: two columns, no image. Mobile: stacked, scrolls within the viewport.
-->
<dialog id="site-menu" class="site-menu m-0 h-dvh max-h-none w-full max-w-none overflow-y-auto bg-transparent p-0" aria-label="Site menu">
  <!-- Dims the page below the header bar while the menu is open -->
  <div class="menu-dim" aria-hidden="true"></div>
  <div class="flex min-h-full flex-col" data-menu-dismiss>
    <div class="menu-bar hdr-row grid h-(--hdr-h) shrink-0 grid-cols-[1fr_auto_1fr] items-center gap-4" data-menu-dismiss>
      <button
        type="button"
        class:list={['-ml-2 inline-flex items-center gap-2 justify-self-start rounded-lg p-2 cursor-pointer', tone]}
        aria-label="Close menu"
        data-menu-close
      >
        <!-- Same three lines as the header's hamburger; they fold into an ✕ as the menu opens -->
        <svg class="menu-burger" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M3 6h18"></path>
          <path d="M3 12h18"></path>
          <path d="M3 18h18"></path>
        </svg>
        <span class="text-p1 max-md:hidden" aria-hidden="true">Menu</span>
      </button>
      <span></span>
      <a href="/contact" class={enquire} data-track="cta_click" data-cta-location="menu">Enquire</a>
    </div>

    <div class="menu-panel mx-[clamp(0.75rem,3.5vw,3.3rem)] mb-4 rounded-[1.25rem] bg-white p-3 shadow-[0_24px_60px_-24px_rgb(14_31_61/0.35)] md:-mt-1 md:p-[1.875rem]">
      <nav aria-label="Main" class="grid gap-3 md:grid-cols-2 md:gap-[0.9375rem] lg:grid-cols-[491fr_420fr_404fr]">
        {
          menuGroups.map((group, gi) => (
            <div
              class:list={[
                'menu-item flex flex-col rounded-2xl px-3 pt-6 pb-4 md:pt-7 md:pb-5',
                gi === 0 ? 'menu-company md:px-[1.8rem]' : 'md:px-0 md:pb-0',
              ]}
            >
              <h2 class="text-p2 text-text-dark mb-3 px-5 md:mb-5">{group.title}</h2>
              <ul class="flex flex-col">
                {group.links.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      aria-current={isCurrent(link.href) ? 'page' : undefined}
                      class:list={[
                        'menu-link text-p1 text-text-dark font-medium flex py-4 items-center rounded-xl border border-transparent px-5 transition-colors duration-200',
                        gi === 0 ? 'menu-link-company' : 'menu-link-resources',
                      ]}
                    >
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>

              {gi === 1 && (
                <ul class="mt-6 flex gap-2 px-5 md:mt-auto md:justify-end md:px-0 md:pt-6 cursor-pointer" aria-label="Social media">
                  {social.map((s) => {
                    const icon =
                      s.name === 'Instagram' ? (
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
                          <rect x="3.5" y="3.5" width="17" height="17" rx="5" />
                          <circle cx="12" cy="12" r="4" />
                          <circle cx="17.3" cy="6.7" r="1.1" fill="currentColor" stroke="none" />
                        </svg>
                      ) : (
                        <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true">
                          <path fill="currentColor" d={socialIcons[s.name]} />
                        </svg>
                      );
                    // const cls = 'grid size-8 place-items-center rounded-full bg-black text-white';
const cls =
  'grid size-8 place-items-center rounded-full bg-black text-white transition-all duration-300 ease-out hover:-translate-y-1 hover:scale-110 hover:bg-white hover:text-black hover:shadow-md';
                    return (
                      <li>
                        {s.href ? (
                          <a href={s.href} target="_blank" rel="noopener noreferrer" aria-label={`Azure Contracting on ${s.name}`} class={`${cls} transition-transform hover:-translate-y-0.5`}>
                            {icon}
                          </a>
                        ) : (
                          <span class={cls} title={`${s.name} — link coming soon`}>{icon}</span>
                        )}
                      </li>
                    );
                  })}
                </ul>
              )}
            </div>
          ))
        }

        <div class="menu-item hidden overflow-hidden rounded-xl lg:block">
          <Image src={menuImage} alt="" class="h-full w-full object-cover" loading="lazy" />
        </div>
      </nav>
    </div>
  </div>
</dialog>

<style is:global>
  /* Header bar height — shared with the menu dialog's bar so the two always line up */
  :root {
    --hdr-h: 5rem;
  }
  @media (min-width: 48rem) {
    :root {
      --hdr-h: 8.5rem;
    }
    :root.hdr-solid {
      --hdr-h: 5.75rem;
    }
  }
  .hdr-bar {
    transition: height 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* Menu open / close motion (modelled on osmo.supply): one easing — slow start, fast middle, long soft landing */
  :root {
    --menu-ease: cubic-bezier(0.625, 0.05, 0, 1);
    --menu-dur: 0.6s;
    --menu-dur-long: 0.9s;
  }
  /* The page behind the open menu moves back slightly (the script sets the origin to the middle of the screen) */
  #main {
    transition: transform var(--menu-dur) var(--menu-ease);
  }
  :root.menu-open #main {
    transform: translateY(-2rem) scale(0.975);
  }
  @media (prefers-reduced-motion: reduce) {
    :root.menu-open #main {
      transform: none;
    }
  }

  /* Header controls row. Desktop: "☰ Menu" + ENQUIRE sit in a compact centred bar (the middle half of the
     page); opening the menu widens the dialog's copy of the bar to the full page width, closing shrinks it back.
     Phones / tablets: always full width (not enough room for the compact bar). */
  .hdr-row {
    padding-inline: var(--edge);
  }
  @media (min-width: 75rem) {
    .hdr-row {
      padding-inline: 25%;
    }
    /* Closing: the bar narrows last, once the panel has folded away */
    .menu-bar {
      transition: padding-inline var(--menu-dur) var(--menu-ease) 0.2s;
    }
    .site-menu.is-open .menu-bar {
      padding-inline: var(--edge);
      transition-delay: 0s;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .menu-bar {
      transition: none;
    }
  }

  /* Dock mode (homepage): white over the hero, navy once the bar turns solid */
  .hdr-fg {
    color: var(--color-white);
    transition: color 0.3s ease;
  }
  :root.hdr-solid .hdr-fg {
    color: var(--color-navy);
  }
  .site-header[data-sticky] {
    transition:
      background-color 0.35s ease,
      box-shadow 0.35s ease,
      backdrop-filter 0.35s ease;
  }
  :root.hdr-solid .site-header[data-sticky] {
    background-color: rgb(244 249 253 / 0.85);
    -webkit-backdrop-filter: blur(10px) saturate(1.4);
    backdrop-filter: blur(10px) saturate(1.4);
    box-shadow: 0 1px 0 rgb(14 31 61 / 0.07);
  }

  /* Docking logo. Without JS it stays hidden (the hero shows its own logo). With motion, CSS places it over the
     hero centre before the script runs, so there is no jump on load; the script then drives it from scroll. */
  .dock-logo {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    transform-origin: 50% 50%;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }
  :root.motion .dock-logo {
    opacity: 1;
    pointer-events: auto;
    transform: translate(-50%, -50%) translateY(calc(50svh - var(--hdr-h) / 2));
  }
  /* Reduced motion: no travel — the small logo simply fades into the solid bar */
  :root.hdr-solid .dock-logo {
    opacity: 1;
    pointer-events: auto;
  }
</style>

<style>
  .site-menu::backdrop {
    background: transparent;
  }
  .menu-company {
    background: linear-gradient(90deg, #e9eef9 0%, #eef2f1 50%, #f7f9e6 100%);
  }
  /* Hover / focus / current page = white pill (company card) or outlined pill (on the white panel) */
  .menu-link-company:hover,
  .menu-link-company:focus-visible,
  .menu-link-company[aria-current='page'] {
    background: var(--color-white);
  }
  .menu-link-resources:hover,
  .menu-link-resources:focus-visible,
  .menu-link-resources[aria-current='page'] {
    background: var(--color-white);
    border-color: var(--color-light);
  }
  .menu-link:focus-visible {
    outline-offset: -2px;
  }

  /* "ENQUIRE": an underline grows from the left on hover / focus */
  .enquire-link {
    background: linear-gradient(currentColor, currentColor) no-repeat 0.25rem calc(100% - 0.35rem) / 0 1px;
    transition:
      background-size 0.35s cubic-bezier(0.22, 1, 0.36, 1),
      color 0.3s ease;
  }
  .enquire-link:hover,
  .enquire-link:focus-visible {
    background-size: calc(100% - 0.5rem) 1px;
  }
  @media (prefers-reduced-motion: reduce) {
    .enquire-link {
      transition: none;
    }
  }

  /* Open / close animation (osmo.supply style). Opening: page dims and the bar widens (0.6s) → after 0.3s the
     panel unfolds downward out of the bar (0.9s) → its columns rise into place one after another (0.3 / 0.375 /
     0.45s). Closing reverses everything at 0.6s with no delays; the bar narrows last (see .menu-bar above). */
  .menu-dim {
    position: fixed;
    inset: var(--hdr-h) 0 0;
    z-index: -1;
    background: rgb(14 31 61 / 0.3);
    opacity: 0;
    transition: opacity var(--menu-dur) var(--menu-ease);
  }
  .site-menu.is-open .menu-dim {
    opacity: 1;
  }

  /* The panel is revealed from its top edge down (clip), while settling up from just above.
     Open state clips outside the box so the drop shadow isn't cut off. */
  .menu-panel {
    clip-path: inset(0 0 100% 0 round 1.25rem);
    transform: translateY(-0.625rem);
    transition:
      clip-path var(--menu-dur) var(--menu-ease),
      transform var(--menu-dur) var(--menu-ease);
  }
  .site-menu.is-open .menu-panel {
    clip-path: inset(-3rem -3rem -4rem -3rem round 1.25rem);
    transform: none;
    transition-duration: var(--menu-dur-long);
    transition-delay: 0.3s;
  }

  .menu-item {
    opacity: 0;
    transform: translateY(2rem);
    transition:
      transform var(--menu-dur) var(--menu-ease),
      opacity 0.3s ease;
  }
  .site-menu.is-open .menu-item {
    opacity: 1;
    transform: none;
    transition:
      transform var(--menu-dur-long) var(--menu-ease),
      opacity 0.6s ease;
  }
  .site-menu.is-open .menu-item:nth-child(1) { transition-delay: 0.3s; }
  .site-menu.is-open .menu-item:nth-child(2) { transition-delay: 0.375s; }
  .site-menu.is-open .menu-item:nth-child(3) { transition-delay: 0.45s; }

  /* Hamburger → ✕: outer lines turn ±45° into the middle, the middle line shrinks away */
  .menu-burger path {
    transform-box: fill-box;
    transform-origin: center;
    transition:
      transform var(--menu-dur) var(--menu-ease),
      opacity 0.2s ease;
  }
  .site-menu.is-open .menu-burger path:nth-child(1) {
    transform: translateY(6px) rotate(45deg) scaleX(0.85);
  }
  .site-menu.is-open .menu-burger path:nth-child(2) {
    transform: scaleX(0);
    opacity: 0;
  }
  .site-menu.is-open .menu-burger path:nth-child(3) {
    transform: translateY(-6px) rotate(-45deg) scaleX(0.85);
  }

  @media (prefers-reduced-motion: reduce) {
    .menu-dim,
    .menu-panel,
    .menu-item,
    .menu-burger path {
      transition: none !important;
    }
  }
</style>

<script>
  // <dialog> + showModal() gives Esc handling, focus trapping and an inert page behind the menu.
  const menu = document.getElementById('site-menu') as HTMLDialogElement | null;
  const openBtn = document.querySelector<HTMLButtonElement>('[data-menu-open]');
  // The dialog repeats the header controls ("✕ Menu" + ENQUIRE) in the same spot, so hide the real ones
  // underneath. The logo and the solid bar stay visible behind the transparent dialog.
  const controls = document.querySelectorAll<HTMLElement>('[data-hdr-control]');
  const setControlsHidden = (hidden: boolean) => controls.forEach((el) => (el.style.visibility = hidden ? 'hidden' : ''));
  const reduceMotion = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function lockScroll(lock: boolean) {
    const root = document.documentElement;
    if (lock) {
      // root.style.paddingRight = `${window.innerWidth - root.clientWidth}px`;
      root.style.overflow = 'hidden';
    } else {
      root.style.overflow = '';
      // root.style.paddingRight = '';
    }
  }

  const page = document.getElementById('main');
  let closeTimer = 0;

  function open() {
    if (!menu || menu.open) return;
    clearTimeout(closeTimer);
    menu.showModal();
    lockScroll(true);
    setControlsHidden(true);
    openBtn?.setAttribute('aria-expanded', 'true');
    // The page behind moves back around the middle of the screen, wherever it is scrolled to
    if (page) page.style.transformOrigin = `50% ${window.scrollY - page.offsetTop + window.innerHeight / 2}px`;
    void menu.offsetWidth; // commit the closed styles first so the open transitions always run
    requestAnimationFrame(() => {
      menu.classList.add('is-open');
      document.documentElement.classList.add('menu-open');
    });
  }

  function close() {
    if (!menu || !menu.open) return;
    menu.classList.remove('is-open');
    document.documentElement.classList.remove('menu-open');
    const finish = () => {
      menu.close();
      lockScroll(false);
      setControlsHidden(false);
      openBtn?.setAttribute('aria-expanded', 'false');
      openBtn?.focus();
    };
    if (reduceMotion()) finish();
    else closeTimer = window.setTimeout(finish, 800); // panel folds away (0.6s), then the bar narrows (0.2s later)
  }

  openBtn?.addEventListener('click', open);
  menu?.querySelectorAll('[data-menu-close]').forEach((el) => el.addEventListener('click', close));
  menu?.addEventListener('cancel', (e) => {
    e.preventDefault();
    close();
  });
  // Click outside the panel (on the transparent overlay or the empty header area) closes the menu
  menu?.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (target === menu || target.hasAttribute('data-menu-dismiss')) close();
  });
  menu?.querySelectorAll('.menu-panel a').forEach((a) => a.addEventListener('click', () => close()));
</script>

<script>
  // Docking logo (homepage). Scroll 0 → logo at hero size in the hero centre. As the page scrolls it rises
  // exactly with the content while scaling down, reaching the navbar centre after (hero − header) / 2 px.
  // When the hero has fully passed under the header, <html> gets `hdr-solid` (solid bar, navy foreground).
  const logo = document.querySelector<HTMLElement>('[data-dock-logo]');
  const hero = document.querySelector<HTMLElement>('[data-hero]');

  if (logo && hero) {
    const root = document.documentElement;
    const logoInner = logo.firstElementChild as HTMLElement;
    const md = window.matchMedia('(min-width: 48rem)');
    const rem = () => parseFloat(getComputedStyle(root).fontSize) || 16;

    let heroH = 0;
    let barH = 0; // header height over the hero (before it turns solid)
    let travel = 0;
    let endScale = 1;
    let queued = false;
    // Docked logo width: 184px (design spec) from tablet up, 140px on phones so it clears the menu + button
    const dockW = () => (md.matches ? 184 : 140);

    const measure = () => {
      heroH = hero.offsetHeight;
      barH = (md.matches ? 8.5 : 5) * rem();
      travel = Math.max(1, (heroH - barH) / 2);
      // Docked logo is 184px wide (design spec: 184 × 49). offsetWidth ignores the transform, so this is the
      // logo's full hero width (the client logo SVG lands at ~184 × 42).
      endScale = dockW() / logoInner.offsetWidth;
    };

    const update = () => {
      queued = false;
      const y = Math.max(0, window.scrollY);
      root.classList.toggle('hdr-solid', y >= heroH - barH);

      if (root.classList.contains('motion')) {
        const p = Math.min(y / travel, 1);
        const scale = 1 + (endScale - 1) * p;
        logo.style.transform = `translate(-50%, -50%) translateY(${travel * (1 - p)}px) scale(${scale})`;
        // will-change only while it moves: a promoted layer keeps the hero-size bitmap and blurs the small
        // docked logo (the fine "FIT OUT SPECIALISTS" line); dropping it lets the browser redraw it crisply.
        logo.style.willChange = p > 0 && p < 1 ? 'transform' : 'auto';
      } else {
        logo.style.transform = `translate(-50%, -50%) scale(${endScale})`;
      }
      // Only focusable once it is a small navbar logo
      logo.tabIndex = y >= travel ? 0 : -1;
    };

    const queue = () => {
      if (!queued) {
        queued = true;
        requestAnimationFrame(update);
      }
    };

    measure();
    update();
    window.addEventListener('scroll', queue, { passive: true });
    window.addEventListener('resize', () => {
      measure();
      queue();
    });
    // Fonts change the measured size once loaded
    document.fonts?.ready.then(() => {
      measure();
      queue();
    });
  }
</script>

<script>
  // Sticky header on pages without the docking hero: frosted bar as soon as the page is scrolled.
  const sticky = document.querySelector<HTMLElement>('.site-header[data-sticky]:not([data-dock])');
  if (sticky) {
    const root = document.documentElement;
    let queued = false;
    const update = () => {
      queued = false;
      root.classList.toggle('hdr-solid', window.scrollY > 8);
    };
    window.addEventListener(
      'scroll',
      () => {
        if (!queued) {
          queued = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true },
    );
    update();
  }
</script>
