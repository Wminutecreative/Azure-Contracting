---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

// Services page card (design): white rounded card — name + bullet list + "Read More…" on the left, photo on
// the right. Lists longer than VISIBLE items collapse with a Read More / Read Less toggle (enhanced by the
// script on the Services page; without JS every item shows and the toggle stays hidden).
interface Props {
  service: CollectionEntry<'services'>;
  eager?: boolean;
}
const VISIBLE = 5;
const { service, eager = false } = Astro.props;
const { category, items, image, imageAlt } = service.data;
const collapsible = items.length > VISIBLE;
const listId = `svc-${service.id}`;
---

<!-- Photo: every card's photo has the same wide banner frame (816:318, the design's export size), whatever the
     source's shape; when "Read More" opens a longer list the card grows and the photo stretches with it
     (object-cover crops). -->
<article class="svc-card grid gap-6 rounded-[1.25rem] bg-white p-5 md:grid-cols-[minmax(0,3fr)_minmax(0,2fr)] md:items-stretch md:gap-10 md:p-6">
  <div class="md:py-2">
    <h2 class="text-text-dark font-body text-[clamp(1.5rem,1.25rem+0.9vw,2rem)] leading-tight font-normal">{category}</h2>
    <ul id={listId} class="svc-list text-text-medium mt-4 list-disc space-y-0.5 pl-5 text-p1 leading-[1.45]" data-svc-list data-visible={VISIBLE}>
      {items.map((item) => <li>{item}</li>)}
    </ul>
    {
      collapsible && (
        <button
          type="button"
          class="text-navy mt-5 text-p1 underline underline-offset-4 hover:no-underline cursor-pointer"
          aria-controls={listId}
          aria-expanded="false"
          data-svc-toggle
          hidden
        >
          Read More…
        </button>
      )
    }
  </div>
  <!-- Width always comes from the grid column; the padding spacer (318/816 of the width) sets the banner's minimum
       height. (CSS aspect-ratio can't be used here: stretched taller, it widens the box out of the card.) -->
  <div class="svc-photo relative min-w-0 overflow-hidden rounded-2xl max-md:order-first">
    <div class="pt-[38.97%]" aria-hidden="true"></div>
    <Image
      src={image}
      alt={imageAlt}
      widths={[480, 720, 960, 1280]}
      sizes="(min-width: 1200px) 480px, (min-width: 768px) 40vw, 100vw"
      loading={eager ? 'eager' : 'lazy'}
      class="absolute inset-0 size-full object-cover"
    />
  </div>
</article>

<style>
  /* Collapsed (set by the script): hide items after the first VISIBLE (5) */
  .svc-list.is-collapsed > :global(li:nth-child(n + 6)) {
    display: none;
  }
</style>
