---
// Full-screen image viewer (reference: se-arkitektur.no project galleries).
// Dark overlay with the page faintly behind · the photo on a large light panel · thin chevrons at the screen edges ·
// small × top-right · a strip of thumbnails along the bottom (click to jump, current one highlighted).
// Any element with [data-lb-open="<index>"] opens it at that photo. ← → keys / swipe to move; Esc, × or a click on
// the dark area closes. Built on <dialog> + showModal(): focus stays inside, the page behind is inert.
//
// Styles are global (prefixed .lb-) rather than scoped, so they always apply to the dialog's content.
export interface LightboxItem {
  src: string;
  thumb: string;
  alt: string;
}
interface Props {
  items: LightboxItem[];
}
const { items } = Astro.props;
const many = items.length > 1;
---

<dialog class="lb" aria-label="Photo viewer" data-lightbox data-items={JSON.stringify(items)}>
  <div class="lb-layout" data-lb-dismiss>
    <div class="lb-stage" data-lb-dismiss>
      <figure class="lb-panel">
        <img class="lb-img" alt="" data-lb-img />
      </figure>
    </div>

    {
      many && (
        <div class="lb-thumbs" role="tablist" aria-label="Photos" data-lb-dismiss>
          {items.map((it, i) => (
            <button type="button" class="lb-thumb" role="tab" aria-label={`Photo ${i + 1}: ${it.alt}`} aria-selected="false" data-lb-thumb={i}>
              <img src={it.thumb} alt="" loading="lazy" decoding="async" />
            </button>
          ))}
        </div>
      )
    }
  </div>

  <button type="button" class="lb-icon lb-close" aria-label="Close photo viewer" data-lb-close>
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"></path></svg>
  </button>
  {
    many && (
      <>
        <button type="button" class="lb-icon lb-prev" aria-label="Previous photo" data-lb-prev>
          <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 4 7 12l8 8" /></svg>
        </button>
        <button type="button" class="lb-icon lb-next" aria-label="Next photo" data-lb-next>
          <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 4 8 8-8 8" /></svg>
        </button>
      </>
    )
  }
  <p class="sr-only" aria-live="polite" data-lb-status></p>
</dialog>

<style is:global>
  .lb {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: #fff;
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .lb[open].is-visible {
    opacity: 1;
  }
  .lb::backdrop {
    background: rgb(0 0 0 / 0.86);
  }
  .lb-layout {
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    height: 100%;
    padding: 1.5rem clamp(3.5rem, 11vw, 13rem) 1rem;
    gap: 1.25rem;
  }
  .lb-stage {
    display: grid;
    place-items: center;
    min-height: 0;
  }
  /* The light panel the photo sits on */
  .lb-panel {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    max-width: 92.5rem;
    margin: 0;
    padding: clamp(1rem, 4vw, 4.5rem) clamp(1rem, 5vw, 6rem);
    background: #fdfdf6;
    touch-action: pan-y;
  }
  /* Fill the panel (scaled to fit, never cropped) */
  .lb-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    user-select: none;
    -webkit-user-drag: none;
    transition: opacity 0.22s ease;
  }
  .lb-img.is-swapping {
    opacity: 0;
  }

  /* Thumbnail strip */
  .lb-thumbs {
    display: flex;
    justify-content: center;
    gap: 1.25rem;
    overflow-x: auto;
    padding: 0.25rem 0.25rem 0.5rem;
    scrollbar-width: none;
  }
  .lb-thumbs::-webkit-scrollbar {
    display: none;
  }
  .lb-thumb {
    flex: 0 0 auto;
    width: clamp(3.5rem, 6.5vw, 6.25rem);
    aspect-ratio: 1;
    padding: 0;
    border: 0;
    background: #fdfdf6;
    opacity: 0.5;
    cursor: pointer;
    transition: opacity 0.25s ease, outline-color 0.25s ease;
    outline: 2px solid transparent;
    outline-offset: 3px;
  }
  .lb-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .lb-thumb:hover,
  .lb-thumb[aria-selected='true'] {
    opacity: 1;
  }
  .lb-thumb[aria-selected='true'] {
    outline-color: var(--color-neon);
  }
  .lb-thumb:focus-visible {
    outline-color: #fff;
  }

  /* Close + chevrons: plain white icons, no background */
  .lb-icon {
    position: absolute;
    display: grid;
    place-items: center;
    padding: 0.5rem;
    border: 0;
    background: none;
    color: rgb(255 255 255 / 0.85);
    cursor: pointer;
    transition: color 0.2s ease, transform 0.25s ease;
  }
  .lb-icon:hover {
    color: #fff;
  }
  .lb-icon:focus-visible {
    outline: 2px solid var(--color-neon);
    outline-offset: 2px;
    border-radius: 0.375rem;
  }
  .lb-close {
    top: 0.9rem;
    right: 1rem;
  }
  .lb-prev,
  .lb-next {
    top: 44%;
    transform: translateY(-50%);
  }
  .lb-prev {
    left: clamp(0.25rem, 1.5vw, 1.5rem);
  }
  .lb-next {
    right: clamp(0.25rem, 1.5vw, 1.5rem);
  }
  .lb-prev:hover {
    transform: translate(-3px, -50%);
  }
  .lb-next:hover {
    transform: translate(3px, -50%);
  }

  @media (max-width: 47.99rem) {
    .lb-layout {
      padding: 3.5rem 0.75rem 0.75rem;
    }
    .lb-prev,
    .lb-next {
      top: auto;
      bottom: 5.5rem;
      transform: none;
    }
    .lb-thumbs {
      justify-content: flex-start;
      gap: 0.6rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .lb,
    .lb-img {
      transition: none;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLDialogElement>('[data-lightbox]').forEach((box) => {
    const items: { src: string; alt: string }[] = JSON.parse(box.dataset.items ?? '[]');
    const img = box.querySelector<HTMLImageElement>('[data-lb-img]')!;
    const status = box.querySelector<HTMLElement>('[data-lb-status]');
    const thumbs = Array.from(box.querySelectorAll<HTMLButtonElement>('[data-lb-thumb]'));
    const reduce = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let index = 0;
    let opener: HTMLElement | null = null;

    const preload = (i: number) => {
      const it = items[(i + items.length) % items.length];
      if (it) new window.Image().src = it.src;
    };

    const show = (i: number, animate = true) => {
      index = (i + items.length) % items.length;
      const it = items[index];
      const apply = () => {
        img.src = it.src;
        img.alt = it.alt;
        img.classList.remove('is-swapping');
      };
      if (animate && !reduce()) {
        img.classList.add('is-swapping');
        window.setTimeout(apply, 160);
      } else apply();
      thumbs.forEach((t, n) => t.setAttribute('aria-selected', String(n === index)));
      thumbs[index]?.scrollIntoView({ block: 'nearest', inline: 'center', behavior: reduce() ? 'auto' : 'smooth' });
      if (status) status.textContent = `Photo ${index + 1} of ${items.length}: ${it.alt}`;
      preload(index + 1);
      preload(index - 1);
    };

    const open = (i: number, from: HTMLElement) => {
      opener = from;
      box.showModal();
      show(i, false);
      document.documentElement.style.overflow = 'hidden';
      requestAnimationFrame(() => box.classList.add('is-visible'));
    };
    const close = () => {
      box.classList.remove('is-visible');
      const done = () => {
        box.close();
        document.documentElement.style.overflow = '';
        opener?.focus();
      };
      if (reduce()) done();
      else window.setTimeout(done, 250);
    };

    document.querySelectorAll<HTMLElement>('[data-lb-open]').forEach((el) =>
      el.addEventListener('click', (e) => {
        e.preventDefault();
        open(Number(el.dataset.lbOpen) || 0, el);
      }),
    );
    thumbs.forEach((t) => t.addEventListener('click', () => show(Number(t.dataset.lbThumb))));
    box.querySelector('[data-lb-close]')?.addEventListener('click', close);
    box.querySelector('[data-lb-prev]')?.addEventListener('click', () => show(index - 1));
    box.querySelector('[data-lb-next]')?.addEventListener('click', () => show(index + 1));
    box.addEventListener('cancel', (e) => {
      e.preventDefault();
      close();
    });
    box.addEventListener('keydown', (e) => {
      if (items.length < 2) return;
      if (e.key === 'ArrowRight') show(index + 1);
      if (e.key === 'ArrowLeft') show(index - 1);
    });
    // A click on the dark area (not the photo, thumbnails or buttons) closes
    box.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      if (t === box || t.hasAttribute('data-lb-dismiss')) close();
    });

    // Swipe on the photo
    let startX: number | null = null;
    img.addEventListener('pointerdown', (e) => (startX = e.clientX));
    img.addEventListener('pointerup', (e) => {
      if (startX === null || items.length < 2) return;
      const dx = e.clientX - startX;
      startX = null;
      if (Math.abs(dx) > 50) show(index + (dx < 0 ? 1 : -1));
    });
  });
</script>
