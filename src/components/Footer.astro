---
import { footerNav, legalNav } from '@/data/site';
import Logo from './Logo.astro';

const year = new Date().getFullYear();
---

<!-- Measured from the homepage design: 310px tall at 1512, 80px top radius, navy → neon glow on the right -->
<!-- Scroll motion (script below): as the footer comes into view its contents rise into place, finishing exactly
     when the page reaches the bottom — the neon outline slides in from the right, the links one after another -->
<footer class="footer relative isolate overflow-hidden rounded-t-[2.5rem] text-white md:rounded-t-[5rem]" data-footer>
  <span class="footer-outline pointer-events-none absolute hidden lg:block" aria-hidden="true" data-footer-outline></span>

  <div class="relative px-[clamp(1rem,0.2rem+5vw,5.3rem)] pt-16 pb-10 lg:pt-[6.1rem] lg:pb-[2.4rem]" data-footer-inner>
    <div class="flex max-w-[66%] flex-col gap-10 lg:flex-row lg:items-center lg:justify-between">
      <a href="/" aria-label="Azure Contracting — home" class="self-start lg:self-auto">
        <Logo class="text-[2.25rem]" />
      </a>
      <nav aria-label="Footer">
        <ul class="text-p1 grid grid-cols-2 gap-x-10 gap-y-4 sm:flex sm:flex-wrap">
          {footerNav.map((link) => <li data-footer-item><a href={link.href} class="hover:text-neon transition-colors">{link.label}</a></li>)}
        </ul>
      </nav>
    </div>

    <div class="text-p3 mt-14 flex max-w-[66%] flex-col-reverse gap-4 text-white/85 lg:mt-[6.25rem] lg:flex-row lg:items-center lg:justify-between">
      <p class="text-[0.8125rem]">© {year} Azure Contracting Pvt. Ltd. All rights reserved.</p>
      <ul class="flex flex-wrap gap-x-6 gap-y-2 text-[0.8125rem]">
        {legalNav.map((link) => <li><a href={link.href} class="hover:text-neon transition-colors">{link.label}</a></li>)}
      </ul>
    </div>
  </div>
</footer>

<style>
  .footer {
    background:
      radial-gradient(38% 110% at 100% 70%, #dfe83d 0%, rgb(199 217 46 / 0.75) 22%, rgb(199 217 46 / 0) 70%),
      radial-gradient(40% 90% at 70% 100%, rgb(35 70 90 / 0.6), transparent 70%),
      linear-gradient(90deg, #061540 0%, #0b1d48 55%, #0e1f3d 100%);
  }
  /* Decorative neon outline panel on the right (x 1095 → off-canvas, y +18px, 277px tall at 1512) */
  .footer-outline {
    top: 1.125rem;
    left: 72.4%;
    width: 36rem;
    height: 17.3rem;
    border: 3px solid var(--color-neon);
    border-radius: 3.75rem;
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const footer = document.querySelector<HTMLElement>('[data-footer]');
  const inner = footer?.querySelector<HTMLElement>('[data-footer-inner]');
  if (footer && inner) {
    gsap.matchMedia().add('(prefers-reduced-motion: no-preference)', () => {
      const items = footer.querySelectorAll('[data-footer-item]');
      const outline = footer.querySelector('[data-footer-outline]');
      gsap
        .timeline({
          defaults: { ease: 'power2.out' },
          // From the footer's top entering the screen to the very bottom of the page
          scrollTrigger: { trigger: footer, start: 'top bottom', end: 'bottom bottom', scrub: 0.8 },
        })
        .fromTo(inner, { yPercent: 35, autoAlpha: 0.2 }, { yPercent: 0, autoAlpha: 1, duration: 1 }, 0)
        .fromTo(items, { y: 24, autoAlpha: 0 }, { y: 0, autoAlpha: 1, duration: 0.5, stagger: 0.07 }, 0.25)
        .fromTo(outline, { xPercent: 30, autoAlpha: 0 }, { xPercent: 0, autoAlpha: 1, duration: 1 }, 0);
    });
  }
</script>
