---
import { footerNav, legalNav, contact } from '@/data/site';
import Logo from './Logo.astro';
import Button from './Button.astro';

const year = new Date().getFullYear();
---

<footer class="bg-navy text-white">
  <div class="container-site grid gap-12 py-16 md:py-20 lg:grid-cols-[1fr_1.1fr] lg:gap-16">
    <div class="flex flex-col gap-10">
      <a href="/" aria-label="Azure Contracting — home" class="self-start"><Logo tone="light" /></a>

      <!-- TODO: footer intro copy from Figma -->
      <p class="text-p1 max-w-md text-white/70">
        Construction, refurbishment and fit-out for offices, hospitality, retail and education across Ireland.
      </p>

      <nav aria-label="Footer">
        <ul class="text-p1-medium grid grid-cols-2 gap-x-8 gap-y-4 sm:grid-cols-3">
          {
            footerNav.map((link) => (
              <li>
                <a href={link.href} class="hover:text-neon transition-colors">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <address class="text-p2 not-italic text-white/70">
        {contact.address.join(', ')}
        {contact.email && <a class="hover:text-neon mt-1 block" href={`mailto:${contact.email}`}>{contact.email}</a>}
        {contact.phone && <a class="hover:text-neon block" href={`tel:${contact.phone.replace(/\s/g, '')}`}>{contact.phone}</a>}
      </address>
    </div>

    <!-- Navy → neon gradient card. TODO: exact copy and layout from Figma -->
    <div class="footer-card rounded-card relative flex min-h-80 flex-col justify-between gap-10 overflow-hidden p-8 md:min-h-[26rem] md:p-12">
      <p class="text-h-caps relative max-w-[14ch]">Let's Build Something Great</p>
      <div class="relative flex flex-wrap items-center justify-between gap-6">
        <p class="text-p1 max-w-xs text-white/85">Tell us about your next fit-out or refurbishment project.</p>
        <Button href="/contact" variant="primary" track="cta_click" data-cta-location="footer">Contact Us</Button>
      </div>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="container-site text-p3 flex flex-col gap-4 py-6 text-white/60 md:flex-row md:items-center md:justify-between">
      <p>© {year} Azure Contracting. All rights reserved.</p>
      <ul class="flex flex-wrap gap-x-6 gap-y-2">
        {legalNav.map((link) => <li><a href={link.href} class="hover:text-white transition-colors">{link.label}</a></li>)}
      </ul>
    </div>
  </div>
</footer>

<style>
  .footer-card {
    background: var(--gradient-brand);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.08);
  }
</style>
