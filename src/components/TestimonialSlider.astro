---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import NavArrow from './NavArrow.astro';

// "Trusted By Builders" layout from the homepage design (1512px):
//   [heading + current photo 230w] [quote card 563w] [2×2: _, Next tile / Prev tile, next person's photo]
// All testimonials are rendered and stacked; the script switches the active one. Without JS the first shows.
interface Props {
  testimonials: CollectionEntry<'testimonials'>[];
  heading?: string;
  subheading?: string;
  class?: string;
}
const {
  testimonials,
  heading = 'Trusted By Builders',
  subheading = 'What our clients say after handover',
  class: className,
} = Astro.props;
const count = testimonials.length;
---

{
  count > 0 && (
    <section class:list={['section-y', className]} aria-labelledby="testimonials-heading" data-tslider data-count={count}>
      <div class="container-site">
        <div class="grid gap-3 lg:min-h-[30.875rem] lg:grid-cols-[1fr_2fr_2fr]">
          <!-- Column 1: heading + current photo -->
          <div class="flex min-w-0 flex-col justify-between gap-7">
            <div class="lg:px-[1.125rem] lg:pt-[1.875rem]">
              <h2 id="testimonials-heading" class="font-body text-navy text-[clamp(2rem,2.8vw,2.5rem)] leading-[1.08] font-normal tracking-[-0.01em]">{heading}</h2>
              <p class="text-stat-label mt-3.5 text-[0.9375rem]">{subheading}</p>
            </div>
            <div class="stack hidden aspect-[0.95] max-w-[17.5rem] lg:grid">
              {testimonials.map((t, i) => (
                <Image src={t.data.photo} alt="" width={560} class:list={['t-item size-full rounded-[1.375rem] object-cover', i === 0 && 'is-active']} data-i={i} />
              ))}
            </div>
          </div>

          <!-- Column 2: quote card -->
          <div class="stack grid min-w-0" aria-live="polite" data-swipe>
            {testimonials.map((t, i) => (
              <figure class:list={['t-item flex flex-col justify-between gap-10 rounded-3xl bg-white px-7 py-9 md:px-10 md:py-11', i === 0 && 'is-active']} data-i={i}>
                <div class="flex flex-col gap-[1.625rem]">
                  <span class="text-neon block h-[2.125rem] font-serif text-[4.25rem] leading-[0.5]" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="34" height="25" viewBox="0 0 34 25" fill="none">
<path d="M8.7043 0.00180817C10.0696 0.343143 11.3496 1.15381 12.5443 2.43381C9.89896 5.33514 8.5763 8.19381 8.5763 11.0098C8.5763 13.1431 9.0883 14.7218 10.1123 15.7458C11.2216 16.6845 12.6723 17.4098 14.4643 17.9218C14.4643 19.6285 13.7816 21.2498 12.4163 22.7858C11.1363 24.2365 9.42963 24.9618 7.2963 24.9618C5.2483 24.9618 3.49896 24.2791 2.0483 22.9138C0.682964 21.4631 0.00029707 19.1591 0.00029707 16.0018C0.00029707 10.4551 2.90163 5.12181 8.7043 0.00180817ZM27.9043 0.129807C29.2696 0.300476 30.5496 1.06848 31.7443 2.43381C29.099 5.50581 27.7763 8.36448 27.7763 11.0098C27.7763 13.1431 28.2883 14.7218 29.3123 15.7458C30.4216 16.6845 31.8723 17.4525 33.6643 18.0498C33.6643 19.7565 32.9816 21.3351 31.6163 22.7858C30.251 24.2365 28.5016 24.9618 26.3683 24.9618C24.4056 24.9618 22.699 24.2791 21.2483 22.9138C19.7976 21.4631 19.0723 19.2018 19.0723 16.1298C19.0723 10.4978 22.0163 5.16447 27.9043 0.129807Z" fill="#C7D92E"/>
</svg></span>
                  <blockquote class="text-[clamp(1.25rem,1.8vw,1.5rem)] font-medium leading-[1.4] text-pretty text-[#1e2537]">
                    <h3>{t.data.quote}</h3>
                  </blockquote>
                  <div class="text-star flex gap-1.5" role="img" aria-label={`Rated ${t.data.rating} out of 5`}>
                    {Array.from({ length: t.data.rating }, () => (
                      <svg width="28" height="28" viewBox="0 0 24 24" aria-hidden="true">
                        <path fill="currentColor" d="m12 2 3.1 6.3 6.9 1-5 4.9 1.2 6.8L12 17.8 5.8 21l1.2-6.8-5-4.9 6.9-1z" />
                      </svg>
                    ))}
                  </div>
                </div>
                <figcaption class="flex items-center gap-4">
                  <Image src={t.data.photo} alt="" width={96} class="size-12 rounded-full object-cover lg:hidden" />
                  <span>
                    <span class="text-navy block text-[1.0625rem] font-medium">{t.data.name}</span>
                    <span class="text-stat-label mt-1 block text-sm">{t.data.role ? `${t.data.role}, ${t.data.company}` : t.data.company}</span>
                  </span>
                </figcaption>
              </figure>
            ))}
          </div>

          <!-- Column 3 (desktop): Next tile top-right + Previous tile bottom-left, joined into one stepped navy
               shape with curved inner corners; the next person's photo sits in the pocket bottom-right.
               Below desktop: two tiles side by side. -->
          <div class="t-nav grid min-w-0 grid-cols-2 gap-3">
            <button type="button" class="t-tile t-tile-next flex-col items-start justify-between cursor-pointer" data-next aria-label="Next testimonial">
              <span class="text-left" aria-hidden="true">Next<br />Testimonial</span>
              <NavArrow class="self-end" />
            </button>
            <button type="button" class="t-tile t-tile-prev flex-col items-end justify-between max-lg:order-first cursor-pointer" data-prev aria-label="Previous testimonial">
              <NavArrow direction="left" class="self-start" />
              <span class="text-right" aria-hidden="true">Previous<br />Testimonial</span>
            </button>
            <span class="t-fillet t-fillet-a" aria-hidden="true"></span>
            <span class="t-fillet t-fillet-b" aria-hidden="true"></span>
            <div class="t-photo stack hidden lg:grid overflow-hidden rounded-[1.375rem]" aria-hidden="true">
              {testimonials.map((t, i) => (
                <Image
                  src={t.data.photo}
                  alt=""
                  width={460}
                  class:list={['t-next size-full rounded-[1.375rem] object-cover', i === 1 % count && 'is-active']}
                  data-i={i}
                />
              ))}
            </div>
          </div>
        </div>

        {/* {count > 1 && (
          <div class="mt-10 flex items-center justify-center gap-2.5" aria-hidden="true">
            {testimonials.map((_, i) => <span class:list={['t-dot', i === 0 && 'is-active']} data-i={i} />)}
          </div>
        )} */}

        <div class="mt-12 text-center">
          <a href="/testimonials" class="text-p1 text-navy underline underline-offset-4 hover:no-underline">View All</a>
        </div>
      </div>
    </section>
  )
}

<style>
  .stack > :global(*) {
    grid-area: 1 / 1;
  }
  .t-item,
  .t-next {
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.45s ease,
      visibility 0s linear 0.45s;
  }
  .t-item.is-active,
  .t-next.is-active {
    opacity: 1;
    visibility: visible;
    transition: opacity 0.45s ease;
  }
  .t-dot {
    width: 6px;
    height: 6px;
    border-radius: 3px;
    background: #c3cad8;
    transition:
      width 0.3s ease,
      background-color 0.3s ease;
  }
  .t-dot.is-active {
    width: 28px;
    background: var(--color-navy);
  }
  .t-tile {
    display: flex;
    min-height: 9rem;
    padding: 1.75rem 1.875rem;
    border-radius: 1.375rem;
    background: var(--color-navy);
    color: #aeb6cc;
    font-size: clamp(1.5rem, 2.2vw, 2rem);
    line-height: 1.2;
    transition:
      background-color 0.3s,
      color 0.3s;
  }
  /* Hover changes the text and arrow only — the background stays navy so the joined shape has no seams */
  .t-tile:hover,
  .t-tile:focus-visible {
    color: var(--color-white);
  }
  .t-tile :global(svg) {
    color: var(--color-white);
    transition: transform 0.3s ease;
  }
  .t-fillet {
    display: none;
  }

  /* Desktop: joined tiles. --o = how far each tile reaches past the centre (they overlap there),
     --r = radius of the curved inner corners, --g = gap between the shape and the photo. */
  @media (min-width: 75rem) {
    .t-nav {
      --o: 0.75rem;
      --r: 2.125rem;
      --g: 0.75rem;
      display: block;
      position: relative;
    }
    .t-nav > * {
      position: absolute;
    }
    .t-tile-next {
      left: calc(50% - var(--o));
      right: 0;
      top: 0;
      bottom: calc(50% - var(--o));
    }
    .t-tile-prev {
      left: 0;
      right: calc(50% - var(--o));
      top: calc(50% - var(--o));
      bottom: 0;
    }
    .t-photo {
      left: calc(50% + var(--o) + var(--g));
      right: 0;
      top: calc(50% + var(--o) + var(--g));
      bottom: 0;
    }
    /* Curved inner corners: navy squares with a quarter circle cut out */
    .t-fillet {
      display: block;
      width: var(--r);
      height: var(--r);
      pointer-events: none;
    }
    .t-fillet-a {
      left: calc(50% - var(--o) - var(--r));
      top: calc(50% - var(--o) - var(--r));
      background: radial-gradient(circle at 0 0, transparent calc(var(--r) - 0.5px), var(--color-navy) var(--r));
    }
    .t-fillet-b {
      left: calc(50% + var(--o));
      top: calc(50% + var(--o));
      background: radial-gradient(circle at 100% 100%, transparent calc(var(--r) - 0.5px), var(--color-navy) var(--r));
    }
  }
  .t-tile[data-next]:hover :global(svg) {
    transform: translateX(4px);
  }
  .t-tile[data-prev]:hover :global(svg) {
    transform: translateX(-4px);
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-tslider]').forEach((root) => {
    const count = Number(root.dataset.count);
    if (count < 2) {
      root.querySelectorAll<HTMLButtonElement>('[data-prev],[data-next]').forEach((b) => (b.disabled = true));
      return;
    }
    let active = 0;
    const show = (index: number) => {
      active = (index + count) % count;
      root.querySelectorAll<HTMLElement>('.t-item').forEach((el) => el.classList.toggle('is-active', Number(el.dataset.i) === active));
      root.querySelectorAll<HTMLElement>('.t-next').forEach((el) => el.classList.toggle('is-active', Number(el.dataset.i) === (active + 1) % count));
      root.querySelectorAll<HTMLElement>('.t-dot').forEach((el) => el.classList.toggle('is-active', Number(el.dataset.i) === active));
    };
    root.querySelector('[data-next]')?.addEventListener('click', () => show(active + 1));
    root.querySelector('[data-prev]')?.addEventListener('click', () => show(active - 1));

    // Swipe / drag on the quote card
    const swipe = root.querySelector<HTMLElement>('[data-swipe]');
    let startX: number | null = null;
    swipe?.addEventListener('pointerdown', (e) => (startX = e.clientX));
    swipe?.addEventListener('pointerup', (e) => {
      if (startX === null) return;
      const dx = e.clientX - startX;
      startX = null;
      if (Math.abs(dx) > 50) show(active + (dx < 0 ? 1 : -1));
    });
    swipe?.addEventListener('pointercancel', () => (startX = null));
  });
</script>
