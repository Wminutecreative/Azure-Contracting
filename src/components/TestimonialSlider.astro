---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import PlayIcon from './PlayIcon.astro';

// "Trusted By Builders" layout from the homepage design (1512px):
//   [heading + current photo 230w] [quote card 563w] [2×2: _, Next tile / Prev tile, next person's photo]
// All testimonials are rendered and stacked; the script switches the active one. Without JS the first shows.
interface Props {
  testimonials: CollectionEntry<'testimonials'>[];
  heading?: string;
  subheading?: string;
  class?: string;
}
const {
  testimonials,
  heading = 'Trusted By Builders',
  subheading = 'Trusted By Builders', // TODO: design repeats the heading here — confirm intended copy
  class: className,
} = Astro.props;
const count = testimonials.length;
---

{
  count > 0 && (
    <section class:list={['section-y', className]} aria-labelledby="testimonials-heading" data-tslider data-count={count}>
      <div class="container-site">
        <div class="grid gap-3 lg:h-[31rem] lg:grid-cols-[230fr_563fr_493fr]">
          <!-- Column 1: heading + current photo -->
          <div class="flex flex-col justify-between gap-6">
            <div class="lg:px-[1.1rem] lg:pt-7">
              <h2 id="testimonials-heading" class="text-h2 text-navy">{heading}</h2>
              <p class="text-p2 text-navy mt-2">{subheading}</p>
            </div>
            <div class="stack hidden aspect-[230/242] lg:grid">
              {testimonials.map((t, i) => (
                <Image src={t.data.photo} alt="" width={460} class:list={['t-item rounded-card size-full object-cover', i === 0 && 'is-active']} data-i={i} />
              ))}
            </div>
          </div>

          <!-- Column 2: quote card -->
          <div class="stack grid" aria-live="polite" data-swipe>
            {testimonials.map((t, i) => (
              <figure class:list={['t-item flex flex-col rounded-3xl bg-white p-8 md:p-10', i === 0 && 'is-active']} data-i={i}>
                <span class="text-neon font-heading -mb-4 text-7xl leading-none" aria-hidden="true">“</span>
                <blockquote class="text-h5 text-text-dark mt-6">
                  <p>{t.data.quote}</p>
                </blockquote>
                <div class="text-star mt-10 flex gap-1" role="img" aria-label={`Rated ${t.data.rating} out of 5`}>
                  {Array.from({ length: t.data.rating }, () => (
                    <svg width="30" height="30" viewBox="0 0 24 24" aria-hidden="true">
                      <path fill="currentColor" d="m12 2 3.1 6.3 6.9 1-5 4.9 1.2 6.8L12 17.8 5.8 21l1.2-6.8-5-4.9 6.9-1z" />
                    </svg>
                  ))}
                </div>
                <figcaption class="mt-auto flex items-center gap-4 pt-10">
                  <Image src={t.data.photo} alt="" width={96} class="size-12 rounded-full object-cover lg:hidden" />
                  <span>
                    <span class="text-p1 text-text-dark block">{t.data.name}</span>
                    <span class="text-p3 text-text-medium block">{t.data.role}, {t.data.company}</span>
                  </span>
                </figcaption>
              </figure>
            ))}
          </div>

          <!-- Column 3: prev / next tiles + next person's photo -->
          <div class="grid grid-cols-2 gap-3 lg:grid-rows-2">
            <span class="hidden lg:block" aria-hidden="true" />
            <button type="button" class="t-tile flex-col items-start justify-between" data-next aria-label="Next testimonial">
              <span class="text-h4 text-left" aria-hidden="true">Next<br />Testimonial</span>
              <PlayIcon size={26} class="self-end" />
            </button>
            <button type="button" class="t-tile flex-col items-end justify-between max-lg:order-first" data-prev aria-label="Previous testimonial">
              <PlayIcon size={26} direction="left" class="self-start" />
              <span class="text-h4 text-right" aria-hidden="true">Previous<br />Testimonial</span>
            </button>
            <div class="stack hidden lg:grid" aria-hidden="true">
              {testimonials.map((t, i) => (
                <Image
                  src={t.data.photo}
                  alt=""
                  width={460}
                  class:list={['t-next rounded-card size-full object-cover', i === 1 % count && 'is-active']}
                  data-i={i}
                />
              ))}
            </div>
          </div>
        </div>

        <div class="mt-12 text-center md:mt-20">
          <a href="/testimonials" class="text-p1 text-navy underline underline-offset-4 hover:no-underline">View All</a>
        </div>
      </div>
    </section>
  )
}

<style>
  .stack > :global(*) {
    grid-area: 1 / 1;
  }
  .t-item,
  .t-next {
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.45s ease,
      visibility 0s linear 0.45s;
  }
  .t-item.is-active,
  .t-next.is-active {
    opacity: 1;
    visibility: visible;
    transition: opacity 0.45s ease;
  }
  .t-tile {
    display: flex;
    min-height: 9rem;
    padding: 1.5rem 2rem;
    border-radius: 1.5rem;
    background: var(--color-navy);
    color: rgb(255 255 255 / 0.8);
    transition:
      background-color 0.3s,
      color 0.3s;
  }
  .t-tile:hover {
    background: #1a3260;
    color: var(--color-white);
  }
  .t-tile :global(svg) {
    color: var(--color-white);
    transition: transform 0.3s ease;
  }
  .t-tile[data-next]:hover :global(svg) {
    transform: translateX(4px);
  }
  .t-tile[data-prev]:hover :global(svg) {
    transform: translateX(-4px) rotate(180deg);
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-tslider]').forEach((root) => {
    const count = Number(root.dataset.count);
    if (count < 2) {
      root.querySelectorAll<HTMLButtonElement>('[data-prev],[data-next]').forEach((b) => (b.disabled = true));
      return;
    }
    let active = 0;
    const show = (index: number) => {
      active = (index + count) % count;
      root.querySelectorAll<HTMLElement>('.t-item').forEach((el) => el.classList.toggle('is-active', Number(el.dataset.i) === active));
      root.querySelectorAll<HTMLElement>('.t-next').forEach((el) => el.classList.toggle('is-active', Number(el.dataset.i) === (active + 1) % count));
    };
    root.querySelector('[data-next]')?.addEventListener('click', () => show(active + 1));
    root.querySelector('[data-prev]')?.addEventListener('click', () => show(active - 1));

    // Swipe / drag on the quote card
    const swipe = root.querySelector<HTMLElement>('[data-swipe]');
    let startX: number | null = null;
    swipe?.addEventListener('pointerdown', (e) => (startX = e.clientX));
    swipe?.addEventListener('pointerup', (e) => {
      if (startX === null) return;
      const dx = e.clientX - startX;
      startX = null;
      if (Math.abs(dx) > 50) show(active + (dx < 0 ? 1 : -1));
    });
    swipe?.addEventListener('pointercancel', () => (startX = null));
  });
</script>
