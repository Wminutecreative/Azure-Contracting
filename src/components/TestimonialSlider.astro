---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import NavArrow from './NavArrow.astro';

// "Trusted By Builders" layout from the homepage design (1512px):
//   [heading + current photo 230w] [quote card 563w] [2×2: _, Next tile / Prev tile, next person's photo]
// All testimonials are rendered and stacked; the script switches the active one. Without JS the first shows.
interface Props {
  testimonials: CollectionEntry<'testimonials'>[];
  heading?: string;
  subheading?: string;
  class?: string;
}
const {
  testimonials,
  heading = 'Trusted By Builders',
  subheading = 'Trusted by builders',
  class: className,
} = Astro.props;
const count = testimonials.length;
// Each person's picture: their photo, or else their company logo, which is shown whole on white instead of
// cropped to fill the frame (getTestimonials only passes in testimonials that have one or the other)
const pic = (t: CollectionEntry<'testimonials'>) => (t.data.photo ?? t.data.logo)!;
const fit = (t: CollectionEntry<'testimonials'>, pad: string) => (t.data.photo ? 'object-cover' : `object-contain bg-white ${pad}`);
---

{
  count > 0 && (
    <section class:list={['overflow-x-clip pb-[5rem]', className]} aria-labelledby="testimonials-heading" data-tslider data-count={count}>
      <div class="container-site">
        <div class="relative grid gap-3 lg:min-h-[30.875rem] lg:grid-cols-[1fr_2fr_2fr] overflow-clip" data-tgrid>
          <!-- Column 1: heading + current photo -->
          <div class="flex min-w-0 flex-col justify-between gap-7">
            <div class="lg:px-[1.125rem] lg:pt-[1.875rem]">
              <h2 id="testimonials-heading" class="font-body text-navy text-[clamp(2rem,2.8vw,2.5rem)] leading-[1.08] font-medium tracking-[-0.01em]">{heading}</h2>
              <p class="text-[#0E1F3D] mt-3.5 text-p2">{subheading}</p>
            </div>
            <div class="stack hidden aspect-[0.95] max-w-[17.5rem] lg:grid" data-main-photo>
              {testimonials.map((t, i) => (
                <Image src={pic(t)} alt="" width={560} class:list={['t-item size-full rounded-[1.375rem] !bg-transparent', fit(t, 'p-8'), i === 0 && 'is-active']} data-i={i} />
              ))}
            </div>
          </div>

          <!-- Column 2: quote card -->
          <div class="stack relative z-0 grid min-w-0 touch-pan-y select-none" aria-live="polite" data-swipe data-quotes>
            {testimonials.map((t, i) => (
              <figure class:list={['t-item flex flex-col justify-between gap-10 rounded-3xl bg-white px-7 py-9 md:px-10 md:py-11', i === 0 && 'is-active']} data-i={i}>
                <div class="flex flex-col gap-[1.625rem]">
                  <span class="text-neon block h-[2.125rem] font-serif text-[4.25rem] leading-[0.5]" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="34" height="25" viewBox="0 0 34 25" fill="none">
<path d="M8.7043 0.00180817C10.0696 0.343143 11.3496 1.15381 12.5443 2.43381C9.89896 5.33514 8.5763 8.19381 8.5763 11.0098C8.5763 13.1431 9.0883 14.7218 10.1123 15.7458C11.2216 16.6845 12.6723 17.4098 14.4643 17.9218C14.4643 19.6285 13.7816 21.2498 12.4163 22.7858C11.1363 24.2365 9.42963 24.9618 7.2963 24.9618C5.2483 24.9618 3.49896 24.2791 2.0483 22.9138C0.682964 21.4631 0.00029707 19.1591 0.00029707 16.0018C0.00029707 10.4551 2.90163 5.12181 8.7043 0.00180817ZM27.9043 0.129807C29.2696 0.300476 30.5496 1.06848 31.7443 2.43381C29.099 5.50581 27.7763 8.36448 27.7763 11.0098C27.7763 13.1431 28.2883 14.7218 29.3123 15.7458C30.4216 16.6845 31.8723 17.4525 33.6643 18.0498C33.6643 19.7565 32.9816 21.3351 31.6163 22.7858C30.251 24.2365 28.5016 24.9618 26.3683 24.9618C24.4056 24.9618 22.699 24.2791 21.2483 22.9138C19.7976 21.4631 19.0723 19.2018 19.0723 16.1298C19.0723 10.4978 22.0163 5.16447 27.9043 0.129807Z" fill="#C7D92E"/>
</svg></span>
                  <blockquote class="text-p1 font-normal leading-[1.4] text-pretty text-[#303030]">
                    <h3 class="font-normal">{t.data.quote}</h3>
                  </blockquote>
                  <div class="text-star flex gap-1.5" role="img" aria-label={`Rated ${t.data.rating} out of 5`}>
                    {Array.from({ length: t.data.rating }, () => (
                      <svg width="28" height="28" viewBox="0 0 24 24" aria-hidden="true">
                        <path fill="currentColor" d="m12 2 3.1 6.3 6.9 1-5 4.9 1.2 6.8L12 17.8 5.8 21l1.2-6.8-5-4.9 6.9-1z" />
                      </svg>
                    ))}
                  </div>
                </div>
                <figcaption class="flex items-center gap-4">
                  <Image src={pic(t)} alt="" width={96} class:list={['size-12 rounded-full lg:hidden', fit(t, 'p-1.5')]} />
                  <span>
                    <span class="text-navy block text-p1 font-medium">{t.data.name}</span>
                    <span class="text-stat-label block text-sm">{t.data.role ? `${t.data.role}, ${t.data.company}` : t.data.company}</span>
                  </span>
                </figcaption>
              </figure>
            ))}
          </div>

          <!-- Column 3 (desktop): Next tile top-right + Previous tile bottom-left, joined into one stepped navy
               shape with curved inner corners; the next person's photo sits in the pocket bottom-right.
               Below desktop: two tiles side by side. -->
          <div class="t-nav relative z-10 grid min-w-0 grid-cols-2 gap-3">
            <button type="button" class="t-tile t-tile-next flex-col items-start justify-between cursor-pointer" data-next aria-label="Next testimonial">
              <span class="text-left" aria-hidden="true">Next<br />Testimonial</span>
              <NavArrow class="self-end" />
            </button>
            <button type="button" class="t-tile t-tile-prev flex-col items-end justify-between max-lg:order-first cursor-pointer" data-prev aria-label="Previous testimonial">
              <NavArrow direction="left" class="self-start" />
              <span class="text-right" aria-hidden="true">Previous<br />Testimonial</span>
            </button>
            <span class="t-fillet t-fillet-a" aria-hidden="true"></span>
            <span class="t-fillet t-fillet-b" aria-hidden="true"></span>
            <div class="t-photo stack hidden lg:grid" aria-hidden="true" data-next-photo>
              {testimonials.map((t, i) => (
                <Image
                  src={pic(t)}
                  alt=""
                  width={460}
                  densities={[1, 2]}
                  class:list={['t-next size-full rounded-[1.375rem]', fit(t, 'p-8'), i === 1 % count && 'is-active']}
                  data-i={i}
                />
              ))}
            </div>
          </div>
        </div>

        {/* {count > 1 && (
          <div class="mt-10 flex items-center justify-center gap-2.5" aria-hidden="true">
            {testimonials.map((_, i) => <span class:list={['t-dot', i === 0 && 'is-active']} data-i={i} />)}
          </div>
        )} */}

        {/* <div class="mt-12 text-center">
          <a href="/testimonials" class="text-p1 text-navy underline underline-offset-4 hover:no-underline">View All</a>
        </div> */}
              <div class="mt-12 text-center md:mt-20 flex justify-center" data-fw-fade>
        <a href="/testimonials" class="link-underline text-p1 text-navy rounded-sm px-1 py-2" aria-label="View all testimonials">View All</a>
      </div>
      </div>
    </section>
  )
}

<style>
  .stack > :global(*) {
    grid-area: 1 / 1;
  }
  /* Only the active slide is shown; the script animates the move between slides (see below) */
  .t-item,
  .t-next {
    visibility: hidden;
  }
  .t-item.is-active,
  .t-next.is-active {
    visibility: visible;
  }
  /* Desktop track mode (set by the script): every person's photo + quote sit in one sliding row on a layer
     above the heading (outgoing cards pass over it) and below the Next/Previous tiles. The row's next photo
     fills the pocket, so the pocket's own images are hidden. */
  :global(.t-track) {
    position: absolute;
    inset: 0;
    z-index: 5;
    pointer-events: none;
  }
  :global(.t-track > .t-item.t-item) {
    position: absolute;
    visibility: visible;
    pointer-events: auto;
  }
  :global(.t-track > img.t-item) {
    z-index: 2;
  }
  :global(.is-track .t-photo .t-next.t-next) {
    visibility: hidden;
  }
  .t-dot {
    width: 6px;
    height: 6px;
    border-radius: 3px;
    background: #c3cad8;
    transition:
      width 0.3s ease,
      background-color 0.3s ease;
  }
  .t-dot.is-active {
    width: 28px;
    background: var(--color-navy);
  }
  .t-tile {
    display: flex;
    min-height: 9rem;
    padding: 1.75rem 1.875rem;
    border-radius: 1.375rem;
    background: var(--color-navy);
    color: #aeb6cc;
    font-size: clamp(1.5rem, 2.2vw, 2rem);
    line-height: 1.2;
    transition:
      background-color 0.3s,
      color 0.3s;
  }
  /* Hover changes the text and arrow only — the background stays navy so the joined shape has no seams */
  .t-tile:hover,
  .t-tile:focus-visible {
    color: var(--color-white);
  }
  .t-tile :global(svg) {
    color: var(--color-white);
    transition: transform 0.3s ease;
  }
  .t-fillet {
    display: none;
  }

  /* Desktop: joined tiles. --o = how far each tile reaches past the centre (they overlap there),
     --r = radius of the curved inner corners, --g = gap between the shape and the photo. */
  @media (min-width: 75rem) {
    .t-nav {
      --o: 0.75rem;
      --r: 2.125rem;
      --g: 0.75rem;
      display: block;
      position: relative;
    }
    .t-nav > * {
      position: absolute;
    }
    .t-tile-next {
      left: calc(50% - var(--o));
      right: 0;
      top: 0;
      bottom: calc(50% - var(--o));
    }
    .t-tile-prev {
      left: 0;
      right: calc(50% - var(--o));
      top: calc(50% - var(--o));
      bottom: 0;
    }
    .t-photo {
      left: calc(50% + var(--o) + var(--g));
      right: 0;
      top: calc(50% + var(--o) + var(--g));
      bottom: 0;
    }
    /* Curved inner corners: navy squares with a quarter circle cut out */
    .t-fillet {
      display: block;
      width: var(--r);
      height: var(--r);
      pointer-events: none;
    }
    .t-fillet-a {
      left: calc(50% - var(--o) - var(--r));
      top: calc(50% - var(--o) - var(--r));
      background: radial-gradient(circle at 0 0, transparent calc(var(--r) - 0.5px), var(--color-navy) var(--r));
    }
    .t-fillet-b {
      left: calc(50% + var(--o));
      top: calc(50% + var(--o));
      background: radial-gradient(circle at 100% 100%, transparent calc(var(--r) - 0.5px), var(--color-navy) var(--r));
    }
  }
  .t-tile[data-next]:hover :global(svg) {
    transform: translateX(4px);
  }
  .t-tile[data-prev]:hover :global(svg) {
    transform: translateX(-4px);
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-tslider]').forEach((root) => {
    const count = Number(root.dataset.count);
    if (count < 2) {
      root.querySelectorAll<HTMLButtonElement>('[data-prev],[data-next]').forEach((b) => (b.disabled = true));
      return;
    }
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const timing = { duration: 750, easing: 'cubic-bezier(0.65, 0, 0.35, 1)' };
    const gap = 12; // grid gap (gap-3)

    const items = (sel: string) => Array.from(root.querySelectorAll<HTMLElement>(`${sel} > [data-i]`));
    const mainPhotos = items('[data-main-photo]');
    const quotes = items('[data-quotes]');
    const nextPhotos = items('[data-next-photo]');
    const at = (list: HTMLElement[], i: number) => list.find((el) => Number(el.dataset.i) === i);
    const all = [...mainPhotos, ...quotes];

    const grid = root.querySelector<HTMLElement>('[data-tgrid]')!;
    const mainStack = root.querySelector<HTMLElement>('[data-main-photo]')!;
    const quoteStack = root.querySelector<HTMLElement>('[data-quotes]')!;
    const nextStack = root.querySelector<HTMLElement>('[data-next-photo]')!;
    const desktop = window.matchMedia('(min-width: 75rem)');
    let active = 0;

    // ── Desktop: one sliding row (like a carousel track) ───────────────────────────────────────────────
    // Each person = photo + quote card. Slot r = position relative to the current person:
    //   r = 0 → photo in the main photo spot, quote in the quote column
    //   r = 1 → photo in the bottom-right pocket (quote hidden under the Next/Previous tiles)
    //   r < 0 / r > 1 → the same spacing continued off to the left / right (peeking at the page edge)
    // Next shifts every person one slot left, Previous one slot right — photos and quotes move together.
    const layer = document.createElement('div');
    layer.className = 't-track';
    layer.setAttribute('aria-live', 'polite');
    let track = false;

    type Box = { left: number; top: number; width: number; height: number };
    const box = (el: HTMLElement): Box => {
      const g = grid.getBoundingClientRect();
      const r = el.getBoundingClientRect();
      return { left: r.left - g.left, top: r.top - g.top, width: r.width, height: r.height };
    };
    // The row needs at least 4 entries (left peek, current, pocket, right peek) so every move is a real slide.
    // With fewer testimonials the row repeats them (copies are hidden from screen readers unless current).
    let V = count; // entries in the row
    let vActive = 0; // current entry
    let vPhotos: HTMLElement[] = [];
    let vQuotes: HTMLElement[] = [];
    const clones: HTMLElement[] = [];
    // Relative slot of entry v, in -1 … V-2
    const slotOf = (v: number) => ((((v - vActive + 1) % V) + V) % V) - 1;
    const slots = () => {
      const P = box(mainStack);
      const Q = box(quoteStack);
      const N = box(nextStack);
      const D = N.left - P.left; // one step of the row
      const photo = (r: number): Box =>
        r <= 0 ? { ...P, left: P.left + r * D } : { ...N, left: N.left + (r - 1) * D };
      const quote = (r: number): Box => ({ ...Q, left: Q.left + r * D });
      return { photo, quote };
    };
    const css = (b: Box) => ({ left: `${b.left}px`, top: `${b.top}px`, width: `${b.width}px`, height: `${b.height}px` });

    // Place everyone in their slot; with `dir`, animate from the slot they came from (r + dir)
    const place = (dir = 0) => {
      const { photo, quote } = slots();
      const animate = dir !== 0 && !reduceMotion;
      for (let v = 0; v < V; v++) {
        const r = slotOf(v);
        const pairs: [HTMLElement, (r: number) => Box][] = [
          [vPhotos[v], photo],
          [vQuotes[v], quote],
        ];
        for (const [el, slot] of pairs) {
          el.getAnimations().forEach((a) => a.cancel());
          const to = slot(r);
          Object.assign(el.style, css(to));
          if (animate) el.animate([css(slot(r + dir)), css(to)], timing);
        }
        // Only the current quote is readable / focusable
        vQuotes[v].inert = r !== 0;
        vQuotes[v].toggleAttribute('aria-hidden', r !== 0);
      }
    };

    const enableTrack = () => {
      if (track) return;
      track = true;
      quoteStack.style.minHeight = `${quoteStack.offsetHeight}px`; // keep the column height once emptied
      all.forEach((el) => el.getAnimations().forEach((a) => a.cancel()));
      const byIndex = (list: HTMLElement[]) => [...list].sort((a, b) => Number(a.dataset.i) - Number(b.dataset.i));
      const reps = Math.max(1, Math.ceil(4 / count));
      V = count * reps;
      vPhotos = byIndex(mainPhotos);
      vQuotes = byIndex(quotes);
      for (let rep = 1; rep < reps; rep++) {
        for (let k = 0; k < count; k++) {
          const p = vPhotos[k].cloneNode(true) as HTMLElement;
          const q = vQuotes[k].cloneNode(true) as HTMLElement;
          clones.push(p, q);
          vPhotos.push(p);
          vQuotes.push(q);
        }
      }
      vActive = active;
      layer.append(...vPhotos, ...vQuotes);
      grid.append(layer);
      root.classList.add('is-track');
      place();
    };
    const disableTrack = () => {
      if (!track) return;
      track = false;
      clones.splice(0).forEach((el) => el.remove());
      mainStack.append(...mainPhotos);
      quoteStack.append(...quotes);
      [...mainPhotos, ...quotes].forEach((el) => {
        el.getAnimations().forEach((a) => a.cancel());
        el.removeAttribute('style');
        el.removeAttribute('aria-hidden');
        el.inert = false;
      });
      quoteStack.style.minHeight = '';
      layer.remove();
      root.classList.remove('is-track');
    };

    // ── Below desktop: only the quote card shows; it slides out / in ────────────────────────────────────
    const slideX = (el: HTMLElement, from: number, to: number) =>
      el.animate(
        [
          { transform: `translateX(${from}px)`, visibility: 'visible' },
          { transform: `translateX(${to}px)`, visibility: 'visible' },
        ],
        timing,
      );

    const show = (dir: number) => {
      const prev = active;
      if (track) vActive = (vActive + dir + V) % V;
      active = (active + dir + count) % count;
      const toggle = (list: HTMLElement[], i: number) => list.forEach((el) => el.classList.toggle('is-active', Number(el.dataset.i) === i));
      toggle(mainPhotos, active);
      toggle(quotes, active);
      toggle(nextPhotos, (active + 1) % count);

      if (track) return place(dir);
      if (reduceMotion) return;
      const d = (at(quotes, prev)?.offsetWidth ?? 0) + gap;
      const oldQuote = at(quotes, prev);
      const newQuote = at(quotes, active);
      oldQuote?.getAnimations().forEach((a) => a.finish());
      newQuote?.getAnimations().forEach((a) => a.finish());
      if (oldQuote) slideX(oldQuote, 0, -dir * d);
      if (newQuote) slideX(newQuote, dir * d, 0);
    };
    root.querySelector('[data-next]')?.addEventListener('click', () => show(1));
    root.querySelector('[data-prev]')?.addEventListener('click', () => show(-1));

    const sync = () => (desktop.matches ? enableTrack() : disableTrack());
    sync();
    desktop.addEventListener('change', sync);
    window.addEventListener('resize', () => track && place());
    document.fonts?.ready.then(() => {
      if (!track) return;
      // Fonts can change the quote height: re-measure the column, then re-place
      disableTrack();
      enableTrack();
    });

    // Swipe / drag on the quote card (desktop: anywhere on the slider row)
    const swipe = grid;
    let startX: number | null = null;
    swipe?.addEventListener('pointerdown', (e) => (startX = e.clientX));
    swipe?.addEventListener('pointerup', (e) => {
      if (startX === null) return;
      const dx = e.clientX - startX;
      startX = null;
      if (Math.abs(dx) > 50) show(dx < 0 ? 1 : -1);
    });
    swipe?.addEventListener('pointercancel', () => (startX = null));
  });
</script>
