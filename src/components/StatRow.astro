---
export interface Stat {
  value: string;
  label: string;
}
interface Props {
  stats: Stat[];
  class?: string;
}
const { stats, class: className } = Astro.props;
---

<!-- ~1040px wide, columns spaced apart, numbers Urbanist Light up to 104px navy, labels wrap to two lines -->
<dl class:list={['mx-auto flex max-w-[65.4rem] flex-col gap-10 sm:flex-row sm:justify-between sm:gap-6', className]}>
  {
    stats.map((stat, i) => (
      <div class="flex flex-col-reverse gap-5">
        <dt class="text-[#0E1F3D] opacity-[.68] text-p1 leading-normal max-w-[10rem]" data-line-reveal data-lr-delay={0.2 + i * 0.12}>
          {stat.label}
        </dt>
        <dd class="font-display text-navy text-[clamp(4rem,7vw,6.25rem)] leading-none font-medium tabular-nums" data-count-up data-cu-delay={i * 0.12}>
          {stat.value}
        </dd>
      </div>
    ))
  }
</dl>

<script>
  import '@/scripts/line-reveal';
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // Numbers count up from 0 when the row scrolls into view ("500+" → 0+ … 500+). The final value is in the
  // HTML, so no-JS visitors, crawlers and reduced-motion users simply see it.
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll<HTMLElement>('[data-count-up]').forEach((el) => {
      const match = el.textContent?.trim().match(/^(\D*)(\d+)(.*)$/);
      if (!match) return;
      const [, prefix, digits, suffix] = match;
      const target = Number(digits);
      const counter = { n: 0 };
      const render = () => (el.textContent = `${prefix}${Math.round(counter.n)}${suffix}`);

      el.setAttribute('aria-label', `${prefix}${target}${suffix}`);
      el.style.minWidth = `${el.offsetWidth}px`; // hold the final width so the row doesn't shift while counting
      render();
      gsap.set(el, { opacity: 0, y: 24 });

      ScrollTrigger.create({
        trigger: el,
        start: 'top 88%',
        once: true,
        onEnter: () => {
          const delay = Number(el.dataset.cuDelay) || 0;
          gsap.to(el, { opacity: 1, y: 0, duration: 0.8, ease: 'expo.out', delay });
          gsap.to(counter, { n: target, duration: 2, ease: 'power3.out', delay, onUpdate: render });
        },
      });
    });
  }
</script>
