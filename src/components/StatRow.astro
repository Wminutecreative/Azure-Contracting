---
export interface Stat {
  value: string;
  label: string;
}
interface Props {
  stats: Stat[];
  class?: string;
}
const { stats, class: className } = Astro.props;
---

<!-- ~1040px wide, columns spaced apart, numbers Urbanist Light up to 104px navy, labels wrap to two lines -->
<dl class:list={['mx-auto flex max-w-[65.4rem] flex-col gap-10 sm:flex-row sm:justify-between sm:gap-6', className]}>
  {
    stats.map((stat) => (
      <div class="flex flex-col-reverse gap-3.5" data-reveal>
        <dt class="text-stat-label max-w-[10rem] text-[0.9375rem] leading-normal">{stat.label}</dt>
        <dd class="font-display text-navy text-[clamp(4rem,7vw,6.5rem)] leading-none font-light">{stat.value}</dd>
      </div>
    ))
  }
</dl>
