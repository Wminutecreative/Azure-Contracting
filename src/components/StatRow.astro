---
export interface Stat {
  value: string;
  label: string;
}
interface Props {
  stats: Stat[];
  class?: string;
}
const { stats, class: className } = Astro.props;
---

<!-- ~1040px wide, columns spaced apart, numbers Urbanist Light up to 104px navy, labels wrap to two lines -->
<dl class:list={['mx-auto flex max-w-[65.4rem] flex-col gap-10 sm:flex-row sm:justify-between sm:gap-6', className]}>
  {
    stats.map((stat) => (
      <div class="flex flex-col-reverse gap-5" data-reveal>
        <dt class="text-[#0E1F3D] opacity-[.68] text-p1 leading-normal max-w-[10rem]">{stat.label}</dt>
        <dd class="font-display text-navy text-[clamp(4rem,7vw,6.25rem)] leading-none font-medium">{stat.value}</dd>
      </div>
    ))
  }
</dl>
