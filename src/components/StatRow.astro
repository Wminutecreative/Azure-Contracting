---
export interface Stat {
  value: string;
  label: string;
}
interface Props {
  stats: Stat[];
  class?: string;
}
const { stats, class: className } = Astro.props;
---

<!-- 1046px wide at 1512, columns spaced apart, numbers 80px navy, labels wrap to two lines -->
<dl class:list={['mx-auto flex max-w-[65.4rem] flex-col gap-10 sm:flex-row sm:justify-between sm:gap-6', className]}>
  {
    stats.map((stat) => (
      <div class="flex flex-col-reverse gap-2" data-reveal>
        <dt class="text-p1 text-stat-label max-w-[9.5rem]">{stat.label}</dt>
        <dd class="text-h-large text-navy">{stat.value}</dd>
      </div>
    ))
  }
</dl>
