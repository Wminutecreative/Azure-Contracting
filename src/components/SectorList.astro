---
import { sectors } from '@/data/sectors';
import PlayIcon from './PlayIcon.astro';

// Four stacked white link cards (22px radius, 18px gap) with an outlined arrow chip on the right;
// they lift on hover. From the Claude Design homepage.
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<ul class:list={['space-y-[1.125rem]', className]}>
  {
    sectors.map((sector) => (
      <li data-reveal>
        <a
          href="/projects"
          class="group flex items-center justify-between gap-6 rounded-[1.375rem] bg-white px-6 py-6 shadow-[0_1px_0_rgb(14_31_61/0.04)] transition-[transform,box-shadow] duration-300 hover:-translate-y-0.5 hover:shadow-[0_18px_40px_-20px_rgb(14_31_61/0.25)] md:px-9 md:py-7"
        >
          <div class="flex flex-col gap-2">
            <h3 class="font-body text-navy text-[clamp(1.5rem,2.4vw,2.125rem)] leading-tight font-normal tracking-[-0.01em]">{sector.label}</h3>
            <p class="text-stat-label text-[0.9375rem]">{sector.description}</p>
          </div>
          <span
            class="text-navy grid size-11 shrink-0 place-items-center rounded-xl border border-[#d6dbe6] transition-colors duration-300 group-hover:border-navy group-hover:bg-navy group-hover:text-white"
            aria-hidden="true"
          >
            <PlayIcon class="translate-x-px transition-transform duration-300 group-hover:translate-x-0.5" />
          </span>
        </a>
      </li>
    ))
  }
</ul>
