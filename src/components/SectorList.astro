---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { sectors, type SectorId } from '@/data/sectors';
import PlayIcon from './PlayIcon.astro';
import hospitality from '@/assets/sectors/hospitality.png'; // cropped 1× from the hover design — TODO: Figma export
// TODO: real sector photos from the client/Figma — project photos stand in for now.
import offices from '@/assets/projects/the-hari-clinic.png';
import retail from '@/assets/projects/osprey-hotel-spa.png';
import education from '@/assets/projects/morrison-hotel.png';

// Four stacked white link cards (22px radius, 18px gap) with an arrow chip on the right; they lift on hover.
// Hover (design): the card turns neon, the arrow becomes a large white play icon, and a photo of that sector
// floats above the list, following the cursor with a soft lag and a slight tilt.
interface Props {
  class?: string;
}
const { class: className } = Astro.props;

const images: Record<SectorId, ImageMetadata> = { offices, hospitality, retail, education };
---

<div class:list={['sector-list relative', className]} data-sector-list>
  <ul class="space-y-[1.125rem]">
    {
      sectors.map((sector, i) => (
        <li data-reveal>
          <a
            href="/projects"
            data-sector-index={i}
            class="sector-card group hover:bg-neon focus-visible:bg-neon flex items-center justify-between gap-6 rounded-[1.375rem] bg-white px-6 py-6 shadow-[0_1px_0_rgb(14_31_61/0.04)] transition-[background-color,transform,box-shadow] duration-300 hover:-translate-y-0.5 hover:shadow-[0_18px_40px_-20px_rgb(14_31_61/0.25)] md:px-9 md:py-7"
          >
            <div class="flex flex-col gap-2">
              <h3 class="font-body text-navy text-[clamp(1.5rem,2.4vw,2.125rem)] leading-tight font-normal tracking-[-0.01em]">{sector.label}</h3>
              <p class="text-stat-label group-hover:text-text-dark group-focus-visible:text-text-dark text-[0.9375rem] transition-colors duration-300">
                {sector.description}
              </p>
            </div>
            <span
              class="text-navy group-hover:text-white group-focus-visible:text-white grid size-11 shrink-0 place-items-center rounded-xl border border-[#d6dbe6] transition-[color,border-color] duration-300 group-hover:border-transparent group-focus-visible:border-transparent"
              aria-hidden="true"
            >
              <PlayIcon class="sector-arrow translate-x-px transition-transform duration-300" />
            </span>
          </a>
        </li>
      ))
    }
  </ul>

  <!-- Floating preview (pointer devices only). One image per sector, cross-faded. -->
  <div class="sector-preview" aria-hidden="true" data-sector-preview>
    {
      sectors.map((sector, i) => (
        <Image
          src={images[sector.id]}
          alt=""
          widths={[300, 600]}
          sizes="300px"
          loading="lazy"
          class="sector-preview-img"
          data-preview-index={i}
        />
      ))
    }
  </div>
</div>

<style>
  /* Arrow: outlined navy chip → large white play icon on the neon card */
  .sector-card:hover .sector-arrow,
  .sector-card:focus-visible .sector-arrow {
    transform: translateX(2px) scale(1.9);
  }

  .sector-preview {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 10;
    width: clamp(15rem, 22vw, 18.75rem);
    aspect-ratio: 3 / 2;
    border-radius: 0.875rem;
    overflow: hidden;
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
    box-shadow: 0 24px 50px -20px rgb(8 18 40 / 0.45);
    will-change: transform, opacity;
    transition:
      opacity 0.3s ease,
      visibility 0s linear 0.3s;
  }
  .sector-preview.is-visible {
    opacity: 1;
    visibility: visible;
    transition: opacity 0.3s ease;
  }
  .sector-preview-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transform: scale(1.12);
    transition:
      opacity 0.35s ease,
      transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .sector-preview-img.is-active {
    opacity: 1;
    transform: scale(1);
  }
  /* Touch screens have no hover: keep the list clean */
  @media not ((hover: hover) and (pointer: fine)) {
    .sector-preview {
      display: none;
    }
  }
</style>

<script>
  const canHover = window.matchMedia('(hover: hover) and (pointer: fine)');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  document.querySelectorAll<HTMLElement>('[data-sector-list]').forEach((list) => {
    const preview = list.querySelector<HTMLElement>('[data-sector-preview]');
    const imgs = Array.from(list.querySelectorAll<HTMLElement>('[data-preview-index]'));
    const cards = Array.from(list.querySelectorAll<HTMLElement>('[data-sector-index]'));
    if (!preview) return;

    // Current (lerped) and target position of the preview centre, relative to the list
    let x = 0;
    let y = 0;
    let tx = 0;
    let ty = 0;
    let scale = 0.85;
    let visible = false;
    let raf = 0;

    const setActive = (index: number) =>
      imgs.forEach((img) => img.classList.toggle('is-active', Number(img.dataset.previewIndex) === index));

    const render = () => {
      const snap = reduceMotion.matches;
      const k = snap ? 1 : 0.14;
      const dx = tx - x;
      x += dx * k;
      y += (ty - y) * k;
      scale += ((visible ? 1 : 0.85) - scale) * (snap ? 1 : 0.18);
      const tilt = snap ? 0 : Math.max(-8, Math.min(8, dx * 0.06)); // lean into the direction of travel
      const w = preview.offsetWidth;
      const h = preview.offsetHeight;
      preview.style.transform = `translate(${x - w / 2}px, ${y - h / 2}px) rotate(${tilt}deg) scale(${scale})`;
      const settled = Math.abs(tx - x) < 0.3 && Math.abs(ty - y) < 0.3 && Math.abs((visible ? 1 : 0.85) - scale) < 0.002;
      raf = settled ? 0 : requestAnimationFrame(render);
    };
    const kick = () => {
      if (!raf) raf = requestAnimationFrame(render);
    };

    const show = (index: number, px: number, py: number, jump: boolean) => {
      setActive(index);
      tx = px;
      ty = py;
      if (jump || !visible) {
        // Appear where the pointer is instead of flying in from the last position
        x = px;
        y = py;
      }
      visible = true;
      preview.classList.add('is-visible');
      kick();
    };
    const hide = () => {
      visible = false;
      preview.classList.remove('is-visible');
      kick();
    };

    const local = (e: PointerEvent) => {
      const r = list.getBoundingClientRect();
      return [e.clientX - r.left, e.clientY - r.top] as const;
    };

    cards.forEach((card) => {
      const index = Number(card.dataset.sectorIndex);
      card.addEventListener('pointerenter', (e) => {
        if (!canHover.matches || e.pointerType !== 'mouse') return;
        const [px, py] = local(e);
        show(index, px, py, false);
      });
      // Keyboard: park the preview over the right half of the focused card
      card.addEventListener('focus', () => {
        if (!canHover.matches || !card.matches(':focus-visible')) return;
        const lr = list.getBoundingClientRect();
        const cr = card.getBoundingClientRect();
        show(index, lr.width * 0.58, cr.top - lr.top + cr.height / 2, true);
      });
      card.addEventListener('blur', hide);
    });

    list.addEventListener('pointermove', (e) => {
      if (!visible || e.pointerType !== 'mouse') return;
      [tx, ty] = local(e);
      kick();
    });
    list.addEventListener('pointerleave', hide);
  });
</script>
