---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { sectors, type SectorId } from '@/data/sectors';
import PlayIcon from './PlayIcon.astro';
import hospitality from '@/assets/sectors/hospitality.png'; // cropped 1× from the hover design — TODO: Figma export
// TODO: real sector photos from the client/Figma — project photos stand in for now.
import offices from '@/assets/projects/the-hari-clinic.png';
import retail from '@/assets/projects/osprey-hotel-spa.png';
import education from '@/assets/projects/morrison-hotel.png';

// Four stacked white link cards (22px radius, 18px gap) with an arrow chip on the right.
// Hover (design): the card turns neon, the arrow becomes a large white play icon, and a photo of that sector
// fades in at a fixed spot over the card, overlapping the cards above and below. No movement.
interface Props {
  class?: string;
}
const { class: className } = Astro.props;

const images: Record<SectorId, ImageMetadata> = { offices, hospitality, retail, education };
---

<ul class:list={['space-y-[1.125rem]', className]}>
  {
    sectors.map((sector) => (
      <li class="relative hover:z-10 focus-within:z-10" data-reveal>
        <a
          href="/projects"
          class="sector-card group hover:bg-neon focus-visible:bg-neon relative flex items-center justify-between gap-6 rounded-[1.375rem] bg-white px-6 py-6 shadow-[0_1px_0_rgb(14_31_61/0.04)] transition-colors duration-300 md:px-9 md:py-7"
        >
          <div class="flex flex-col gap-2">
            <h3 class="font-body text-navy text-[clamp(1.5rem,2.4vw,2.125rem)] leading-tight font-normal tracking-[-0.01em]">{sector.label}</h3>
            <p class="text-stat-label group-hover:text-text-dark group-focus-visible:text-text-dark text-[0.9375rem] transition-colors duration-300">
              {sector.description}
            </p>
          </div>
          <span
            class="text-navy group-hover:text-white group-focus-visible:text-white grid size-11 shrink-0 place-items-center rounded-xl border border-[#d6dbe6] transition-[color,border-color] duration-300 group-hover:border-transparent group-focus-visible:border-transparent"
            aria-hidden="true"
          >
            <PlayIcon class="sector-arrow translate-x-px" />
          </span>

          <Image
            src={images[sector.id]}
            alt=""
            widths={[300, 600]}
            sizes="300px"
            loading="lazy"
            aria-hidden="true"
            class="sector-preview"
          />
        </a>
      </li>
    ))
  }
</ul>

<style>
  /* Arrow: outlined navy chip → large white play icon on the neon card */
  .sector-card:hover .sector-arrow,
  .sector-card:focus-visible .sector-arrow {
    transform: translateX(2px) scale(1.9);
  }

  /* Photo: fixed position over the card (centred at ~60% across), fades in — no movement */
  .sector-preview {
    position: absolute;
    top: 50%;
    left: 60%;
    width: clamp(15rem, 22vw, 18.75rem);
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: 0.875rem;
    box-shadow: 0 24px 50px -20px rgb(8 18 40 / 0.45);
    transform: translate(-50%, -50%);
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.3s ease,
      visibility 0s linear 0.3s;
  }
  .sector-card:hover .sector-preview,
  .sector-card:focus-visible .sector-preview {
    opacity: 1;
    visibility: visible;
    transition: opacity 0.3s ease;
  }
  /* Touch screens have no hover, and small screens have no room for the photo */
  @media not ((hover: hover) and (pointer: fine)), (max-width: 47.99rem) {
    .sector-preview {
      display: none;
    }
  }
</style>
