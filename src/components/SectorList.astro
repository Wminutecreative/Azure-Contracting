---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { sectors, type SectorId } from '@/data/sectors';
import PlayIcon from './PlayIcon.astro';
import hospitality from '@/assets/sectors/hospitality.png'; // cropped 1× from the hover design — TODO: Figma export
// TODO: real sector photos from the client/Figma — copies of project photos stand in for now.
import offices from '@/assets/sectors/offices.png';
import retail from '@/assets/sectors/retail.png';
import education from '@/assets/sectors/education.png';
// TODO: real Healthcare / Public Buildings sector photos — project photos stand in (Hermitage Clinic, Wexford Co. Council)
import healthcare from '@/assets/projects/hermitage-clinic/hermitage-4.jpg';
import publicBuildings from '@/assets/projects/wexford-county-council/project-hero-wexfordcc.jpg';

// Four stacked white link cards (22px radius, 18px gap) with an arrow chip on the right.
// Hover (design): the card turns neon, the arrow becomes a large white play icon, and a photo of that sector
// fades in at a fixed spot over the card, overlapping the cards above and below. No movement.
interface Props {
  class?: string;
}
const { class: className } = Astro.props;

// Every sector id needs a photo here (TypeScript flags a missing one)
const images: Record<SectorId, ImageMetadata> = {
  offices,
  hospitality,
  retail,
  education,
  healthcare,
  'public-buildings': publicBuildings,
};
---

<ul class:list={['space-y-[1.125rem]', className]}>
  {
    sectors.map((sector) => (
      <li class="relative hover:z-10 focus-within:z-10" data-reveal>
        <div
          class="sector-card group hover:bg-neon focus-visible:bg-neon relative flex items-center justify-between gap-6 rounded-[1.375rem] bg-white px-6 py-6 shadow-[0_1px_0_rgb(14_31_61/0.04)] transition-colors duration-300 md:px-9 md:py-7"
        >
          <div class="flex flex-col gap-2">
            <h3 class="font-body text-navy text-[clamp(1.5rem,2.4vw,2.125rem)] leading-tight font-normal tracking-[-0.01em]">{sector.label}</h3>
            <p class="text-stat-label group-hover:text-text-dark group-focus-visible:text-text-dark text-[0.9375rem] transition-colors duration-300">
              {sector.description}
            </p>
          </div>
          <span
            class="opacity-0 group-hover:opacity-100 text-white size-11 shrink-0 place-items-center rounded-xl transition-[color,border-color] duration-300 group-hover:border-transparent group-focus-visible:border-transparent"
            aria-hidden="true"
          >
            <PlayIcon class="sector-arrow translate-x-px" size={45} />
          </span>

          {/* Drawn up to 428px wide (22vw) — `sizes` must say so, or browsers pick a small file and it blurs */}
          <Image
            src={images[sector.id]}
            alt=""
            widths={[480, 720, 960, 1280]}
            sizes="(min-width: 1946px) 428px, (min-width: 1091px) 22vw, 240px"
            quality={85}
            loading="lazy"
            decoding="async"
            aria-hidden="true"
            class="sector-preview"
          />
        </div>
      </li>
    ))
  }
</ul>

<style>
  /* Arrow: outlined navy chip → large white play icon on the neon card */
  .sector-card:hover .sector-arrow,
  .sector-card:focus-visible .sector-arrow {
    transform: translateX(2px) scale(1.9);
  }

  /* The cards are 18px apart: stretch each card's hover area over half the gap above and below, so moving the
     mouse from one card to the next never passes through "no card hovered" (which made the photo flicker) */
  .sector-card::after {
    content: '';
    position: absolute;
    inset: -0.5625rem 0;
  }

  /* Photo: fixed position over the card (centred at ~60% across); fades in while growing slightly from 94%.
     Only opacity + transform animate (GPU, no layout), and it stays rendered (no visibility switching) so it
     never blinks; the layer is kept ready with will-change. */
  .sector-preview {
    position: absolute;
    top: 50%;
    left: 60%;
    z-index: 1;
    width: clamp(15rem, 22vw, 26.75rem);
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: 0.875rem;
    transform: translate(-50%, -50%) scale(0.94);
    pointer-events: none;
    opacity: 0;
    will-change: opacity, transform;
    backface-visibility: hidden;
    transition:
      opacity 0.35s ease,
      transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .sector-card:hover .sector-preview,
  .sector-card:focus-visible .sector-preview {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
    transition:
      opacity 0.45s ease,
      transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }
  @media (prefers-reduced-motion: reduce) {
    .sector-preview {
      transform: translate(-50%, -50%);
      transition: opacity 0.2s ease;
    }
    .sector-card:hover .sector-preview,
    .sector-card:focus-visible .sector-preview {
      transform: translate(-50%, -50%);
    }
  }
  /* Touch screens have no hover, and small screens have no room for the photo */
  @media not ((hover: hover) and (pointer: fine)), (max-width: 47.99rem) {
    .sector-preview {
      display: none;
    }
  }
</style>
