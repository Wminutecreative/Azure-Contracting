---
import type { HTMLAttributes } from 'astro/types';
import PlayIcon from './PlayIcon.astro';

type Variant = 'primary' | 'outline' | 'neon';

interface Props {
  variant?: Variant;
  /** Renders an <a> when set, otherwise a <button> */
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  /** dataLayer event name pushed on click (see BaseLayout tracking script) */
  track?: string;
  /** Hide the text label below the `sm` breakpoint (the icon stays); keeps an accessible name */
  compact?: boolean;
  class?: string;
  [key: string]: unknown;
}

const {
  variant = 'primary',
  href,
  type = 'button',
  track,
  compact = false,
  class: className,
  ...rest
} = Astro.props as Props & HTMLAttributes<'a'>;

const label = await Astro.slots.render('default');
const ariaLabel = compact ? label.replace(/<[^>]*>/g, '').trim() : undefined;

// From the design (194×61, radius 12): primary = navy with a white icon square;
// outline = compact "Know More" (1.5px navy border, 14px medium label, bare triangle), fills navy on hover.
const solid = 'text-p1 min-h-[3.8rem] min-w-[12.125rem] gap-6 pr-3.5 pl-4';
const styles: Record<Variant, { root: string; icon: string }> = {
  primary: {
    root: `${solid} bg-navy text-white hover:bg-[#1a3260]`,
    icon: 'size-8 bg-white text-navy',
  },
  // Hover (design): fills navy, label turns white and the arrow sits in a white rounded square.
  // The icon box is the same size in both states so nothing shifts.
  outline: {
    root: 'gap-10 border-[1.5px] border-navy py-2.5 pr-2.5 pl-4 text-sm font-medium text-navy hover:bg-navy hover:text-white focus-visible:bg-navy focus-visible:text-white',
    icon: 'size-7 text-navy group-hover:bg-white group-focus-visible:bg-white',
  },
  neon: {
    root: `${solid} bg-neon text-navy hover:bg-white`,
    icon: 'size-8 bg-navy text-neon',
  },
};
const s = styles[variant];
const Tag = href ? 'a' : 'button';
---

<Tag
  href={href}
  type={href ? undefined : type}
  data-track={track}
  aria-label={ariaLabel}
  class:list={[
    'group rounded-btn inline-flex items-center justify-between transition-colors duration-300',
    s.root,
    compact && 'max-sm:min-h-12 max-sm:min-w-0 max-sm:gap-0 max-sm:p-2',
    className,
  ]}
  {...rest}
>
  <span class:list={[compact && 'max-sm:sr-only']} set:html={label} />
  <span
    class:list={[
      'flex items-center justify-center shrink-0 place-items-center rounded-md transition-colors duration-300',
      s.icon,
    ]}
  >
    <PlayIcon class="translate-x-px transition-transform duration-300 group-hover:translate-x-0.5" />
  </span>
</Tag>
