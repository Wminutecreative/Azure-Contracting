---
import type { HTMLAttributes } from 'astro/types';
import ArrowIcon from './ArrowIcon.astro';

type Variant = 'primary' | 'outline' | 'neon';

interface Props {
  variant?: Variant;
  /** Renders an <a> when set, otherwise a <button> */
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  /** dataLayer event name pushed on click (see BaseLayout tracking script) */
  track?: string;
  /** Hide the text label below the `sm` breakpoint (the arrow square stays); keeps an accessible name */
  compact?: boolean;
  class?: string;
  [key: string]: unknown;
}

const {
  variant = 'primary',
  href,
  type = 'button',
  track,
  compact = false,
  class: className,
  ...rest
} = Astro.props as Props & HTMLAttributes<'a'>;

const label = await Astro.slots.render('default');
const ariaLabel = compact ? label.replace(/<[^>]*>/g, '').trim() : undefined;

// primary: navy button, neon arrow square · outline: "Know More" · neon: for use on navy backgrounds
const styles: Record<Variant, { root: string; icon: string }> = {
  primary: {
    root: 'bg-navy text-white hover:bg-[#162c52] pl-5 pr-1.5 py-1.5',
    icon: 'bg-neon text-navy',
  },
  outline: {
    root: 'border border-navy text-navy hover:bg-navy hover:text-white pl-5 pr-1.5 py-1.5',
    icon: 'bg-navy text-neon group-hover:bg-neon group-hover:text-navy',
  },
  neon: {
    root: 'bg-neon text-navy hover:bg-white pl-5 pr-1.5 py-1.5',
    icon: 'bg-navy text-neon',
  },
};
const s = styles[variant];
const Tag = href ? 'a' : 'button';
---

<Tag
  href={href}
  type={href ? undefined : type}
  data-track={track}
  aria-label={ariaLabel}
  class:list={[
    'group rounded-btn text-p1-medium inline-flex min-h-12 items-center gap-4 transition-colors duration-300',
    s.root,
    compact && 'max-sm:gap-0 max-sm:p-1.5',
    className,
  ]}
  {...rest}
>
  <span class:list={[compact && 'max-sm:sr-only']} set:html={label} />
  <span
    class:list={[
      'inline-grid size-9 shrink-0 place-items-center overflow-hidden rounded-[calc(var(--radius-btn)-0.25rem)] transition-colors duration-300',
      s.icon,
    ]}
  >
    <ArrowIcon class="transition-transform duration-300 group-hover:translate-x-0.5" />
  </span>
</Tag>
