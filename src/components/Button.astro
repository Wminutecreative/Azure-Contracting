---
import type { HTMLAttributes } from 'astro/types';
import PlayIcon from './PlayIcon.astro';

type Variant = 'primary' | 'outline' | 'neon';

interface Props {
  variant?: Variant;
  /** Renders an <a> when set, otherwise a <button> */
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  /** dataLayer event name pushed on click (see BaseLayout tracking script) */
  track?: string;
  /** Hide the text label below the `sm` breakpoint (the icon stays); keeps an accessible name */
  compact?: boolean;
  class?: string;
  [key: string]: unknown;
}

const {
  variant = 'primary',
  href,
  type = 'button',
  track,
  compact = false,
  class: className,
  ...rest
} = Astro.props as Props & HTMLAttributes<'a'>;

const label = await Astro.slots.render('default');
const ariaLabel = compact ? label.replace(/<[^>]*>/g, '').trim() : undefined;

// From the design (194×61, radius 12): primary = navy with a white icon square;
// outline = navy hairline + bare triangle, fills navy on hover.
const styles: Record<Variant, { root: string; icon: string }> = {
  primary: {
    root: 'bg-navy text-white hover:bg-[#1a3260]',
    icon: 'bg-white text-navy',
  },
  outline: {
    root: 'border border-navy text-navy hover:bg-navy hover:text-white',
    icon: 'text-navy group-hover:bg-white',
  },
  neon: {
    root: 'bg-neon text-navy hover:bg-white',
    icon: 'bg-navy text-neon',
  },
};
const s = styles[variant];
const Tag = href ? 'a' : 'button';
---

<Tag
  href={href}
  type={href ? undefined : type}
  data-track={track}
  aria-label={ariaLabel}
  class:list={[
    'group rounded-btn text-p1 inline-flex min-h-[3.8rem] min-w-[12.125rem] items-center justify-between gap-6 pr-3.5 pl-4 transition-colors duration-300',
    s.root,
    compact && 'max-sm:min-h-12 max-sm:min-w-0 max-sm:gap-0 max-sm:p-2',
    className,
  ]}
  {...rest}
>
  <span class:list={[compact && 'max-sm:sr-only']} set:html={label} />
  <span
    class:list={[
      'inline-grid size-8 shrink-0 place-items-center rounded-md transition-colors duration-300',
      s.icon,
    ]}
  >
    <PlayIcon class="translate-x-px transition-transform duration-300 group-hover:translate-x-0.5" />
  </span>
</Tag>
