---
import type { HTMLAttributes } from 'astro/types';
import PlayIcon from './PlayIcon.astro';
import NavArrow from './NavArrow.astro';

type Variant = 'primary' | 'outline' | 'neon';

interface Props {
  variant?: Variant;
  /** Renders an <a> when set, otherwise a <button> */
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  /** dataLayer event name pushed on click (see BaseLayout tracking script) */
  track?: string;
  /** Hide the text label below the `sm` breakpoint (the icon stays); keeps an accessible name */
  compact?: boolean;
  /** Show the arrow icon (default). `icon={false}` = plain text button, label centred */
  icon?: boolean;
  class?: string;
  [key: string]: unknown;
}

const {
  variant = 'primary',
  href,
  type = 'button',
  track,
  compact = false,
  icon = true,
  class: className,
  ...rest
} = Astro.props as Props & HTMLAttributes<'a'>;

const label = await Astro.slots.render('default');
const ariaLabel = compact ? label.replace(/<[^>]*>/g, '').trim() : undefined;

// From the design (radius 12). primary and outline share the "Know More" layout: an icon square on the LEFT that
// widens to fill the whole button on hover / focus (.btn-fill). primary = navy button, white square + navy play
// icon, white label (turns navy as the white fills in); outline = the same in reverse (white button, navy square).
const solid = 'text-p1 min-h-[3.8rem] min-w-[12.125rem] gap-5 pr-3.5 pl-4';
// Phones: a smaller button (44px tall, 44px icon square, 16px label); from `sm` up the design size (52px, 18px).
// --btn-sq is the icon square's size — shared with the .btn-fill::before square so the two always line up.
const fill =
  'btn-fill relative isolate overflow-hidden flex-row-reverse justify-end! [--btn-sq:2.75rem] sm:[--btn-sq:3.25rem] gap-3.5 sm:gap-5 min-h-(--btn-sq) border-[1.5px] border-navy pl-0! pr-5 sm:pr-7 text-p2 sm:text-p1 font-medium';
const styles: Record<Variant, { root: string; icon: string }> = {
  primary: {
    root: `${fill} [--btn-fill:var(--color-white)] bg-navy text-white hover:text-navy focus-visible:text-navy`,
    icon: 'w-(--btn-sq) self-stretch text-navy',
  },
  // "Know More" (design): white pill, navy border, navy square with a white arrow on the LEFT, navy label.
  // Hover / focus: the navy square widens to fill the whole button and the label turns white (.btn-fill).
  outline: {
    root: `${fill} bg-white text-navy hover:text-white focus-visible:text-white`,
    icon: 'w-(--btn-sq) self-stretch text-white',
  },
  neon: {
    root: `${solid} bg-neon text-navy hover:bg-white`,
    icon: 'size-8 bg-navy text-neon',
  },
};
const s = styles[variant];
const Tag = href ? 'a' : 'button';
---

<Tag
  href={href}
  type={href ? undefined : type}
  data-track={track}
  aria-label={ariaLabel}
  class:list={[
    'group rounded-btn inline-flex items-center font-medium justify-between transition-colors duration-300',
    s.root,
    // Compact: icon only on phones (the label is visually hidden), so no right padding there
    compact && 'py-3.5 max-sm:min-w-0 max-sm:gap-0 max-sm:p-2 max-sm:pr-0!',
    !icon && 'justify-center! px-8!',
    className,
  ]}
  {...rest}
>
  <span class:list={[compact && icon && 'max-sm:sr-only']} set:html={label} />
  {
    icon && (
      <span
        class:list={[
          'flex items-center justify-center shrink-0 place-items-center rounded-md transition-colors duration-300',
          s.icon,
        ]}
      >
        {variant === 'outline' ? (
          <NavArrow size={22} class="transition-transform duration-300 group-hover:translate-x-0.5" />
        ) : (
          <NavArrow size={22} class="transition-transform duration-300 group-hover:translate-x-0.5" />
          // <PlayIcon class="translate-x-px transition-transform duration-300 group-hover:translate-x-0.5" />
        )}
      </span>
    )
  }
</Tag>

<style is:global>
  /* Primary / outline: the square behind the icon grows to fill the button on hover / focus
     (white on the navy primary, navy on the white outline) */
  .btn-fill::before {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    z-index: -1;
    width: var(--btn-sq, 3.25rem);
    border-radius: 10px;
    background: var(--btn-fill, var(--color-navy));
    transition: width 0.45s cubic-bezier(0.65, 0, 0.35, 1);
  }
  .btn-fill:hover::before,
  .btn-fill:focus-visible::before {
    width: 100%;
  }
  @media (prefers-reduced-motion: reduce) {
    .btn-fill::before {
      transition: none;
    }
  }
</style>
