---
// Homepage — Figma 534:1874 (prototype 535:6374), refined to the Claude Design file "Azure Homepage.dc.html"
// (project a32b8eda-13cb-4240-b22f-95df156ab543). See docs/figma-notes.md for measurements.
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Logo from '@/components/Logo.astro';
import StatRow from '@/components/StatRow.astro';
import SectorList from '@/components/SectorList.astro';
import BigOutlineHeading from '@/components/BigOutlineHeading.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import ValueCards from '@/components/ValueCards.astro';
import TestimonialSlider from '@/components/TestimonialSlider.astro';
import FaqAccordion from '@/components/FaqAccordion.astro';
import LogoStrip from '@/components/LogoStrip.astro';
import { getProjects, getTestimonials, getFaqs } from '@/lib/content';
// TODO: swap for assets/hero-clean.png from the Claude Design project (save as src/assets/home/hero.png)
import heroImage from '@/assets/placeholders/hero.svg';

const featured = (await getProjects({ featured: true })).slice(0, 3);
const testimonials = await getTestimonials({ featured: true });
const faqs = await getFaqs('home');

const stats = [
  { value: '20+', label: 'Years of experience' },
  { value: '500+', label: 'Projects delivered successfully' },
  { value: '98%', label: 'Overall client satisfaction rate' },
];
---

<BaseLayout
  title="Azure Contracting"
  description="Construction, refurbishment and fit-out for offices, hospitality, retail and education. Based in Kildare, working across Ireland."
  headerOverlay
  headerLogo={false}
>
  <!-- 1. Hero — 56vw tall (560–880px), photo anchored to the bottom, darkened behind the logo -->
  <section class="relative isolate grid h-[clamp(35rem,56vw,55rem)] place-items-center overflow-hidden bg-[#1b2a36]">
    <Image
      src={heroImage}
      alt=""
      widths={[768, 1280, 1920, 2560]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="absolute inset-0 -z-20 h-full w-full object-cover object-bottom"
    />
    <div class="hero-shade absolute inset-0 -z-10" aria-hidden="true"></div>
    <h1 class="px-4">
      <span class="sr-only">Azure Contracting — fit-out specialists in construction, refurbishment and fit-out, Kildare, Ireland</span>
      <span aria-hidden="true"><Logo class="text-[clamp(4.5rem,8.2vw,7.75rem)]" /></span>
    </h1>
  </section>

  <!-- 2. Intro statement + stats -->
  <section class="pt-[clamp(4.5rem,8vw,8.125rem)]">
    <div class="container-site">
      <p
        class="mx-auto max-w-[76rem] text-center text-[clamp(1.25rem,2.6vw,2.5rem)] leading-[1.45] font-light text-balance text-[#1a2b4f] uppercase"
        data-reveal
      >
        Azure Contracting brings <strong class="font-medium">hands-on</strong> site experience to
        <strong class="font-medium">construction, refurbishment and fit-out</strong> work in
        <strong class="font-medium">offices, hospitality, retail and education.</strong>
      </p>
      <StatRow stats={stats} class="mt-[clamp(3rem,6vw,5.625rem)]" />
    </div>
  </section>

  <!-- 3. Sectors -->
  <section class="pt-[clamp(4rem,2rem+8vw,12.5rem)]" aria-labelledby="sectors-heading">
    <div class="container-site">
      <h2 id="sectors-heading" class="sr-only">Sectors we work in</h2>
      <SectorList />
    </div>
  </section>

  <!-- 4. Featured work -->
  <section class="pt-[clamp(4rem,2rem+7vw,11rem)]">
    <BigOutlineHeading text="Our Featured Work">
      <div class="container-site space-y-4">
        {featured.map((project, i) => <ProjectCard project={project} reverse={i % 2 === 1} eager={i === 0} />)}
      </div>
    </BigOutlineHeading>
    <div class="mt-12 text-center md:mt-24">
      <a href="/projects" class="text-p1 text-navy underline underline-offset-4 hover:no-underline">View All</a>
    </div>
  </section>

  <!-- 5. Values -->
  <section class="pt-[clamp(4rem,2rem+6vw,10.5rem)]" aria-labelledby="values-heading">
    <div class="container-site">
      <h2 id="values-heading" class="sr-only">How we work</h2>
      <ValueCards />
    </div>
  </section>

  <!-- 6. Testimonials -->
  <TestimonialSlider testimonials={testimonials} class="pt-[clamp(4rem,2rem+8vw,15.5rem)]!" />

  <!-- 7. FAQ -->
  <FaqAccordion items={faqs} class="pb-0!" />

  <!-- 8. Client logos (footer follows from BaseLayout) -->
  <LogoStrip />
</BaseLayout>

<style>
  .hero-shade {
    background:
      radial-gradient(ellipse 40% 28% at 50% 50%, rgb(8 18 40 / 0.45), transparent),
      linear-gradient(180deg, rgb(8 18 40 / 0.35) 0%, rgb(8 18 40 / 0.15) 40%, rgb(8 18 40 / 0.35) 100%);
  }
</style>
