---
// Homepage — Figma 534:1874 (prototype 535:6374), refined to the Claude Design file "Azure Homepage.dc.html"
// (project a32b8eda-13cb-4240-b22f-95df156ab543). See docs/figma-notes.md for measurements.
import BaseLayout from '@/layouts/BaseLayout.astro';
import Logo from '@/components/Logo.astro';
import StatRow from '@/components/StatRow.astro';
import SectorList from '@/components/SectorList.astro';
import FeaturedWork from '@/components/FeaturedWork.astro';
import ValueCards from '@/components/ValueCards.astro';
import TestimonialSlider from '@/components/TestimonialSlider.astro';
import FaqAccordion from '@/components/FaqAccordion.astro';
import LogoStrip from '@/components/LogoStrip.astro';
import { getProjects, getTestimonials, getFaqs } from '@/lib/content';
// Hero background video (served as a hashed file from the build). TODO: compress — see note in the hero below.
import heroVideo from '@/assets/placeholders/Header Video.mp4?url';

const featured = (await getProjects({ featured: true })).slice(0, 3);
const testimonials = await getTestimonials({ featured: true });
const faqs = await getFaqs('home');

const stats = [
  { value: '20+', label: 'Years of experience' },
  { value: '500+', label: 'Projects delivered successfully' },
  { value: '98%', label: 'Overall client satisfaction rate' },
];
---

<BaseLayout
  title="Azure Contracting | Fit-Out & Refurbishment Ireland"
  description="Azure Contracting delivers construction, refurbishment and fit-out for offices, hospitality, retail and education across Ireland. Based in Kildare."
  headerDock
>
  <!-- 1. Hero — full viewport, photo anchored to the bottom, darkened behind the logo.
       With JS + motion, the visible logo is the header's docking logo (see Header.astro); this one is the
       no-JS / reduced-motion fallback and must keep the same size class. -->
  <section class="relative isolate grid h-[100svh] place-items-center overflow-hidden bg-[#1b2a36]" data-hero>
    <!-- Background video: autoplay + muted + loop + playsinline (all four are needed for autoplay on phones).
         Decorative, so hidden from screen readers; paused for visitors who prefer reduced motion. -->
    <video
      class="absolute inset-0 -z-20 h-full w-full object-cover object-bottom"
      src={heroVideo}
      autoplay
      muted
      loop
      playsinline
      preload="auto"
      disablepictureinpicture
      aria-hidden="true"
      data-hero-video
    ></video>
    <div class="hero-shade absolute inset-0 -z-10" aria-hidden="true"></div>
    <h1 class="px-4">
      <span class="sr-only">Azure Contracting — fit-out specialists in construction, refurbishment and fit-out, Kildare, Ireland</span>
      <span aria-hidden="true" class="hero-logo"><Logo class="text-[clamp(4.5rem,8.2vw,7.75rem)]" /></span>
    </h1>
  </section>

  <!-- 2. Intro statement + stats -->
  <section class="py-[clamp(4.5rem,8vw,7.5rem)]">
    <div class="container-site">
      <h2
        class="mx-auto max-w-[75rem] text-center text-[clamp(1.25rem,2.6vw,2.5rem)] leading-[1.45] font-medium  text-[#585858] uppercase"
        data-line-reveal
      >
        Azure Contracting brings <strong class="font-medium text-[#0E1F3D]">hands-on</strong> site experience to
        <strong class="font-medium text-[#0E1F3D]">construction, refurbishment and fit-out</strong> work in
        <strong class="font-medium text-[#0E1F3D]">offices, hospitality, retail and education.</strong>
    </h2>
      <StatRow stats={stats} class="mt-[clamp(3rem,6vw,7.5rem)]" />
    </div>
  </section>  

  <!-- 3. Sectors -->
  <section class="py-[clamp(3rem,6vw,5rem)]" aria-labelledby="sectors-heading">
    <div class="container-site">
      <h2 id="sectors-heading" class="sr-only">Sectors we work in</h2>
      <SectorList />
    </div>
  </section>

  <!-- 4. Featured work -->
  <FeaturedWork projects={featured} viewAllHref="/projects" class="py-[clamp(3rem,6vw,5rem)]" />

  <!-- 5. Values -->
  <section class="py-[clamp(3rem,6vw,5rem)]" aria-labelledby="values-heading">
    <div class="container-site">
      <h2 id="values-heading" class="sr-only">How we work</h2>
      <ValueCards />
    </div>
  </section>

  <!-- 6. Testimonials -->
  <TestimonialSlider testimonials={testimonials} class="pt-[clamp(4rem,2rem+8vw,10rem)]!" />

  <!-- 7. FAQ -->
  <FaqAccordion items={faqs} class="pb-0!" />

  <!-- 8. Client logos (footer follows from BaseLayout) -->
  <LogoStrip />
</BaseLayout>

<style>
  /* The header's docking logo takes over when scroll animation is on */
  :global(.motion) .hero-logo {
    visibility: hidden;
  }
  .hero-shade {
    background:
      radial-gradient(ellipse 40% 28% at 50% 50%, rgb(8 18 40 / 0.45), transparent),
      linear-gradient(180deg, rgb(8 18 40 / 0.35) 0%, rgb(8 18 40 / 0.15) 40%, rgb(8 18 40 / 0.35) 100%);
  }
</style>

<script>
  // Reduced motion: no moving background — stop the hero video on its first frame
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll<HTMLVideoElement>('[data-hero-video]').forEach((v) => {
      v.removeAttribute('autoplay');
      v.pause();
    });
  }
</script>
