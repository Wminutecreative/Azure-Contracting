---
// Blog listing — Figma 534:1543 (prototype 535:6043).
// "Our Featured Blogs" (static title) · 2-column blog cards, newest first, 12 per page (/blog, /blog/2, …) ·
// client logos → footer. Posts are managed in Keystatic (/keystatic → Blog).
import type { GetStaticPaths, Page } from 'astro';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import BigOutlineHeading from '@/components/BigOutlineHeading.astro';
import BlogCard from '@/components/BlogCard.astro';
import LogoStrip from '@/components/LogoStrip.astro';
import { getPosts } from '@/lib/content';

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getPosts();
  return paginate(posts, { pageSize: 12 });
}) satisfies GetStaticPaths;

interface Props {
  page: Page<CollectionEntry<'blog'>>;
}
const { page } = Astro.props;
const title = page.currentPage === 1 ? 'Blog' : `Blog — page ${page.currentPage}`;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).toString() },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: new URL('/blog', Astro.site).toString() },
    ],
  },
];
---

<BaseLayout
  title={title}
  description="Insights on fit-out, refurbishment and construction from the Azure Contracting team — interior trends, sustainability, climate risk and lessons from live projects."
  schema={schema}
>
  <section class="pt-[clamp(1.5rem,1rem+2vw,3rem)]">
    <BigOutlineHeading text="Our Featured Blogs" as="h1">
      <div class="container-site">
        <div class="mx-auto grid max-w-[70rem] gap-4 md:grid-cols-2 md:gap-6">
          {page.data.map((post, i) => <BlogCard post={post} eager={i < 2} />)}
        </div>

        {
          page.lastPage > 1 && (
            <nav class="mt-12 flex items-center justify-center gap-6 text-sm" aria-label="Blog pages">
              {page.url.prev ? (
                <a href={page.url.prev} class="text-navy underline underline-offset-4 hover:no-underline">
                  ← Newer posts
                </a>
              ) : (
                <span />
              )}
              <span class="text-stat-label">
                Page {page.currentPage} of {page.lastPage}
              </span>
              {page.url.next ? (
                <a href={page.url.next} class="text-navy underline underline-offset-4 hover:no-underline">
                  Older posts →
                </a>
              ) : (
                <span />
              )}
            </nav>
          )
        }
      </div>
    </BigOutlineHeading>
  </section>

  <LogoStrip class="mt-[clamp(3rem,6vw,6rem)]" />
</BaseLayout>
