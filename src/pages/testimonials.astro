---
// Testimonials — Figma 534:1361 (prototype 535:5862).
// Big title (static — no header/title animation on this page), testimonial rows in the connected-box layout
// shared with Our Featured Work, then FAQ → client logos → footer.
// Testimonials are managed in Keystatic (/keystatic → Testimonials); "Show on the Testimonials page" controls
// which appear here and "Order" sets the sequence.
import BaseLayout from '@/layouts/BaseLayout.astro';
import BigOutlineHeading from '@/components/BigOutlineHeading.astro';
import ConnectedStack from '@/components/ConnectedStack.astro';
import TestimonialRow from '@/components/TestimonialRow.astro';
import FaqAccordion from '@/components/FaqAccordion.astro';
import LogoStrip from '@/components/LogoStrip.astro';
import { getTestimonials, getFaqs, getProjects } from '@/lib/content';
import { ogImageFor } from '@/lib/og';
import { clients } from '@/data/site';

const testimonials = await getTestimonials({ page: true });
const faqs = await getFaqs('testimonials');
// Share image: the Westin Hotel project photo (two of the testimonials are about that project)
const westin = (await getProjects()).find((p) => p.id === 'westin-hotel');
const ogImage = westin ? await ogImageFor(westin.data.cover) : undefined;

const pageUrl = new URL('/testimonials', Astro.site).toString();
const orgId = `${new URL('/', Astro.site)}#organization`;

const breadcrumbs = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).toString() },
    { '@type': 'ListItem', position: 2, name: 'Client Testimonials', item: pageUrl },
  ],
};

// One Review per testimonial shown on this page (Keystatic → Testimonials), about the organisation
const reviews = testimonials.map((t) => ({
  '@type': 'Review',
  '@id': `${pageUrl}#review-${t.id}`,
  itemReviewed: { '@id': orgId },
  author: {
    '@type': 'Person',
    name: t.data.name,
    ...(t.data.role && { jobTitle: t.data.role }),
    worksFor: { '@type': 'Organization', name: t.data.company },
  },
  reviewRating: { '@type': 'Rating', ratingValue: String(t.data.rating), bestRating: '5', worstRating: '1' },
  reviewBody: t.data.quote,
}));

// The client logo strip at the bottom of the page
const clientList = {
  '@type': 'ItemList',
  '@id': `${pageUrl}#clients`,
  name: 'Clients we have worked with',
  numberOfItems: clients.length,
  itemListElement: clients.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: { '@type': 'Organization', name: c.name },
  })),
};
---

<BaseLayout
  title="Azure Contracting | Our Client Testimonials & Reviews"
  description="Read what clients say about Azure Contracting, from hotel groups and architects to office managers, across fit-out and refurbishment projects in Ireland."
  ogImage={ogImage}
  schema={[breadcrumbs, ...reviews, clientList]}
>
  <section class="pt-[clamp(1.5rem,1rem+2vw,3rem)]">
    <BigOutlineHeading text="Client Testimonials" as="h1">
      <div class="container-site">
        <ConnectedStack>
          {testimonials.map((t, i) => <TestimonialRow testimonial={t} reverse={i % 2 === 1} eager={i === 0} />)}
        </ConnectedStack>
      </div>
    </BigOutlineHeading>
  </section>

  <FaqAccordion items={faqs} class="mt-[clamp(3rem,6vw,6rem)]" />

  <LogoStrip />
</BaseLayout>
