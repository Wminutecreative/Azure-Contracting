---
// About Us — Figma 534:1311 (prototype 535:5812).
// "Discover About Us" (static title) · hero: statement + Contact Us + photo, three fact cards that appear one by
// one · photo + Purpose / Mission / Vision cards (hover: olive gradient + text reveal) · Precise / Engineered /
// Versatile value cards · full-width building photo · "Our Team Members" (Keystatic → Team, hover cards) ·
// FAQ → client logos → footer.
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import BigOutlineHeading from '@/components/BigOutlineHeading.astro';
import Button from '@/components/Button.astro';
import ValueCards from '@/components/ValueCards.astro';
import TeamCard from '@/components/TeamCard.astro';
import FaqAccordion from '@/components/FaqAccordion.astro';
import LogoStrip from '@/components/LogoStrip.astro';
import { getTeam, getFaqs } from '@/lib/content';
import { ogImageFor } from '@/lib/og';
// TODO: real photos from Figma / the client
import about_hero_section from '@/assets/about/about-hero-section.png';
import about_purpose_mission_vision_section from '@/assets/about/about-purpose-mission-vision-section.png';
import about_building from '@/assets/about/about-building.png';
// TODO: export the four "Our Process" card photos from Figma (Component 25) — service photos stand in for now
import process_tendering from '@/assets/process/tendering-process.png';
import process_management from '@/assets/process/project-management.png';
import process_construction from '@/assets/process/fitout-construction.png';
import process_handover from '@/assets/process/handover-aftercare.png';

const team = await getTeam();
const faqs = await getFaqs('about');
const ogImage = await ogImageFor(about_building);

const facts = [
  'Founded in 2012 by two chartered surveyors from Irish contractors.',
  'Main contractor and PSCS on every project we deliver.',
  'Experienced in hotels, offices & live public buildings.',
];

const pillars = [
  {
    title: 'Purpose',
    text: 'We are main contractors for fit-out, refurbishment and construction across Ireland, spanning offices, hotels, healthcare, education and public buildings.',
  },
  // TODO: client copy — Mission and Vision text are not in the design yet; these are drafts to replace.
  {
    title: 'Mission',
    text: 'To deliver every project safely, on programme and to a finish our clients are proud of — with one accountable team from first site visit to handover.',
  },
  {
    title: 'Vision',
    text: 'To be the contractor Irish clients call first for fit-out work in buildings that have to stay open while we work.',
  },
];

// "Our Process" cards (design: Component 25). TODO: client to confirm the bullet wording (small in the design export)
const steps = [
  {
    title: 'Tendering Process',
    items: ['Documentation analysis', 'Tendering process', 'Value engineering'],
    image: process_tendering,
    alt: 'Hand annotating drawings in a project notebook',
  },
  {
    title: 'Project Management',
    items: ['PSCS', 'Coordination', 'Procurement'],
    image: process_management,
    alt: 'Site team in hi-vis reviewing a fit-out',
  },
  {
    title: 'Fitout Construction',
    items: ['Preparation', 'Build', 'Updates'],
    image: process_construction,
    alt: 'Engineers inspecting ceiling services on site',
  },
  {
    title: 'Handover & Aftercare',
    items: ['Quality', 'Sign-off', 'Support'],
    image: process_handover,
    alt: 'Finished office interior with a plant and wall-mounted screen',
  },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'AboutPage',
    name: 'About Azure Contracting',
    url: new URL('/about', Astro.site).toString(),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).toString() },
      { '@type': 'ListItem', position: 2, name: 'About Us', item: new URL('/about', Astro.site).toString() },
    ],
  },
];
---

<BaseLayout
  title="Azure Contracting | Trusted Main Contractor Ireland"
  description="Azure Contracting has delivered fit-out, refurbishment and construction across Ireland since 2012, acting as main contractor and PSCS on every project."
  ogImage={ogImage}
  schema={schema}
>
  <!-- 1. Hero -->
  <section class="pt-[clamp(1.5rem,1rem+2vw,3rem)]">
    <BigOutlineHeading text="Discover About Us" as="h1">
      <div class="container-site">
        <div class="grid items-stretch gap-8 md:grid-cols-[1.05fr_1fr] md:gap-12">
          <div class="flex flex-col justify-between gap-8 py-2">
            <h2 class="font-display text-[clamp(1.75rem,1.2rem+2.2vw,3rem)] leading-[1.25] font-medium text-[#303030] uppercase">
              Based in <span class="text-navy">Kildare</span> and working on projects
              <span class="text-navy">across Ireland</span>
            </h2>
            <div>
              <Button href="/contact" track="cta_click" data-cta-location="about-hero">Contact Us</Button>
            </div>
          </div>
          <Image
            src={about_hero_section}
            alt="Bright office canteen fit-out with suspended ceiling lighting"
            widths={[640, 960, 1280]}
            sizes="(min-width: 768px) 48vw, 100vw"
            loading="eager"
            fetchpriority="high"
            class="aspect-[16/11] w-full rounded-[1.25rem] object-cover"
            width={812}
            height={1000}
          />
        </div>

        <!-- Fact cards: rise in one after another as you scroll -->
        <ol class="mt-8 grid gap-3.5 md:mt-12 md:grid-cols-3 md:gap-5" data-facts data-no-text-anim>
          {
            facts.map((fact, i) => (
              <li class="fact-card flex items-center gap-5 rounded-[1.125rem] bg-white px-6 py-5">
                <span class=" font-heading text-neon text-[clamp(2.75rem,2rem+2vw,4rem)] leading-none font-medium" aria-hidden="true">
                  {i + 1}
                </span>
                <p class="text-text-medium text-p1 leading-[1.4] font-medium">{fact}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </BigOutlineHeading>
  </section>

  <!-- 2. Photo + Purpose / Mission / Vision -->
  <section class="pt-[clamp(4rem,2rem+6vw,8rem)]" aria-label="Purpose, mission and vision">
    <div class="container-site grid gap-4 md:grid-cols-[1.1fr_0.9fr] md:gap-5">
      <Image
        src={about_purpose_mission_vision_section}
        alt="Two people reviewing drawings and material samples pinned to a wall"
        widths={[640, 960, 1280, 1600]}
        sizes="(min-width: 768px) 55vw, 100vw"
        loading="lazy"
        class="aspect-[4/3] h-full w-full rounded-[1.25rem] object-cover"
        width={1600}
        height={1000}
      />
      <ul class="grid gap-4 md:gap-5">
        {
          pillars.map((p) => (
            <li class="pillar-card relative isolate flex flex-col justify-center overflow-hidden rounded-[1.25rem] border border-[#E7E7E7] bg-white px-7 py-8 md:px-12" tabindex="0">
              <h3 class="pillar-title font-body text-[clamp(1.5rem,1.3rem+0.6vw,1.75rem)] font-normal">{p.title}</h3>
              <div class="pillar-desc">
                <p class="text-p1 leading-[1.45] text-[#414141]">{p.text}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 3. Values -->
  <section class="pt-[clamp(4rem,2rem+6vw,8rem)]" aria-labelledby="values-heading">
    <div class="container-site">
      <h2 id="values-heading" class="sr-only">How we work</h2>
      <ValueCards />
    </div>
  </section>

  <!-- 4. Our Process (design: Component 9 → 25; motion modelled on stanzza.design/awards). With scroll animation the
       stage pins: the building photo grows to full screen and "OUR PROCESS" rises in → the four process cards grow
       in from the middle of the screen into a row → the row slides sideways, each card building as it arrives
       (number, title letter by letter, photo wiping open, bullets). Without it (phones, reduced motion, no JS):
       the photo with the title, and the cards in a grid below. -->
  <section class="process pt-[clamp(4rem,2rem+6vw,8rem)]" data-process data-no-text-anim aria-labelledby="process-heading">
    <div class="process-stage" data-process-stage>
      <div class="process-frame container-site" data-process-frame>
        <div class="process-media" data-process-media>
          <Image
            src={about_building}
            alt="Modern building interior with a double-height concrete and glass atrium"
            widths={[960, 1440, 1920, 2560]}
            sizes="100vw"
            loading="lazy"
            class="process-photo"
            width={1959}
          />
          <h2 id="process-heading" class="process-title text-h-caps" data-process-title>Our Process</h2>
        </div>
      </div>

      <ol class="process-track container-site" data-process-track>
        {
          steps.map((step, i) => (
            <li class="process-card">
              <div>
              {/* <span class="process-num" aria-hidden="true" data-pc-num>
                {i + 1}
              </span> */}
              <h3 class="process-card-title" data-pc-title>
                {step.title}
              </h3>
              <p class="process-list" data-pc-list>
                {step.items.map((item, i) => (
                  <>
                    <span>{i < step.items.length - 1 ? `${item},` : item}</span>{' '}
                  </>
                ))}
              </p>

              </div>
                            
              <div class="process-img" data-pc-img>
                <Image src={step.image} alt={step.alt} widths={[400, 640, 960]} sizes="(min-width: 768px) 28rem, 90vw" loading="lazy" />
              </div>
              {/* One comma-separated line; each item is a span so the reveal can bring them in one after another */}
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- 5. Team -->
  {
    team.length > 0 && (
      <section class="pt-[clamp(4rem,2rem+6vw,8rem)]">
        <BigOutlineHeading text="Our Team Members">
          {/* Full-bleed ticker: the cards drift left in an endless loop and pause while one is hovered / focused /
              flipped. The set is drawn twice so the loop is seamless; the copy is inert (hidden from keyboard and
              screen readers). Reduced motion: a plain row that scrolls sideways. */}
          <div class="team-track" role="region" aria-label="Team members">
            <div class="team-ticker" style={`--team-count: ${team.length}`}>
              <div class="team-set">
                {team.map((member) => <TeamCard member={member} />)}
              </div>
              <div class="team-set" aria-hidden="true" inert>
                {team.map((member) => <TeamCard member={member} />)}
              </div>
            </div>
          </div>
        </BigOutlineHeading>
      </section>
    )
  }

  <!-- 6. FAQ → logos (footer from BaseLayout) -->
  <FaqAccordion items={faqs} />
  <LogoStrip />
</BaseLayout>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { SplitText } from 'gsap/SplitText';

  gsap.registerPlugin(ScrollTrigger, SplitText);

  // Fact cards (desktop / tablet) — plays EVERY time the row is scrolled to, not just once:
  //   card 1 rises in when the row scrolls into view. When the row reaches its hold point (bottom of the row at
  //   88% of the screen) the page FREEZES there (overflow hidden — the only way to also stop a trackpad gesture
  //   already in flight) until all three cards are shown: any downward scroll (wheel, trackpad, touch swipe,
  //   ↓ / PgDn / Space) reveals the next card, at least 0.3s apart, then the page unfreezes and scrolls on.
  //   Scrolling up unfreezes straight away. Once you scroll back up well above the cards (35% of a screen above
  //   the hold point, or to the very top of the page) they reset — cards 2 and 3 hide again (card 1 too if the row has left the screen) — so the
  //   sequence plays again on the way back down. While frozen the page is padded by the scrollbar's width, so
  //   nothing shifts sideways.
  // Phones (stacked): each card rises in as it comes into view and hides again when scrolled back above it.
  // Reduced motion: shown as is (CSS only hides them under .motion).
  {
    const facts = document.querySelector<HTMLElement>('[data-facts]');
    const cards = facts ? gsap.utils.toArray<HTMLElement>('.fact-card', facts) : [];
    if (facts && cards.length) {
      const from = { autoAlpha: 0, y: 64 };
      const to = { autoAlpha: 1, y: 0, duration: 0.6, ease: 'power3.out' };
      const mm = gsap.matchMedia();
      mm.add('(min-width: 48rem) and (prefers-reduced-motion: no-preference)', () => {
        const html = document.documentElement;
        gsap.set(cards, from);
        let shown = 0;
        let locked = false;
        let lastReveal = 0;
        let touchY = 0;
        let unlockTimer = 0;

        // Scroll position at which the row's bottom sits at 88% of the screen
        const holdY = () => {
          const r = facts.getBoundingClientRect();
          return Math.max(0, Math.round(r.bottom + window.scrollY - window.innerHeight * 0.88));
        };
        const rowInView = () => facts.getBoundingClientRect().top < window.innerHeight * 0.92;

        let lockY = 0;
        const lock = () => {
          if (locked) return;
          locked = true;
          lockY = holdY();
          // Stop scrolling first (this also cancels the browser's own smooth-scroll animation of a fast flick),
          // then put the page back exactly at the hold point. The scrollbar disappears: pad the page by its width
          // so nothing shifts sideways.
          const bar = window.innerWidth - html.clientWidth;
          html.style.overflow = 'hidden';
          if (bar > 0) html.style.paddingRight = `${bar}px`;
          window.scrollTo({ top: lockY, behavior: 'instant' });
        };
        const unlock = () => {
          clearTimeout(unlockTimer);
          if (!locked) return;
          locked = false;
          html.style.overflow = '';
          html.style.paddingRight = '';
        };

        const reveal = () => {
          if (shown >= cards.length) return;
          gsap.to(cards[shown], { ...to, overwrite: true });
          shown += 1;
          lastReveal = performance.now();
          // All three out: give card 3 a moment on screen, then let the page move again
          if (shown >= cards.length) unlockTimer = window.setTimeout(unlock, 250);
        };
        // Reset for next time: hide cards 2 and 3 (and card 1 too if the row is off-screen)
        const rearm = () => {
          const keep = rowInView() ? 1 : 0;
          cards.slice(keep).forEach((card) => gsap.to(card, { ...from, duration: 0.4, ease: 'power2.in', overwrite: true }));
          shown = keep;
        };
        // Any downward scroll while held reveals the next card (at least 0.16s apart)
        const step = () => {
          if (performance.now() - lastReveal > 160) reveal();
        };

        const onScroll = () => {
          if (locked) {
            // A leftover scroll animation moved the page anyway — put it back (unless all cards are already out)
            if (shown < cards.length && Math.abs(window.scrollY - lockY) > 1) {
              window.scrollTo({ top: lockY, behavior: 'instant' });
            }
            return;
          }
          const y = window.scrollY;
          const hy = holdY();
          // Scrolled back up well above the cards (or all the way to the top — the hold point can be close to the
          // top of the page) after they all played → reset so they play again
          if (shown >= cards.length && (y <= 1 || y < hy - window.innerHeight * 0.35)) rearm();
          // Card 1: when the row scrolls into view
          if (shown === 0 && rowInView()) reveal();
          // Reached the hold point with cards still to come → freeze (a fast scroll may arrive here before card 1)
          if (shown < cards.length && y >= hy - 1) {
            if (shown === 0) reveal();
            lock();
          }
        };
        const onWheel = (e: WheelEvent) => {
          if (e.deltaY < 0) return unlock(); // going up is always allowed
          if (e.deltaY === 0 || !locked) return;
          e.preventDefault();
          step();
        };
        const onTouchStart = (e: TouchEvent) => {
          touchY = e.touches[0].clientY;
        };
        const onTouchMove = (e: TouchEvent) => {
          if (!locked) return;
          const dy = touchY - e.touches[0].clientY; // > 0: swiping up = scrolling down
          if (dy < -30) return unlock();
          e.preventDefault();
          if (dy > 30) {
            touchY = e.touches[0].clientY;
            step();
          }
        };
        const onKey = (e: KeyboardEvent) => {
          if (!locked) return;
          const t = e.target as HTMLElement | null;
          if (t?.closest('input, textarea, select, [contenteditable]')) return;
          if (['ArrowUp', 'PageUp', 'Home'].includes(e.key)) return unlock();
          if (!['ArrowDown', 'PageDown', ' ', 'Spacebar'].includes(e.key)) return;
          e.preventDefault();
          step();
        };

        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('wheel', onWheel, { passive: false });
        window.addEventListener('touchstart', onTouchStart, { passive: true });
        window.addEventListener('touchmove', onTouchMove, { passive: false });
        window.addEventListener('keydown', onKey);
        // The row may already be on screen when the page opens
        requestAnimationFrame(onScroll);

        return () => {
          window.removeEventListener('scroll', onScroll);
          window.removeEventListener('wheel', onWheel);
          window.removeEventListener('touchstart', onTouchStart);
          window.removeEventListener('touchmove', onTouchMove);
          window.removeEventListener('keydown', onKey);
          unlock();
        };
      });
      mm.add('(max-width: 47.99rem) and (prefers-reduced-motion: no-preference)', () => {
        cards.forEach((card) =>
          gsap.fromTo(card, from, {
            ...to,
            scrollTrigger: { trigger: card, start: 'top 92%', toggleActions: 'play none none reverse' },
          }),
        );
      });
    }
  }

  // Our Process — one pinned, scroll-scrubbed timeline (timeline units), as on stanzza.design:
  //   0 → 1  photo grows from its rounded card to full screen; "OUR PROCESS" rises in
  //   1 → 2  the first card rises in from the bottom-right corner (full size, drifting slightly left)
  //   2 → 5  the row slides left, bringing the cards in from the right one after another, until the last card
  //          meets the right edge; the title fades as the cards pass over it
  //   Each card builds as it comes into view: number → title letters → photo wipes open → bullets.
  // Rebuilt on resize (positions depend on the screen size).
  {
    const section = document.querySelector<HTMLElement>('[data-process]');
    const stage = section?.querySelector<HTMLElement>('[data-process-stage]');
    const frame = section?.querySelector<HTMLElement>('[data-process-frame]');
    const media = section?.querySelector<HTMLElement>('[data-process-media]');
    const title = section?.querySelector<HTMLElement>('[data-process-title]');
    const track = section?.querySelector<HTMLElement>('[data-process-track]');

    if (section && stage && frame && media && title && track) {
      const cards = gsap.utils.toArray<HTMLElement>('.process-card', track);
      const gutter = () => parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--gutter')) || 16;
      const mm = gsap.matchMedia();

      mm.add('(min-width: 48rem) and (prefers-reduced-motion: no-preference)', () => {
        section.classList.add('is-scrub');
        let ctx: gsap.Context | undefined;

        const build = () => {
          ctx?.revert();
          ctx = gsap.context(() => {
            const vw = stage.clientWidth;
            const vh = stage.clientHeight;
            const g = gutter();
            const startW = Math.min(vw - 2 * g, 1312);
            const trackW = track.scrollWidth;
            const cardW = cards[0]?.offsetWidth ?? 0;
            const x1 = vw - g - cardW; // card 1 settles against the right gutter; the gap keeps card 2 off-screen
            const xIn = x1 + vw * 0.06; // it rises from just right of there, drifting slightly left
            const x2 = Math.min(x1, vw - g - trackW); // end: last card at the right gutter
            const travel = x1 - x2;
            const slide = travel > 0 ? 3 : 0;
            const slideAt = 2.35; // the row only starts moving once card 1 is fully in and built

            gsap.set(frame, { padding: 0, maxWidth: 'none' });
            const tl = gsap.timeline({
              defaults: { ease: 'none' },
              scrollTrigger: {
                trigger: stage,
                start: 'top top',
                end: `+=${Math.round(vh * 2.4 + travel * 1.3)}`,
                pin: true,
                scrub: 0.8,
              },
            });

            // 0 → 1: photo to full screen, title in
            tl.fromTo(frame, { width: startW, height: (startW * 7) / 16 }, { width: vw, height: vh, duration: 1 }, 0)
              .fromTo(media, { borderRadius: 20 }, { borderRadius: 0, duration: 1 }, 0)
              .fromTo(title, { autoAlpha: 0, y: 40 }, { autoAlpha: 1, y: 0, duration: 0.5, ease: 'power2.out' }, 0.45);

            // 1 → 2: card 1 rises in from below the bottom-right corner
            tl.fromTo(track, { x: xIn, y: vh }, { x: x1, y: 0, duration: 1, ease: 'power2.out' }, 1);

            // 2.35 → 5.35: the row slides left, bringing the next cards in from the right one after another;
            // the title fades as the cards pass over the middle
            if (slide) tl.to(track, { x: x2, duration: slide }, slideAt);
            tl.to(title, { autoAlpha: 0, y: -20, duration: 0.8, ease: 'power1.in' }, slide ? slideAt + 0.2 : 1.6);

            // Each card builds as it comes into view: card 1 while it rises, the rest once three quarters of
            // the card is on screen during the slide
            cards.forEach((card) => {
              const left = card.offsetLeft;
              let at = 1.3;
              const enter = vw - cardW * 0.75;
              if (slide && left + x1 > enter) at = slideAt + (slide * (left + x1 - enter)) / travel;

              const num = card.querySelector('[data-pc-num]');
              const head = card.querySelector('[data-pc-title]');
              const img = card.querySelector('[data-pc-img]');
              const items = card.querySelectorAll('[data-pc-list] span');
              const chars = head ? new SplitText(head, { type: 'chars' }).chars : [];

              tl.fromTo(num, { autoAlpha: 0, yPercent: 40 }, { autoAlpha: 1, yPercent: 0, duration: 0.35, ease: 'power2.out' }, at)
                .fromTo(chars, { autoAlpha: 0, xPercent: -60 }, { autoAlpha: 1, xPercent: 0, duration: 0.25, stagger: { amount: 0.3 }, ease: 'power2.out' }, at)
                .fromTo(img, { clipPath: 'inset(0% 100% 0% 0%)' }, { clipPath: 'inset(0% 0% 0% 0%)', duration: 0.5, ease: 'power2.inOut' }, at + 0.05)
                .fromTo(items, { autoAlpha: 0, x: -14 }, { autoAlpha: 1, x: 0, duration: 0.3, stagger: 0.08, ease: 'power2.out' }, at + 0.2);
            });

            tl.to({}, { duration: 0.3 }); // short hold on the last card before the page scrolls on
          }, section);

          // Pins further down the page (the FAQ) must be measured after this one
          ScrollTrigger.sort();
          ScrollTrigger.refresh();
        };

        build();
        // Rebuild when the width changes (not on phone address-bar height jitter)
        let lastW = window.innerWidth;
        let timer = 0;
        const onResize = () => {
          if (window.innerWidth === lastW) return;
          lastW = window.innerWidth;
          clearTimeout(timer);
          timer = window.setTimeout(build, 200);
        };
        window.addEventListener('resize', onResize);

        return () => {
          window.removeEventListener('resize', onResize);
          clearTimeout(timer);
          ctx?.revert();
          section.classList.remove('is-scrub');
        };
      });
    }
  }

</script>

<style>
  /* Our Process — static layout (phones, reduced motion, no JS): rounded photo with the title on it, cards below */
  .process-media {
    position: relative;
    overflow: hidden;
    border-radius: 1.25rem;
  }
  .process-photo {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 7;
    object-fit: cover;
  }
  .process-media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgb(14 31 61 / 0.25);
    pointer-events: none;
  }
  .process-title {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: grid;
    place-items: center;
    color: var(--color-white);
    letter-spacing: 0.04em;
    pointer-events: none;
  }
  .process-track {
    display: grid;
    /* gap: 0.75rem; */
    margin-top: 0.75rem;
  }
  @media (min-width: 40rem) {
    .process-track {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .process-card {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    border-radius: 1.25rem;
    background: var(--color-white);
    padding: clamp(1.25rem, 2rem + 1vw, 5rem);
  }
  .process-num {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 1.6rem + 1.2vw, 4rem);
