---
// Temporary Phase 2 page: every global component in one place. Remove before launch.
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/Button.astro';
import BigOutlineHeading from '@/components/BigOutlineHeading.astro';
import LogoStrip from '@/components/LogoStrip.astro';
import FaqAccordion from '@/components/FaqAccordion.astro';

// Demo data only — real FAQs come from the `faqs` collection in Phase 3. TODO: client copy.
const demoFaqs = [
  {
    question: 'What types of projects do you work on?',
    answer: 'TODO: client copy — construction, refurbishment and fit-out for offices, hospitality, retail and education.',
  },
  { question: 'Which areas do you cover?', answer: 'TODO: client copy — based in Kildare, working across Ireland.' },
  { question: 'How long does a typical fit-out take?', answer: 'TODO: client copy.' },
  { question: 'Can you work while our business stays open?', answer: 'TODO: client copy.' },
];
---

<BaseLayout title="Components" description="Azure Contracting component library." noindex>
  <div class="container-site section-y space-y-24">
    <header>
      <p class="text-p3 text-text-medium mb-2 tracking-widest uppercase">Phase 2 · temporary page</p>
      <h1 class="text-h1">Components</h1>
      <p class="text-p1 text-text-medium mt-4 max-w-2xl">
        The header and footer are live on this page. Open the menu with the hamburger (top left) and try Esc and Tab.
      </p>
    </header>

    <section class="space-y-8">
      <h2 class="text-h4">Button</h2>
      <div class="flex flex-wrap items-center gap-6">
        <Button href="/contact">Contact Us</Button>
        <Button variant="outline" href="#">Know More</Button>
        <Button type="submit">Submit (button element)</Button>
      </div>
      <div class="rounded-card bg-navy flex flex-wrap items-center gap-6 p-8">
        <Button variant="neon" href="#">Neon on navy</Button>
        <Button compact href="#">Compact (label hides &lt; 640px)</Button>
      </div>
    </section>

    <section class="space-y-8">
      <h2 class="text-h4">BigOutlineHeading</h2>
      <BigOutlineHeading text="Our Featured Work">
        <div class="rounded-card shadow-card mx-auto max-w-3xl bg-white p-8 text-center">
          <p class="text-p1 text-text-medium">Content slotted in overlaps the lower part of the outline heading.</p>
        </div>
      </BigOutlineHeading>
      <BigOutlineHeading text="Discover About Us" align="left" />
    </section>
  </div>

  <FaqAccordion items={demoFaqs} />
  <LogoStrip />
</BaseLayout>
