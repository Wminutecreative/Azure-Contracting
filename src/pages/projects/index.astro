---
// Projects listing — Figma 534:2019 (prototype 535:6519).
// "Our Featured Work" title + every project in the connected-box layout (same component as the homepage
// section, static here — no title/row animation), then client logos → footer.
// Projects are managed in Keystatic (/keystatic → Projects); "Order" sets the sequence.
import BaseLayout from '@/layouts/BaseLayout.astro';
import FeaturedWork from '@/components/FeaturedWork.astro';
import LogoStrip from '@/components/LogoStrip.astro';
import { getProjects } from '@/lib/content';

const projects = await getProjects();

const breadcrumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).toString() },
    { '@type': 'ListItem', position: 2, name: 'Projects', item: new URL('/projects', Astro.site).toString() },
  ],
};
---

<BaseLayout
  title="Our Projects"
  description="Hotel, office, retail, clinic and education fit-outs and refurbishments delivered by Azure Contracting across Ireland — including the Morrison Hotel, the Osprey Hotel Spa and The Hari Clinic."
  schema={[breadcrumbs]}
>
  <FeaturedWork projects={projects} headingAs="h1" animated={false} class="pt-[clamp(1.5rem,1rem+2vw,3rem)]" />

  <LogoStrip class="mt-[clamp(3rem,6vw,6rem)]" />
</BaseLayout>
