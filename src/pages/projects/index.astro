---
// Projects listing — Figma 534:2019 (prototype 535:6519).
// "Our Featured Work" title + every project in the connected-box layout (same component as the homepage
// section, static here — no title/row animation), then client logos → footer.
// Projects are managed in Keystatic (/keystatic → Projects); "Order" sets the sequence.
import BaseLayout from '@/layouts/BaseLayout.astro';
import FeaturedWork from '@/components/FeaturedWork.astro';
import LogoStrip from '@/components/LogoStrip.astro';
import { getProjects } from '@/lib/content';
import { ogImageFor } from '@/lib/og';

const projects = await getProjects();
const ogImage = projects[0] ? await ogImageFor(projects[0].data.cover) : undefined;

const breadcrumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).toString() },
    { '@type': 'ListItem', position: 2, name: 'Projects', item: new URL('/projects', Astro.site).toString() },
  ],
};
---

<BaseLayout
  title="Azure Contracting | Fit-Out & Refurbishment Projects"
  description="Browse Azure Contracting’s portfolio of hotel, office, clinic and education fit-outs and refurbishments delivered across Ireland since 2012."
  ogImage={ogImage}
  schema={[breadcrumbs]}
>
  <FeaturedWork projects={projects} headingAs="h1" animated={false} class="pt-[clamp(1.5rem,1rem+2vw,3rem)]" />

  <LogoStrip class="mt-[clamp(3rem,6vw,6rem)]" />
</BaseLayout>
