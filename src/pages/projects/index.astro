---
// Projects listing — Figma 534:2019 (prototype 535:6519).
// "Our Featured Work" title + every project in the connected-box layout (same component as the homepage
// section, static here — no title/row animation), then client logos → footer.
// Projects are managed in Keystatic (/keystatic → Projects); "Order" sets the sequence.
import BaseLayout from '@/layouts/BaseLayout.astro';
import FeaturedWork from '@/components/FeaturedWork.astro';
import LogoStrip from '@/components/LogoStrip.astro';
import { getProjects } from '@/lib/content';
import { ogImageFor } from '@/lib/og';

const projects = await getProjects();
const ogImage = projects[0] ? await ogImageFor(projects[0].data.cover) : undefined;

// ---- JSON-LD (SEO brief): CollectionPage listing every project ----
const site = new URL('/', Astro.site).toString();
const projectsUrl = new URL('/projects', Astro.site).toString();
const schema = [
  { '@type': 'CollectionPage', mainEntity: { '@id': `${projectsUrl}#projects-list` } },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: site },
      { '@type': 'ListItem', position: 2, name: 'Our Projects', item: projectsUrl },
    ],
  },
  {
    '@type': 'ItemList',
    '@id': `${projectsUrl}#projects-list`,
    name: 'Our Featured Work',
    numberOfItems: projects.length,
    itemListElement: projects.map((p, i) => {
      const url = new URL(`/projects/${p.id}`, Astro.site).toString();
      return {
        '@type': 'ListItem',
        position: i + 1,
        item: {
          '@type': 'CreativeWork',
          '@id': url,
          name: p.data.title,
          description: p.data.excerpt,
          url,
          creator: { '@id': `${site}#organization` },
        },
      };
    }),
  },
];
---

<BaseLayout
  title="Azure Contracting | Fit-Out & Refurbishment Projects"
  description="Browse Azure Contracting’s portfolio of hotel, office, clinic and education fit-outs and refurbishments delivered across Ireland since 2012."
  ogImage={ogImage}
  schema={schema}
  orgDescription="Azure Contracting has delivered over 500 fit-out and refurbishment projects across offices, hospitality, healthcare and public buildings in Ireland since 2012."
>
  <FeaturedWork projects={projects} headingAs="h1" animated={false} class="pt-[clamp(1.5rem,1rem+2vw,3rem)]" />

  <LogoStrip class="mt-[clamp(3rem,6vw,6rem)]" />
</BaseLayout>
