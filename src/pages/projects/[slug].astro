---
// Project detail — Figma 534:1796 (prototype 535:6296).
// Title · two columns: photos (cover + gallery, stacked) | sticky "Introduction" panel (description + Client /
// Location / Role) · "Other Similar Works" in the connected-box layout · client logos → footer.
// All content comes from the Projects collection in Keystatic.
import { Image, getImage } from 'astro:assets';
import { render, type CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import FeaturedWork from '@/components/FeaturedWork.astro';
import LogoStrip from '@/components/LogoStrip.astro';
import Lightbox from '@/components/Lightbox.astro';
import { getProjects } from '@/lib/content';
import { sectorLabel } from '@/data/sectors';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({ params: { slug: project.id }, props: { project, all: projects } }));
}

interface Props {
  project: CollectionEntry<'projects'>;
  all: CollectionEntry<'projects'>[];
}
const { project, all } = Astro.props;
const { title, excerpt, cover, coverAlt, gallery, client, location, role, year, sector, metaTitle, metaDescription } = project.data;
// Search / sharing: the SEO fields from Keystatic, else the title and a trimmed summary
const seoTitle = metaTitle ?? title;
const seoDescription = metaDescription ?? (excerpt.length > 158 ? `${excerpt.slice(0, 155).trimEnd()}…` : excerpt);
const { Content } = await render(project);

// Left column: the gallery photos (design shows interiors here); falls back to the cover when there is no gallery
const photos = gallery.length ? gallery : [{ src: cover, alt: coverAlt }];
const meta = [
  { label: 'Client', value: client },
  { label: 'Location', value: location },
  { label: 'Role', value: role },
  { label: 'Completed', value: year?.toString() },
].filter((m): m is { label: string; value: string } => Boolean(m.value));

// Large versions for the full-screen viewer (click any photo)
const fullSize = await Promise.all(
  photos.map((p) => getImage({ src: p.src, width: Math.min(p.src.width, 2400), format: 'webp' })),
);
const thumbs = await Promise.all(
  photos.map((p) => getImage({ src: p.src, width: 200, height: 200, fit: 'cover', format: 'webp' })),
);
const lightboxItems = photos.map((p, i) => ({ src: fullSize[i].src, thumb: thumbs[i].src, alt: p.alt }));

// Other Similar Works: same sector first, then the rest — 2 projects, never the current one
const others = all.filter((p) => p.id !== project.id);
const similar = [...others.filter((p) => p.data.sector === sector), ...others.filter((p) => p.data.sector !== sector)].slice(0, 2);

const og = await getImage({ src: cover, width: 1200, height: 630, fit: 'cover', format: 'jpg' });
const pageUrl = new URL(`/projects/${project.id}`, Astro.site).toString();
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'CreativeWork',
    name: title,
    description: excerpt,
    image: new URL(og.src, Astro.site).toString(),
    url: pageUrl,
    genre: `${sectorLabel(sector)} fit-out`,
    ...(location && { locationCreated: { '@type': 'Place', name: location } }),
    creator: { '@type': 'GeneralContractor', name: 'Azure Contracting' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).toString() },
      { '@type': 'ListItem', position: 2, name: 'Projects', item: new URL('/projects', Astro.site).toString() },
      { '@type': 'ListItem', position: 3, name: title, item: pageUrl },
    ],
  },
];
---

<BaseLayout title={seoTitle} description={seoDescription} ogImage={og.src} ogType="article" schema={schema}>
  <article class="container-site pt-[clamp(1.5rem,1rem+2vw,3rem)]">
    <h1 class="text-navy font-body text-[clamp(2rem,1.4rem+2vw,2.75rem)] leading-tight font-normal tracking-[-0.01em]">{title}</h1>

    <div class="mt-8 grid gap-8 md:mt-10 md:grid-cols-[1.5fr_1fr] md:gap-[clamp(2rem,4vw,3.5rem)]">
      <!-- Photos: each reveals as it scrolls into view; click opens the full-screen viewer -->
      <div class="flex flex-col gap-4 md:gap-5">
        {
          photos.map((photo, i) => (
            <button
              type="button"
              class="photo-btn"
              data-lb-open={i}
              data-photo-reveal
              aria-label={`View photo ${i + 1} of ${photos.length}: ${photo.alt}`}
            >
              <Image
                src={photo.src}
                alt={photo.alt}
                widths={[640, 960, 1280, 1600, 2000]}
                sizes="(min-width: 1340px) 780px, (min-width: 768px) 58vw, 100vw"
                loading={i === 0 ? 'eager' : 'lazy'}
                fetchpriority={i === 0 ? 'high' : undefined}
                class="aspect-[5/3] w-full object-cover"
              />
            </button>
          ))
        }
      </div>

      <!-- Introduction: stays in view while the photos scroll past -->
      <aside class="md:sticky md:top-[calc(var(--hdr-h)+1.5rem)] md:self-start" aria-labelledby="intro-heading">
        <h2 id="intro-heading" class="text-navy font-body text-[clamp(1.375rem,1.2rem+0.6vw,1.75rem)] font-normal">Introduction</h2>
        <div class="project-body text-text-medium mt-5 text-p1 leading-[1.6]">
          <Content />
        </div>
        {
          meta.length > 0 && (
            <dl class="mt-8 text-[0.9375rem]">
              {meta.map((m) => (
                <div class="border-light flex text-p1 gap-2 border-b py-3.5 first:border-t">
                  <dt class="text-[#252525] font-medium">{m.label}:</dt>
                  <dd class="text-[#525252]">{m.value}</dd>
                </div>
              ))}
            </dl>
          )
        }
      </aside>
    </div>
  </article>

  {
    similar.length > 0 && (
      <FeaturedWork projects={similar} heading="Other Similar Works" animated={false} class="pt-[clamp(4rem,2rem+7vw,10rem)]" />
    )
  }

  <LogoStrip class="mt-[clamp(3rem,6vw,6rem)]" />

  <Lightbox items={lightboxItems} />
</BaseLayout>

<script>
  // Photos reveal one by one as they scroll into view: the frame wipes up from the bottom while the photo settles
  // from a slight zoom. Plays once per photo. Reduced motion: shown immediately.
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll<HTMLElement>('[data-photo-reveal]').forEach((el) => {
      const img = el.querySelector('img');
      const tl = gsap.timeline({ scrollTrigger: { trigger: el, start: 'top 88%', once: true } });
      tl.fromTo(
        el,
        { clipPath: 'inset(100% 0% 0% 0% round 20px)', opacity: 0.4 },
        { clipPath: 'inset(0% 0% 0% 0% round 20px)', opacity: 1, duration: 1.1, ease: 'expo.out', clearProps: 'clipPath,opacity' },
      );
      if (img) tl.fromTo(img, { scale: 1.15 }, { scale: 1, duration: 1.4, ease: 'expo.out', clearProps: 'transform' }, 0);
    });
  }
</script>

<style>
  /* Clickable photos: rounded, zoom cursor, slight zoom on hover */
  .photo-btn {
    display: block;
    width: 100%;
    overflow: hidden;
    border-radius: 1.25rem;
    cursor: zoom-in;
  }
  .photo-btn :global(img) {
    transition: transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .photo-btn:hover :global(img) {
    transform: scale(1.03);
  }
  .photo-btn:focus-visible {
    outline: 2px solid var(--color-neon);
    outline-offset: 3px;
  }

  .project-body :global(p + p) {
    margin-top: 1em;
  }
  .project-body :global(h2),
  .project-body :global(h3) {
    margin: 1.5em 0 0.5em;
    color: var(--color-navy);
    font-family: var(--font-body);
    font-size: 1.125rem;
    font-weight: 500;
  }
  .project-body :global(ul) {
    margin-top: 0.75em;
    padding-left: 1.2em;
    list-style: disc;
  }
  .project-body :global(a) {
    color: var(--color-navy);
    text-decoration: underline;
  }
</style>
