---
// Services — Figma 534:1449 (prototype 535:5950).
// Big title "Services We Offer" (static) · one card per service (name, bullet list with Read More, photo) ·
// client logos → footer. Services are managed in Keystatic (/keystatic → Services).
import BaseLayout from '@/layouts/BaseLayout.astro';
import BigOutlineHeading from '@/components/BigOutlineHeading.astro';
import ServiceCard from '@/components/ServiceCard.astro';
import LogoStrip from '@/components/LogoStrip.astro';
import { getServices } from '@/lib/content';

const services = await getServices();

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Services We Offer',
    itemListElement: services.map((s, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      item: {
        '@type': 'Service',
        name: s.data.category,
        description: s.data.items.join(', '),
        provider: { '@type': 'GeneralContractor', name: 'Azure Contracting' },
        areaServed: 'Ireland',
      },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).toString() },
      { '@type': 'ListItem', position: 2, name: 'Services', item: new URL('/services', Astro.site).toString() },
    ],
  },
];
---

<BaseLayout
  title="Services We Offer"
  description="Design, commercial management, fit-out and refurbishment, M&E, data cabling, audio visual, furniture and joinery — the full range of construction and fit-out services from Azure Contracting."
  schema={schema}
>
  <section class="pt-[clamp(1.5rem,1rem+2vw,3rem)]">
    <BigOutlineHeading text="Services We Offer" as="h1">
      <div class="container-site">
        <div class="mx-auto max-w-[70rem] space-y-3.5 md:space-y-4">
          {services.map((service, i) => <ServiceCard service={service} eager={i === 0} />)}
        </div>
      </div>
    </BigOutlineHeading>
  </section>

  <LogoStrip class="mt-[clamp(3rem,6vw,6rem)]" />
</BaseLayout>

<script>
  // Read More / Read Less: collapse long lists to their first items; open and close with a smooth height
  // animation while the extra items fade in / out. Reduced motion: instant toggle.
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const EASE = 'cubic-bezier(0.22, 1, 0.36, 1)';

  document.querySelectorAll<HTMLButtonElement>('[data-svc-toggle]').forEach((btn) => {
    const list = document.getElementById(btn.getAttribute('aria-controls') ?? '');
    if (!list) return;
    const visible = Number(list.dataset.visible) || 5;
    const extras = Array.from(list.children).slice(visible) as HTMLElement[];
    let running: Animation | null = null;

    list.classList.add('is-collapsed');
    btn.hidden = false;

    const setOpen = (open: boolean) => {
      btn.setAttribute('aria-expanded', String(open));
      btn.textContent = open ? 'Read Less…' : 'Read More…';
    };

    btn.addEventListener('click', () => {
      const opening = list.classList.contains('is-collapsed');
      setOpen(opening);

      if (reduceMotion.matches) {
        list.classList.toggle('is-collapsed', !opening);
        return;
      }

      // Start from the current on-screen height (also mid-animation, if the user clicks again)
      const from = list.getBoundingClientRect().height;
      running?.cancel();

      // Measure the target height in the final state
      list.classList.toggle('is-collapsed', !opening);
      const to = list.getBoundingClientRect().height;
      // While closing, keep the extra items visible until the list has shrunk
      if (!opening) list.classList.remove('is-collapsed');

      list.style.overflow = 'hidden';
      running = list.animate({ height: [`${from}px`, `${to}px`] }, { duration: 450, easing: EASE });
      extras.forEach((li, i) =>
        li.animate(
          opening
            ? { opacity: [0, 1], transform: ['translateY(6px)', 'none'] }
            : { opacity: [1, 0] },
          opening
            ? { duration: 350, delay: 60 + i * 25, easing: EASE, fill: 'backwards' }
            : { duration: 200, easing: 'ease-out', fill: 'forwards' },
        ),
      );

      running.onfinish = () => {
        list.style.overflow = '';
        if (!opening) list.classList.add('is-collapsed');
        extras.forEach((li) => li.getAnimations().forEach((a) => a.cancel()));
        running = null;
      };
    });
  });
</script>
