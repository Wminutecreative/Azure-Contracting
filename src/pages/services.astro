---
// Services — redesign (Services design, Oct 2026).
// Big title "Services We Offer" · a large fixed photo panel with the main service's name over it (the service ticked
// "Use as the main photo panel") · one white row per service. Client logos → footer.
// Services are managed in Keystatic (/keystatic → Services): name, order, points, photo, "main photo panel",
// "show in the list".
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import BigOutlineHeading from '@/components/BigOutlineHeading.astro';
import LogoStrip from '@/components/LogoStrip.astro';
import { getServices } from '@/lib/content';
import { ogImageFor } from '@/lib/og';
import ogSource from '@/assets/projects/iconic-offices/Hume_Atrium_Photo00001-scaled.jpg';
import panelPhoto from '@/assets/services/panel/services-panel.jpg';

const all = await getServices();
const hero = all.find((s) => s.data.hero) ?? all[0];
const rows = all.filter((s) => s.data.showInList && s.id !== hero.id);
const ogImage = await ogImageFor(ogSource);

const list = rows.map((s) => ({ id: s.id, name: s.data.category }));

const schema = [
  {
    '@type': 'ItemList',
    name: 'Services We Offer',
    itemListElement: [hero, ...rows].map((s, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      item: {
        '@type': 'Service',
        name: s.data.category,
        ...(s.data.items.length && { description: s.data.items.join(', ') }),
        provider: { '@id': `${new URL('/', Astro.site)}#organization` },
        areaServed: { '@type': 'Country', name: 'Ireland' },
      },
    })),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).toString() },
      { '@type': 'ListItem', position: 2, name: 'Services', item: new URL('/services', Astro.site).toString() },
    ],
  },
];
---

<BaseLayout
  title="Azure Contracting | Construction & Fit-Out Services"
  description="Azure Contracting offers the full range of fit-out services, from design and commercial management to mechanical, electrical, data cabling, AV and joinery."
  ogImage={ogImage}
  schema={schema}
>
  <section class="pt-[clamp(1.5rem,1rem+2vw,3rem)]" data-services>
    <BigOutlineHeading text="Services We Offer" as="h1">
      <div class="container-site">
        <!-- Photo panel: one fixed photo with the main service's name over it -->
        <div class="svc-panel" data-no-text-anim>
          <Image
            src={panelPhoto}
            alt="Gloved fitter lifting an aluminium profile from a foam-lined tool case"
            widths={[640, 960, 1280, 1600, 1920, 2560]}
            sizes="(min-width: 1360px) 1312px, 100vw"
            loading="eager"
            fetchpriority="high"
            class="svc-panel-photo"
          />
          <p class="svc-panel-title text-h-caps">{hero.data.category}</p>
        </div>

        <ul class="svc-list" data-no-text-anim>
          {
            list.map((s) => (
              <li class="svc-row">
                <div class="svc-head">
                  <h2 class="svc-name">{s.name}</h2>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </BigOutlineHeading>
  </section>

  <LogoStrip class="mt-[clamp(3rem,6vw,6rem)]" />
</BaseLayout>

<style>
  /* Photo panel: wide rounded banner, navy tint, service name centred in white capitals */
  .svc-panel {
    position: relative;
    overflow: hidden;
    border-radius: 1.25rem;
    aspect-ratio: 16 / 10;
    background: var(--color-navy);
    isolation: isolate;
  }
  @media (min-width: 48rem) {
    .svc-panel {
      aspect-ratio: 2.3 / 1;
    }
  }
  .svc-panel::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: rgb(14 31 61 / 0.32);
    pointer-events: none;
  }
  .svc-panel-photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .svc-panel-title {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: grid;
    place-items: center;
    padding: 1rem;
    color: var(--color-white);
    text-align: center;
    letter-spacing: 0.04em;
  }

  /* Service rows: white rounded rows, 8px apart */
  .svc-list {
    display: grid;
    gap: 0.5rem;
    margin-top: 0.75rem;
  }
  .svc-row {
    border-radius: 0.875rem;
    background: var(--color-white);
    transition: background-color 0.3s ease;
  }
  .svc-head {
    padding: clamp(1.5rem, 0.1rem + 0.5vw, 2rem);
    border-radius: inherit;
  }
  .svc-head:focus-visible {
    outline: 2px solid var(--color-navy);
    outline-offset: 2px;
  }
  .svc-name {
    font-family: var(--font-body);
    font-size: clamp(1.5rem, 0.1rem + 0.25vw, 2rem);
    font-weight: 500;
    line-height: 1.3;
    color: var(--color-text-dark);
  }
  /* Hover / focus: the row turns neon (as the homepage sector cards) */
  /* .svc-row:hover,
  .svc-row:focus-within {
    background: var(--color-neon);
  } */
  /* .svc-row:hover .svc-name,
  .svc-row:focus-within .svc-name {
    color: var(--color-navy);
  } */

  @media (prefers-reduced-motion: reduce) {
    .svc-row {
      transition: none;
    }
  }
</style>

